/* MsiGetFileVersion(path, verBuf, &verLen, langBuf, &langLen): "1.2.3.4" from VS_FIXEDFILEINFO and the first translation language in decimal */
static int msi_scan_u16(const u8 *b, u32 n, const char *key, u32 *pos) { u32 kl = (u32)e_strlen(key); for (u32 i = 0; i + 2 * kl + 2 <= n; i += 2) { u32 k = 0; while (k < kl && b[i + 2 * k] == (u8)key[k] && b[i + 2 * k + 1] == 0) k++; if (k == kl && b[i + 2 * kl] == 0 && b[i + 2 * kl + 1] == 0) { *pos = i + 2 * kl + 2; return 1; } } return 0; }
static void msi_out(Cpu *c, u64 buf, u64 plen, const char *s, int wide, u32 *rc) { if (!plen) return; u32 cap = rd32(c, plen); u32 need = (u32)e_strlen(s); if (buf && cap > need) { if (wide) put_w8(c, buf, s, cap); else { for (u32 i = 0; i <= need; i++) wr8(c, buf + i, (u8)s[i]); } wr32(c, plen, need); } else { wr32(c, plen, need + (buf ? 0 : 1)); if (buf) *rc = 234; } }   /* ERROR_MORE_DATA */
static void msi_file_version(Cpu *c, const char *path, int wide) { u8 *blk; u32 sz; if (!ver_load(c, path, &blk, &sz)) { RET(W->last_error == 2 ? 2 : 1006); return; }   /* ERROR_FILE_NOT_FOUND / ERROR_FILE_INVALID */
  u32 rc = 0; u32 p; char ver[64] = "", lang[16] = "";
  if (msi_scan_u16(blk, sz, "VS_VERSION_INFO", &p)) { p = (p + 3) & ~3u; if (p + 52 <= sz && vr32(blk, sz, p) == 0xFEEF04BD) { u32 ms = vr32(blk, sz, p + 8), ls = vr32(blk, sz, p + 12); e_snprintf(ver, sizeof ver, "%u.%u.%u.%u", ms >> 16, ms & 0xffff, ls >> 16, ls & 0xffff); } }
  if (msi_scan_u16(blk, sz, "Translation", &p)) { p = (p + 3) & ~3u; if (p + 4 <= sz) e_snprintf(lang, sizeof lang, "%u", vr16(blk, sz, p)); }
  emu_free(blk); msi_out(c, ARG(1), ARG(2), ver, wide, &rc); msi_out(c, ARG(3), ARG(4), lang, wide, &rc); RET(rc); }
static void s_MsiGetFileVersionW(Cpu *c) { msi_file_version(c, name_w(c, ARG(0)), 1); }
static void s_MsiGetFileVersionA(Cpu *c) { msi_file_version(c, name_a(c, ARG(0)), 0); }
/* MsiGetFileHash(path, options, MSIFILEHASHINFO*): the MD5 of the file in four little-endian DWORDs, as Windows Installer stores it in the MsiFileHash table */
static void msi_file_hash(Cpu *c, const char *path) { u64 info = ARG(2); if (!info || rd32(c, info) != 20) { RET(87); return; }
  int fd = vfs_open(path, 0x80000000u, 3, 0); if (fd < 0) { RET(2); return; } Md5 m; md5_init(&m); u8 buf[65536]; for (;;) { s64 n = vfs_read(fd, buf, sizeof buf); if (n <= 0) break; md5_update(&m, buf, (size_t)n); } vfs_close(fd);
  u8 d[16]; md5_final(&m, d); for (int i = 0; i < 4; i++) wr32(c, info + 4 + 4 * i, (u32)d[4 * i] | (u32)d[4 * i + 1] << 8 | (u32)d[4 * i + 2] << 16 | (u32)d[4 * i + 3] << 24); RET(0); }
static void s_MsiGetFileHashW(Cpu *c) { msi_file_hash(c, name_w(c, ARG(0))); }
static void s_MsiGetFileHashA(Cpu *c) { msi_file_hash(c, name_a(c, ARG(0))); }

/* icons and cursors as real pixel objects (BGRA, straight alpha): loaded from RT_GROUP_ICON/RT_ICON (DIB or PNG entries, best size
   picked like user32 does), from .ico/.cur files (LR_LOADFROMFILE), built from ICONINFO/CreateIcon bitmaps, or drawn procedurally for
   the IDI_* system icons.  Drawn with per-pixel alpha onto any DC (DrawIconEx, static SS_ICON, BS_ICON buttons, captions, image lists). */
#define ICON_MAX 2048
#define ICON_BASE 0x7B0001ull
static Icon g_icon[ICON_MAX];
static Icon *icon_of(u64 h) { if (h < ICON_BASE || h >= ICON_BASE + (u64)ICON_MAX * 16 || ((h - ICON_BASE) & 15)) return 0; Icon *ic = &g_icon[(h - ICON_BASE) >> 4]; return ic->used ? ic : 0; }
static u64 icon_handle(Icon *ic) { return ICON_BASE + (u64)(ic - g_icon) * 16; }
static u64 icon_new(Win32 *w, int cx, int cy, u32 *px, int cursor, int hx, int hy) { if (!px || cx <= 0 || cy <= 0) { if (px) emu_free(px); return 0; } for (int k = 0; k < ICON_MAX; k++) if (!g_icon[k].used) { Icon *ic = &g_icon[k]; e_memset(ic, 0, sizeof *ic); ic->used = 1; ic->pid = w->pid; ic->cx = cx; ic->cy = cy; ic->px = px; ic->cursor = cursor; ic->hx = hx; ic->hy = hy; return icon_handle(ic); } emu_free(px); return 0; }
static void icon_free(Icon *ic) { if (ic->px) emu_free(ic->px); e_memset(ic, 0, sizeof *ic); }
/* box-filter resample (alpha-weighted colour) — downscaling keeps edges smooth, upscaling becomes nearest */
static u32 *icon_scaled(const u32 *src, int sw, int sh, int dw, int dh) { u32 *d = emu_alloc((size_t)dw * dh * 4);
  for (int y = 0; y < dh; y++) for (int x = 0; x < dw; x++) { int x0 = x * sw / dw, x1 = (x + 1) * sw / dw, y0 = y * sh / dh, y1 = (y + 1) * sh / dh; if (x1 <= x0) x1 = x0 + 1; if (y1 <= y0) y1 = y0 + 1; u64 a = 0, r = 0, g = 0, b = 0, n = 0;
    for (int yy = y0; yy < y1 && yy < sh; yy++) for (int xx = x0; xx < x1 && xx < sw; xx++) { u32 v = src[(size_t)yy * sw + xx]; u32 va = v >> 24; a += va; r += (u64)(v >> 16 & 255) * va; g += (u64)(v >> 8 & 255) * va; b += (u64)(v & 255) * va; n++; }
    d[(size_t)y * dw + x] = !n || !a ? 0 : (u32)(a / n) << 24 | (u32)(r / a) << 16 | (u32)(g / a) << 8 | (u32)(b / a); }
  return d; }
static u32 *icon_copy_px(const Icon *ic, int cx, int cy) { if (cx <= 0) cx = ic->cx; if (cy <= 0) cy = ic->cy; if (cx == ic->cx && cy == ic->cy) { u32 *d = emu_alloc((size_t)cx * cy * 4); e_memcpy(d, ic->px, (size_t)cx * cy * 4); return d; } return icon_scaled(ic->px, ic->cx, ic->cy, cx, cy); }
/* ---- decoding ---- */
static u64 icon_from_bits(Cpu *c, const u8 *d, u32 len, int cx, int cy, int cursor) { int hx = 0, hy = 0; if (cursor) { if (len < 44) return 0; hx = d[0] | d[1] << 8; hy = d[2] | d[3] << 8; d += 4; len -= 4; }
  int bw, bh, ha; u32 *px = ico_entry_decode(d, len, &bw, &bh, &ha); if (!px) return 0; if (cx <= 0) cx = bw; if (cy <= 0) cy = bh;
  if (cx != bw || cy != bh) { u32 *np = icon_scaled(px, bw, bh, cx, cy); emu_free(px); px = np; hx = hx * cx / bw; hy = hy * cy / bh; } return icon_new(W, cx, cy, px, cursor, hx, hy); }
static u64 icon_from_guest_bits(Cpu *c, u64 a, u32 len, int cx, int cy, int cursor) { if (len < 40 || len > (64u << 20)) return 0; const u8 *d = mem_ptr(c->mem, a, len, 0); if (!d) return 0; return icon_from_bits(c, d, len, cx, cy, cursor); }
/* GRPICONDIR / GRPCURSORDIR in guest memory → RT_ICON / RT_CURSOR id of the entry closest to want_w×want_h */
static int icon_dir_pick(Cpu *c, u64 g, u32 glen, int cursor, int want_w, int want_h) { if (glen < 6) return 0; int n = rd16(c, g + 4); if (n <= 0) return 0; if (n > 64) n = 64; if ((u32)(6 + n * 14) > glen) n = (int)((glen - 6) / 14); if (n <= 0) return 0; int ws[64], hs[64], bp[64], ids[64];
  for (int k = 0; k < n; k++) { u64 en = g + 6 + (u64)k * 14; if (cursor) { ws[k] = rd16(c, en); hs[k] = rd16(c, en + 2) / 2; } else { ws[k] = rd8(c, en) ? rd8(c, en) : 256; hs[k] = rd8(c, en + 1) ? rd8(c, en + 1) : 256; } bp[k] = rd16(c, en + 6); ids[k] = rd16(c, en + 12); }
  int b = ico_pick(n, ws, hs, bp, want_w, want_h); return b < 0 ? 0 : ids[b]; }
static u64 icon_load_res(Cpu *c, u64 hmod, u64 name, int cursor, int cx, int cy, int wide) { u64 base = hmod ? hmod : W->image_base; u64 e = rsrc_lookup(c, hmod, name, cursor ? 12 : 14, wide, 0);
  if (!e) { e = rsrc_lookup(c, hmod, name, cursor ? 1 : 3, wide, 0); if (!e) return 0; return icon_from_guest_bits(c, base + rd32(c, e), rd32(c, e + 4), cx, cy, cursor); }   /* a bare RT_ICON */
  int id = icon_dir_pick(c, base + rd32(c, e), rd32(c, e + 4), cursor, cx > 0 ? cx : 32, cy > 0 ? cy : 32); if (!id) return 0; u64 e2 = rsrc_lookup(c, hmod, (u64)id, cursor ? 1 : 3, 1, 0); if (!e2) return 0;
  return icon_from_guest_bits(c, base + rd32(c, e2), rd32(c, e2 + 4), cx, cy, cursor); }
/* ---- the IDI_* system icons, drawn at 64×64 and resampled ---- */
static void icon_thick_line(Surf *s, int x0, int y0, int x1, int y1, int t, u32 col) { for (int k = -t / 2; k <= t / 2; k++) for (int j = -t / 2; j <= t / 2; j++) line_px(s, x0 + k, y0 + j, x1 + k, y1 + j, col); }
static u64 icon_system(Cpu *c, u32 id, int cx, int cy) { if (cx <= 0) cx = 32; if (cy <= 0) cy = 32; const int S = 64; u32 *px = emu_alloc((size_t)S * S * 4); e_memset(px, 0, (size_t)S * S * 4); Surf s = { px, S, S, 0, S, 0, 0 }; const u32 white = 0xfefefe, ink = 0x101010;
  switch (id) {
    case 32513: /* IDI_ERROR: red disc, white X */ fill_ellipse(&s, 2, 2, 62, 62, 0xd83b3b, 1, 0xa52020, 1); icon_thick_line(&s, 21, 21, 43, 43, 7, white); icon_thick_line(&s, 43, 21, 21, 43, 7, white); break;
    case 32514: /* IDI_QUESTION: blue disc, white ? */ fill_ellipse(&s, 2, 2, 62, 62, 0x2f78d3, 1, 0x1f5aa8, 1); fill_ellipse(&s, 19, 13, 45, 37, white, 1, white, 1); fill_ellipse(&s, 25, 19, 39, 31, 0x2f78d3, 1, 0x2f78d3, 1); fill_rect_px(&s, 19, 26, 32, 38, 0x2f78d3); fill_rect_px(&s, 29, 30, 36, 44, white); fill_rect_px(&s, 29, 48, 36, 55, white); break;
    case 32515: /* IDI_WARNING: yellow triangle, dark ! */ for (int y = 6; y < 58; y++) { int hw = (y - 6) * 29 / 52; hline(&s, 32 - hw, 32 + hw, y, 0xf7c324); } for (int y = 6; y < 58; y++) { int hw = (y - 6) * 29 / 52; put_px(&s, 32 - hw, y, 0xb08a10); put_px(&s, 32 + hw, y, 0xb08a10); } hline(&s, 3, 61, 57, 0xb08a10); fill_rect_px(&s, 29, 20, 36, 42, ink); fill_rect_px(&s, 29, 46, 36, 53, ink); break;
    case 32516: /* IDI_INFORMATION: blue disc, white i */ fill_ellipse(&s, 2, 2, 62, 62, 0x2f78d3, 1, 0x1f5aa8, 1); fill_rect_px(&s, 28, 13, 36, 21, white); fill_rect_px(&s, 29, 26, 35, 50, white); fill_rect_px(&s, 25, 26, 35, 30, white); fill_rect_px(&s, 25, 47, 39, 51, white); break;
    case 32518: /* IDI_SHIELD */ for (int y = 4; y < 60; y++) { int hw = y < 34 ? 26 : 26 - (y - 34) * 26 / 26; if (hw < 1) hw = 1; hline(&s, 32 - hw, 32 + hw, y, y < 32 ? (0) : 0); for (int x = 32 - hw; x <= 32 + hw; x++) put_px(&s, x, y, ((x < 32) ^ (y < 32)) ? 0x2f78d3 : 0xf7c324); put_px(&s, 32 - hw, y, 0x404040); put_px(&s, 32 + hw, y, 0x404040); } hline(&s, 6, 58, 4, 0x404040); break;
    default: /* IDI_APPLICATION / WINLOGO: a small window */ fill_rect_px(&s, 6, 8, 58, 56, white); fill_rect_px(&s, 6, 8, 58, 20, 0x2f78d3); edge_rect(&s, 6, 8, 58, 56, 0x404040, 0x404040); fill_rect_px(&s, 48, 11, 54, 17, white); fill_rect_px(&s, 12, 28, 40, 32, 0xc0c0c0); fill_rect_px(&s, 12, 38, 48, 42, 0xc0c0c0); break; }
  for (int k = 0; k < S * S; k++) if (px[k]) px[k] |= 0xff000000u; u32 *out = icon_scaled(px, S, S, cx, cy); emu_free(px); return icon_new(W, cx, cy, out, 0, 0, 0); }
/* ---- lookup used by LoadIcon / LoadImage / LoadIconWithScaleDown: module resource, then the system set; LR_SHARED handles are cached per (module, name, size) ---- */
static u64 icon_name_key(Cpu *c, u64 name, int wide) { if (name < 0x10000) return name; char s[128]; text_in(c, name, wide, s, sizeof s); u64 h = 1469598103934665603ull; for (const char *p = s; *p; p++) h = (h ^ (u8)*p) * 1099511628211ull; return h | 0x10000; }
static u64 icon_load_any(Cpu *c, u64 hmod, u64 name, int cursor, int cx, int cy, int wide, int shared) { Win32 *w = W; u64 key = icon_name_key(c, name, wide);
  if (shared) for (int k = 0; k < ICON_MAX; k++) { Icon *ic = &g_icon[k]; if (ic->used && ic->shared && ic->pid == w->pid && ic->hmod == hmod && ic->key == key && ic->cursor == cursor && (cx <= 0 || ic->cx == cx) && (cy <= 0 || ic->cy == cy)) return icon_handle(ic); }
  u64 h = 0; if (!cursor) { h = icon_load_res(c, hmod, name, 0, cx, cy, wide); if (!h && !hmod && name >= 32512 && name <= 32518) h = icon_system(c, (u32)name, cx, cy); }
  else { h = icon_load_res(c, hmod, name, 1, cx, cy, wide); if (!h && name < 0x10000) return 0x7A001 + (name & 0xfff) * 0x10; }   /* system cursors keep their pseudo handles: the pointer shape is the host's */
  if (h && shared) { Icon *ic = icon_of(h); ic->shared = 1; ic->hmod = hmod; ic->key = key; } return h; }
/* ---- drawing ---- */
static void icon_blit(Surf *s, const u32 *img, int iw, int ih, int x, int y, int mask_only) { for (int yy = 0; yy < ih; yy++) { int py = y + yy; if (py < s->y0 || py >= s->h) continue; u32 *row = srow(s, py); for (int xx = 0; xx < iw; xx++) { int px = x + xx; if (px < s->x0 || px >= s->w) continue; u32 v = img[(size_t)yy * iw + xx]; u32 a = v >> 24; if (mask_only) { row[px] = a ? 0 : 0xffffff; continue; } if (!a) continue; if (a == 255) { row[px] = v & 0xffffff; continue; } u32 d = row[px]; u32 r = ((v >> 16 & 255) * a + (d >> 16 & 255) * (255 - a)) / 255, g = ((v >> 8 & 255) * a + (d >> 8 & 255) * (255 - a)) / 255, b = ((v & 255) * a + (d & 255) * (255 - a)) / 255; row[px] = r << 16 | g << 8 | b; } } }
static int icon_draw(Cpu *c, u64 hdc, int x, int y, Icon *ic, int cx, int cy, u64 hbr, u32 flags) { Surf s; if (!dc_surf(c, hdc, &s)) return 0; if (cx <= 0) cx = ic->cx; if (cy <= 0) cy = ic->cy; GdiObj *br = hbr ? gdi_get(W, hbr) : 0; if (br && br->kind == K_BRUSH) fill_rect_px(&s, x, y, x + cx, y + cy, br->color);
  if (cx == ic->cx && cy == ic->cy) icon_blit(&s, ic->px, cx, cy, x, y, (flags & 3) == 1); else { u32 *t = icon_scaled(ic->px, ic->cx, ic->cy, cx, cy); icon_blit(&s, t, cx, cy, x, y, (flags & 3) == 1); emu_free(t); } mark_screen(W, hdc); return 1; }
static void icon_draw_surf(Surf *s, Icon *ic, int x, int y, int cx, int cy) { if (cx <= 0) cx = ic->cx; if (cy <= 0) cy = ic->cy; if (cx == ic->cx && cy == ic->cy) icon_blit(s, ic->px, cx, cy, x, y, 0); else { u32 *t = icon_scaled(ic->px, ic->cx, ic->cy, cx, cy); icon_blit(s, t, cx, cy, x, y, 0); emu_free(t); } }
/* ---- pixels of a GDI bitmap (32-bpp surfaces; monochrome bitmaps are stored as black/white) ---- */
static u32 *bitmap_px(Win32 *w, u64 hbm, int *bw, int *bh) { GdiObj *bm = gdi_get(w, hbm); if (!bm || bm->kind != K_BITMAP) return 0; if (bm->dib_section && bm->dib_bpp != 32) dib_sync(w, bm); *bw = bm->bw; *bh = bm->bh; return (u32 *)mem_ptr(w->mem, bm->bits, (u64)bm->bw * bm->bh * 4, 0); }
static u64 icon_from_bitmaps(Cpu *c, u64 hbm_mask, u64 hbm_color, int cursor, int hx, int hy) { Win32 *w = W; int mw = 0, mh = 0, cw = 0, chh = 0; u32 *mask = hbm_mask ? bitmap_px(w, hbm_mask, &mw, &mh) : 0, *col = hbm_color ? bitmap_px(w, hbm_color, &cw, &chh) : 0; if (!mask && !col) return 0;
  int iw = col ? cw : mw, ih = col ? chh : (mask ? mh / 2 : 0); if (iw <= 0 || ih <= 0 || iw > 1024 || ih > 1024) return 0; u32 *px = emu_alloc((size_t)iw * ih * 4); int any_alpha = 0; if (col) for (int k = 0; k < iw * ih; k++) if (col[k] >> 24) { any_alpha = 1; break; }
  for (int y = 0; y < ih; y++) for (int x = 0; x < iw; x++) { u32 v; if (col) { v = col[(size_t)y * cw + x]; if (!any_alpha) { int transparent = mask && x < mw && y < mh ? (mask[(size_t)y * mw + x] & 0xffffff) != 0 : 0; v = (v & 0xffffff) | (transparent ? 0 : 0xff000000u); } }
      else { int andb = (mask[(size_t)y * mw + x] & 0xffffff) != 0, xorb = (mask[(size_t)(y + ih) * mw + x] & 0xffffff) != 0; v = andb ? (xorb ? 0xff000000u : 0) : (xorb ? 0xffffffffu : 0xff000000u); }   /* AND=1,XOR=1 → invert: drawn as black */
      px[(size_t)y * iw + x] = v; }
  return icon_new(w, iw, ih, px, cursor, hx, hy); }
static u64 icon_mask_bitmap(Cpu *c, const Icon *ic, int with_color) { u64 bits; int h = with_color ? ic->cy : ic->cy * 2; u64 hbm = make_bitmap(c, ic->cx, h, 0, &bits); if (!hbm) return 0; u32 *d = (u32 *)mem_ptr(c->mem, bits, (u64)ic->cx * h * 4, 1); if (!d) return hbm;
  for (int y = 0; y < ic->cy; y++) for (int x = 0; x < ic->cx; x++) { u32 v = ic->px[(size_t)y * ic->cx + x]; d[(size_t)y * ic->cx + x] = (v >> 24) >= 128 ? 0 : 0xffffff; if (!with_color) d[(size_t)(y + ic->cy) * ic->cx + x] = (v >> 24) >= 128 ? (v & 0xffffff) : 0; } return hbm; }
static u64 icon_color_bitmap(Cpu *c, const Icon *ic) { u64 bits; u64 hbm = make_bitmap(c, ic->cx, ic->cy, 0, &bits); if (!hbm) return 0; u32 *d = (u32 *)mem_ptr(c->mem, bits, (u64)ic->cx * ic->cy * 4, 1); if (d) e_memcpy(d, ic->px, (size_t)ic->cx * ic->cy * 4); return hbm; }
/* ---- shims ---- */
static void s_LoadIconA(Cpu *c) { u64 h = icon_load_any(c, ARG(0), ARG(1), 0, 32, 32, 0, 1); if (!h) W->last_error = 1813; RET(h); }
static void s_LoadIconW(Cpu *c) { u64 h = icon_load_any(c, ARG(0), ARG(1), 0, 32, 32, 1, 1); if (!h) W->last_error = 1813; RET(h); }
static void s_LoadCursorA(Cpu *c) { RET(icon_load_any(c, ARG(0), ARG(1), 1, 32, 32, 0, 1)); }
static void s_LoadCursorW(Cpu *c) { RET(icon_load_any(c, ARG(0), ARG(1), 1, 32, 32, 1, 1)); }
static void s_LoadIconWithScaleDown(Cpu *c) { if (!ARG(4)) { RET(0x80070057); return; } u64 h = icon_load_any(c, ARG(0), ARG(1), 0, (int)ARG(2), (int)ARG(3), 1, 0); wrp(c, ARG(4), h); RET(h ? 0 : 0x80070002); }
static void s_LoadIconMetric(Cpu *c) { if (!ARG(3)) { RET(0x80070057); return; } int d = (int)ARG(2) == 0 ? 16 : 32; u64 h = icon_load_any(c, ARG(0), ARG(1), 0, d, d, 1, 0); wrp(c, ARG(3), h); RET(h ? 0 : 0x80070002); }
static u8 *icon_read_file(Cpu *c, u64 name, int wide, size_t *len) { char path[520]; text_in(c, name, wide, path, sizeof path); u64 sz; if (!path[0] || !vfs_stat(path, &sz) || sz == 0 || sz > (64u << 20)) return 0; int fd = vfs_open(path, 1, 3, 0); if (fd < 0) return 0; u8 *buf = emu_alloc((size_t)sz + 1); s64 got = vfs_read(fd, buf, sz); vfs_close(fd); if (got <= 0) { emu_free(buf); return 0; } *len = (size_t)got; return buf; }
static u64 load_image_impl(Cpu *c, u64 hinst, u64 name, u32 type, int cx, int cy, u32 flags, int wide) { Win32 *w = W;
  if (type == 1 || type == 2) { if ((flags & 0x40) && cx <= 0) cx = 32; if ((flags & 0x40) && cy <= 0) cy = 32;
    if (flags & 0x10) { size_t n; u8 *buf = icon_read_file(c, name, wide, &n); if (!buf) { w->last_error = 2; return 0; } int bw, bh, ha, hx, hy; u32 *px = ico_decode_sized(buf, n, cx, cy, &bw, &bh, &ha, &hx, &hy); emu_free(buf); if (!px) { w->last_error = 1813; return 0; }
      if (cx <= 0) cx = bw; if (cy <= 0) cy = bh; if (cx != bw || cy != bh) { u32 *np = icon_scaled(px, bw, bh, cx, cy); emu_free(px); px = np; } return icon_new(w, cx, cy, px, type == 2, hx, hy); }
    u64 h = icon_load_any(c, hinst, name, type == 2, cx, cy, wide, (flags & 0x8000) != 0); if (!h) w->last_error = 1813; return h; }
  if (type == 0) { if (flags & 0x10) { size_t n; u8 *buf = icon_read_file(c, name, wide, &n); if (!buf) { w->last_error = 2; return 0; } int bw, bh, ha; u32 *px = bmp_decode(buf, n, &bw, &bh, &ha); emu_free(buf); if (!px) { w->last_error = 1813; return 0; }
      u64 bits; u64 hbm = make_bitmap(c, bw, bh, 0, &bits); if (hbm) { u32 *d = (u32 *)mem_ptr(c->mem, bits, (u64)bw * bh * 4, 1); if (d) { if (cx > 0 && cy > 0 && (cx != bw || cy != bh)) { u32 *t = icon_scaled(px, bw, bh, cx, cy); emu_free(px); px = t; bw = cx; bh = cy; } e_memcpy(d, px, (size_t)bw * bh * 4); } } emu_free(px); return hbm; }
    if (name < 0x10000 || wide) { /* RT_BITMAP → a DIB at any depth becomes a real 32-bpp surface */ u64 e = rsrc_lookup(c, hinst, name, 2, wide, 0); if (e) { u64 base = hinst ? hinst : w->image_base; u64 bmi = base + rd32(c, e); u32 hsz = rd32(c, bmi); s32 bw = (s32)rd32(c, bmi + 4), bh = (s32)rd32(c, bmi + 8); u16 bpp = rd16(c, bmi + 14); u32 comp = rd32(c, bmi + 16), clr = rd32(c, bmi + 32); if (bh < 0) bh = -bh;
      if (bw > 0 && bh > 0 && bw < 4096 && bh < 4096 && (comp == 0 || comp == 3)) { u64 bits; u64 h = make_bitmap(c, bw, bh, 0, &bits); if (h) { u64 pal = bpp <= 8 ? (u64)(clr ? clr : 1u << bpp) * 4 : (comp == 3 ? 12 : 0); u32 *px = (u32 *)mem_ptr(c->mem, bits, (u64)bw * bh * 4, 1); if (px) dib_decode(c, bmi, bmi + hsz + pal, px, bw, bh, 0); return h; } } } }
    w->last_error = 1814; return 0; }
  return 0; }
static void s_LoadImageW(Cpu *c) { RET(load_image_impl(c, ARG(0), ARG(1), (u32)ARG(2), (int)(s32)ARG(3), (int)(s32)ARG(4), (u32)ARG(5), 1)); }
static void s_LoadImageA(Cpu *c) { RET(load_image_impl(c, ARG(0), ARG(1), (u32)ARG(2), (int)(s32)ARG(3), (int)(s32)ARG(4), (u32)ARG(5), 0)); }
static void s_CopyIcon(Cpu *c) { Icon *ic = icon_of(ARG(0)); if (!ic) { RET(ARG(0)); return; } RET(icon_new(W, ic->cx, ic->cy, icon_copy_px(ic, 0, 0), ic->cursor, ic->hx, ic->hy)); }
static void s_CopyImage(Cpu *c) { u32 type = (u32)ARG(1); int cx = (int)(s32)ARG(2), cy = (int)(s32)ARG(3); if (type == 1 || type == 2) { Icon *ic = icon_of(ARG(0)); if (!ic) { RET(ARG(0)); return; } if (cx <= 0) cx = ic->cx; if (cy <= 0) cy = ic->cy; RET(icon_new(W, cx, cy, icon_copy_px(ic, cx, cy), ic->cursor, ic->hx * cx / ic->cx, ic->hy * cy / ic->cy)); return; }
  if (type == 0) { int bw, bh; u32 *src = bitmap_px(W, ARG(0), &bw, &bh); if (!src) { RET(ARG(0)); return; } if (cx <= 0) cx = bw; if (cy <= 0) cy = bh; u64 bits; u64 h = make_bitmap(c, cx, cy, 0, &bits); if (!h) { RET(0); return; } u32 *d = (u32 *)mem_ptr(c->mem, bits, (u64)cx * cy * 4, 1); if (d) { if (cx == bw && cy == bh) e_memcpy(d, src, (size_t)cx * cy * 4); else for (int y = 0; y < cy; y++) for (int x = 0; x < cx; x++) d[(size_t)y * cx + x] = src[(size_t)(y * bh / cy) * bw + x * bw / cx]; } RET(h); return; }
  RET(ARG(0)); }
static void s_DestroyIcon(Cpu *c) { Icon *ic = icon_of(ARG(0)); if (ic && !ic->shared) icon_free(ic); RET(1); }
static void s_DestroyCursor(Cpu *c) { s_DestroyIcon(c); }

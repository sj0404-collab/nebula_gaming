/* icons and cursors as real pixel objects (BGRA, straight alpha): loaded from RT_GROUP_ICON/RT_ICON (DIB or PNG entries, best size
   picked like user32 does), from .ico/.cur files (LR_LOADFROMFILE), built from ICONINFO/CreateIcon bitmaps, or drawn procedurally for
   the IDI_* system icons.  Drawn with per-pixel alpha onto any DC (DrawIconEx, static SS_ICON, BS_ICON buttons, captions, image lists). */
#define ICON_MAX 2048
#define ICON_BASE 0x7B0001ull
static Icon g_icon[ICON_MAX];
static Icon *icon_of(u64 h) { if (h < ICON_BASE || h >= ICON_BASE + (u64)ICON_MAX * 16 || ((h - ICON_BASE) & 15)) return 0; Icon *ic = &g_icon[(h - ICON_BASE) >> 4]; return ic->used ? ic : 0; }
static u64 icon_handle(Icon *ic) { return ICON_BASE + (u64)(ic - g_icon) * 16; }
static u64 icon_new(Win32 *w, int cx, int cy, u32 *px, int cursor, int hx, int hy) { if (!px || cx <= 0 || cy <= 0) { if (px) emu_free(px); return 0; } for (int k = 0; k < ICON_MAX; k++) if (!g_icon[k].used) { Icon *ic = &g_icon[k]; e_memset(ic, 0, sizeof *ic); ic->used = 1; ic->pid = w->pid; ic->cx = cx; ic->cy = cy; ic->px = px; ic->cursor = cursor; ic->hx = hx; ic->hy = hy; return icon_handle(ic); } emu_free(px); return 0; }
static void icon_free(Icon *ic) { if (ic->px) emu_free(ic->px); e_memset(ic, 0, sizeof *ic); }
/* box-filter resample (alpha-weighted colour) — downscaling keeps edges smooth, upscaling becomes nearest */
static u32 *icon_scaled(const u32 *src, int sw, int sh, int dw, int dh) { u32 *d = emu_alloc((size_t)dw * dh * 4);
  for (int y = 0; y < dh; y++) for (int x = 0; x < dw; x++) { int x0 = x * sw / dw, x1 = (x + 1) * sw / dw, y0 = y * sh / dh, y1 = (y + 1) * sh / dh; if (x1 <= x0) x1 = x0 + 1; if (y1 <= y0) y1 = y0 + 1; u64 a = 0, r = 0, g = 0, b = 0, n = 0;
    for (int yy = y0; yy < y1 && yy < sh; yy++) for (int xx = x0; xx < x1 && xx < sw; xx++) { u32 v = src[(size_t)yy * sw + xx]; u32 va = v >> 24; a += va; r += (u64)(v >> 16 & 255) * va; g += (u64)(v >> 8 & 255) * va; b += (u64)(v & 255) * va; n++; }
    d[(size_t)y * dw + x] = !n || !a ? 0 : (u32)(a / n) << 24 | (u32)(r / a) << 16 | (u32)(g / a) << 8 | (u32)(b / a); }
  return d; }
static u32 *icon_copy_px(const Icon *ic, int cx, int cy) { if (cx <= 0) cx = ic->cx; if (cy <= 0) cy = ic->cy; if (cx == ic->cx && cy == ic->cy) { u32 *d = emu_alloc((size_t)cx * cy * 4); e_memcpy(d, ic->px, (size_t)cx * cy * 4); return d; } return icon_scaled(ic->px, ic->cx, ic->cy, cx, cy); }
/* ---- decoding ---- */
static u64 icon_from_bits(Cpu *c, const u8 *d, u32 len, int cx, int cy, int cursor) { int hx = 0, hy = 0; if (cursor) { if (len < 44) return 0; hx = d[0] | d[1] << 8; hy = d[2] | d[3] << 8; d += 4; len -= 4; }
  int bw, bh, ha; u32 *px = ico_entry_decode(d, len, &bw, &bh, &ha); if (!px) return 0; if (cx <= 0) cx = bw; if (cy <= 0) cy = bh;
  if (cx != bw || cy != bh) { u32 *np = icon_scaled(px, bw, bh, cx, cy); emu_free(px); px = np; hx = hx * cx / bw; hy = hy * cy / bh; } return icon_new(W, cx, cy, px, cursor, hx, hy); }
static u64 icon_from_guest_bits(Cpu *c, u64 a, u32 len, int cx, int cy, int cursor) { if (len < 40 || len > (64u << 20)) return 0; const u8 *d = mem_ptr(c->mem, a, len, 0); if (!d) return 0; return icon_from_bits(c, d, len, cx, cy, cursor); }
/* GRPICONDIR / GRPCURSORDIR in guest memory → RT_ICON / RT_CURSOR id of the entry closest to want_w×want_h */
static int icon_dir_pick(Cpu *c, u64 g, u32 glen, int cursor, int want_w, int want_h) { if (glen < 6) return 0; int n = rd16(c, g + 4); if (n <= 0) return 0; if (n > 64) n = 64; if ((u32)(6 + n * 14) > glen) n = (int)((glen - 6) / 14); if (n <= 0) return 0; int ws[64], hs[64], bp[64], ids[64];
  for (int k = 0; k < n; k++) { u64 en = g + 6 + (u64)k * 14; if (cursor) { ws[k] = rd16(c, en); hs[k] = rd16(c, en + 2) / 2; } else { ws[k] = rd8(c, en) ? rd8(c, en) : 256; hs[k] = rd8(c, en + 1) ? rd8(c, en + 1) : 256; } bp[k] = rd16(c, en + 6); ids[k] = rd16(c, en + 12); }
  int b = ico_pick(n, ws, hs, bp, want_w, want_h); return b < 0 ? 0 : ids[b]; }
static u64 icon_load_res(Cpu *c, u64 hmod, u64 name, int cursor, int cx, int cy, int wide) { u64 base = hmod ? hmod : W->image_base; u64 e = rsrc_lookup(c, hmod, name, cursor ? 12 : 14, wide, 0);
  if (!e) { e = rsrc_lookup(c, hmod, name, cursor ? 1 : 3, wide, 0); if (!e) return 0; return icon_from_guest_bits(c, base + rd32(c, e), rd32(c, e + 4), cx, cy, cursor); }   /* a bare RT_ICON */
  int id = icon_dir_pick(c, base + rd32(c, e), rd32(c, e + 4), cursor, cx > 0 ? cx : 32, cy > 0 ? cy : 32); if (!id) return 0; u64 e2 = rsrc_lookup(c, hmod, (u64)id, cursor ? 1 : 3, 1, 0); if (!e2) return 0;
  return icon_from_guest_bits(c, base + rd32(c, e2), rd32(c, e2 + 4), cx, cy, cursor); }
/* ---- the IDI_* system icons, drawn at 64×64 and resampled ---- */
static void icon_thick_line(Surf *s, int x0, int y0, int x1, int y1, int t, u32 col) { for (int k = -t / 2; k <= t / 2; k++) for (int j = -t / 2; j <= t / 2; j++) line_px(s, x0 + k, y0 + j, x1 + k, y1 + j, col); }
static u64 icon_system(Cpu *c, u32 id, int cx, int cy) { if (cx <= 0) cx = 32; if (cy <= 0) cy = 32; const int S = 64; u32 *px = emu_alloc((size_t)S * S * 4); e_memset(px, 0, (size_t)S * S * 4); Surf s = { px, S, S, 0, S, 0, 0 }; const u32 white = 0xfefefe, ink = 0x101010;
  switch (id) {
    case 32513: /* IDI_ERROR: red disc, white X */ fill_ellipse(&s, 2, 2, 62, 62, 0xd83b3b, 1, 0xa52020, 1); icon_thick_line(&s, 21, 21, 43, 43, 7, white); icon_thick_line(&s, 43, 21, 21, 43, 7, white); break;
    case 32514: /* IDI_QUESTION: blue disc, white ? */ fill_ellipse(&s, 2, 2, 62, 62, 0x2f78d3, 1, 0x1f5aa8, 1); fill_ellipse(&s, 19, 13, 45, 37, white, 1, white, 1); fill_ellipse(&s, 25, 19, 39, 31, 0x2f78d3, 1, 0x2f78d3, 1); fill_rect_px(&s, 19, 26, 32, 38, 0x2f78d3); fill_rect_px(&s, 29, 30, 36, 44, white); fill_rect_px(&s, 29, 48, 36, 55, white); break;
    case 32515: /* IDI_WARNING: yellow triangle, dark ! */ for (int y = 6; y < 58; y++) { int hw = (y - 6) * 29 / 52; hline(&s, 32 - hw, 32 + hw, y, 0xf7c324); } for (int y = 6; y < 58; y++) { int hw = (y - 6) * 29 / 52; put_px(&s, 32 - hw, y, 0xb08a10); put_px(&s, 32 + hw, y, 0xb08a10); } hline(&s, 3, 61, 57, 0xb08a10); fill_rect_px(&s, 29, 20, 36, 42, ink); fill_rect_px(&s, 29, 46, 36, 53, ink); break;
    case 32516: /* IDI_INFORMATION: blue disc, white i */ fill_ellipse(&s, 2, 2, 62, 62, 0x2f78d3, 1, 0x1f5aa8, 1); fill_rect_px(&s, 28, 13, 36, 21, white); fill_rect_px(&s, 29, 26, 35, 50, white); fill_rect_px(&s, 25, 26, 35, 30, white); fill_rect_px(&s, 25, 47, 39, 51, white); break;
    case 32518: /* IDI_SHIELD */ for (int y = 4; y < 60; y++) { int hw = y < 34 ? 26 : 26 - (y - 34) * 26 / 26; if (hw < 1) hw = 1; hline(&s, 32 - hw, 32 + hw, y, y < 32 ? (0) : 0); for (int x = 32 - hw; x <= 32 + hw; x++) put_px(&s, x, y, ((x < 32) ^ (y < 32)) ? 0x2f78d3 : 0xf7c324); put_px(&s, 32 - hw, y, 0x404040); put_px(&s, 32 + hw, y, 0x404040); } hline(&s, 6, 58, 4, 0x404040); break;
    default: /* IDI_APPLICATION / WINLOGO: a small window */ fill_rect_px(&s, 6, 8, 58, 56, white); fill_rect_px(&s, 6, 8, 58, 20, 0x2f78d3); edge_rect(&s, 6, 8, 58, 56, 0x404040, 0x404040); fill_rect_px(&s, 48, 11, 54, 17, white); fill_rect_px(&s, 12, 28, 40, 32, 0xc0c0c0); fill_rect_px(&s, 12, 38, 48, 42, 0xc0c0c0); break; }
  for (int k = 0; k < S * S; k++) if (px[k]) px[k] |= 0xff000000u; u32 *out = icon_scaled(px, S, S, cx, cy); emu_free(px); return icon_new(W, cx, cy, out, 0, 0, 0); }
/* ---- the shell32.dll / imageres.dll icon set (the resource ids every file manager, installer and launcher asks for by number), Windows 10 flat style, 64x64 ---- */
static void icon_page(Surf *s, u32 paper, u32 edge) { for (int y = 6; y < 60; y++) { int r = (y < 20) ? 44 - (20 - y) : 44; hline(s, 14, r, y, paper); } for (int y = 6; y < 20; y++) { put_px(s, 44 - (20 - y), y, edge); put_px(s, 44 - (20 - y) + 1, y, edge); } edge_rect(s, 14, 6, 46, 60, edge, edge); for (int y = 6; y < 20; y++) hline(s, 32 + (y - 6), 44, y, 0); for (int y = 6; y < 20; y++) { hline(s, 32, 32 + (y - 6), y, 0xd8d8d8); put_px(s, 32, y, edge); } hline(s, 32, 45, 20, edge); }
static void icon_folder(Surf *s, int open) { u32 back = 0xdcb67a, front = 0xf5cf7a, edge = 0xc49a4a; fill_rect_px(s, 4, 12, 30, 20, back); fill_rect_px(s, 4, 18, 60, 56, back); edge_rect(s, 4, 12, 30, 20, edge, edge); edge_rect(s, 4, 18, 60, 56, edge, edge);
  if (!open) { fill_rect_px(s, 4, 24, 60, 56, front); edge_rect(s, 4, 24, 60, 56, edge, edge); } else { for (int y = 28; y < 56; y++) { int x0 = 10 - (y - 28) * 6 / 28; hline(s, x0 < 4 ? 4 : x0, 60, y, front); } edge_rect(s, 4, 28, 60, 56, edge, edge); } }
static void icon_drive(Surf *s, u32 body, int led, int net) { fill_rect_px(s, 4, 22, 60, 50, body); edge_rect(s, 4, 22, 60, 50, 0x707070, 0x505050); hline(s, 5, 58, 36, 0x9a9a9a); if (led) fill_rect_px(s, 50, 42, 56, 46, 0x2fcc40); if (net) { fill_rect_px(s, 24, 52, 40, 56, 0x3c8fd6); fill_rect_px(s, 30, 50, 34, 58, 0x3c8fd6); } }
static void icon_monitor(Surf *s) { fill_rect_px(s, 4, 8, 60, 46, 0x2b6fc4); edge_rect(s, 4, 8, 60, 46, 0x3a3a3a, 0x3a3a3a); fill_rect_px(s, 8, 12, 56, 42, 0x4fa3f0); fill_rect_px(s, 26, 46, 38, 54, 0x5a5a5a); fill_rect_px(s, 16, 54, 48, 58, 0x5a5a5a); }

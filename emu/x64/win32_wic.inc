static u64 wic_vtable(Cpu *c, int kind) { Win32 *w = W; if (g_wvt_owner != w) { e_memset(g_wvt, 0, sizeof g_wvt); g_wvt_owner = w; } if (g_wvt[kind]) return g_wvt[kind]; const WIface *f = &g_wif[kind]; u64 P = PSZ_OF(c); u64 vt = w32_heap_alloc(w, (u64)f->n * P, 1); if (!vt) return 0; for (int i = 0; i < f->n; i++) { char nm[96]; e_snprintf(nm, sizeof nm, "%s::%s", f->name, f->m[i]); wrp(c, vt + (u64)i * P, w32_shim_slot(w, "windowscodecs", nm)); } g_wvt[kind] = vt; return vt; }
static WObj *wobj_new(Cpu *c, int kind, u64 *addr_out) { int id; for (id = 1; id < WOBJ_MAX && g_wobj[id].used; id++) { } if (id == WOBJ_MAX) return 0; u64 vt = wic_vtable(c, kind); u64 a = w32_heap_alloc(W, 32, 1); if (!vt || !a) return 0; wrp(c, a, vt); wr32(c, a + 8, (u32)id); wr32(c, a + 12, 1); WObj *o = &g_wobj[id]; e_memset(o, 0, sizeof *o); o->used = 1; o->kind = kind; o->addr = a; o->w = W; o->refs = 1; o->src = -1; o->lock_src = -1; o->fmt = 0x0F; *addr_out = a; return o; }
static WObj *wobj_of(Cpu *c, u64 self, int kind) { if (!self || !mem_ptr(c->mem, self, 16, 0)) return 0; u32 id = rd32(c, self + 8); if (id >= WOBJ_MAX || !g_wobj[id].used || g_wobj[id].addr != self) return 0; if (kind && g_wobj[id].kind != kind) return 0; return &g_wobj[id]; }
static int wobj_id(WObj *o) { return (int)(o - g_wobj); }
static void wobj_free(WObj *o) { if (o->px) emu_free(o->px); if (o->data) emu_free(o->data); if (o->lock_buf) w32_heap_free(o->w, o->lock_buf); if (o->src >= 0 && g_wobj[o->src].used) { if (--g_wobj[o->src].refs <= 0) wobj_free(&g_wobj[o->src]); } e_memset(o, 0, sizeof *o); }
/* the pixel source of any bitmap-source object (frames share the decoder's pixels; converters/scalers chain) */
static WObj *wobj_pixels(WObj *o) { int guard = 0; while (o && !o->px && o->src >= 0 && guard++ < 8) o = &g_wobj[o->src]; return o && o->px ? o : 0; }
static const u8 GUID_WICPixelFormat_prefix[15] = { 0x24, 0xc3, 0xdd, 0x6f, 0x03, 0x4e, 0xfe, 0x4b, 0xb1, 0x85, 0x3d, 0x77, 0x76, 0x8d, 0xc9 }; /* 6fddc324-4e03-4bfe-b185-3d77768dc9XX */

/* ===== tab control ===== */
static int tab_h(Win32 *w, Wnd *n, TabCtl *tc) { return tc->fixh ? tc->fixh : cc_font_h(w, n) + 2 * tc->pady + 2; }
static void tab_layout(Win32 *w, int i) { Wnd *n = &g_wnd[i]; TabCtl *tc = n->cc; int x = 2; for (int k = 0; k < tc->n; k++) { int tw = tc->fixw ? tc->fixw : text_width(w, n->font ? n->font : g_dlg_font, tc->t[k].text, (int)e_strlen(tc->t[k].text)) + 2 * tc->padx + (iml_of(tc->himl) && tc->t[k].image >= 0 ? iml_of(tc->himl)->cx + 4 : 0); tc->t[k].x = x; tc->t[k].w = tw; x += tw; } }
static void tab_paint(Cpu *c, int i) { Win32 *w = W; Wnd *n = &g_wnd[i]; TabCtl *tc = n->cc; u64 hdc = ctl_paint_begin(c, i); if (!hdc) { RET(0); return; } Surf s; if (dc_surf(c, hdc, &s) && tc) { GdiObj *d = cc_dc(w, hdc, n); int cw = wnd_client_w(i), ch = wnd_client_h(i); int fh = cc_font_h(w, n); int th = tab_h(w, n, tc); tab_layout(w, i); int buttons = (n->style & 0x100) != 0; int bottom = (n->style & 0x2) != 0; fill_rect_px(&s, 0, 0, cw, ch, 0xf0f0f0);
    int by0 = bottom ? 0 : th, by1 = bottom ? ch - th : ch; if (!buttons) { fill_rect_px(&s, 0, by0, cw, by1, 0xffffff); edge_rect(&s, 0, by0, cw, by1, 0xd9d9d9, 0xd9d9d9); }
    ImgList *il = iml_of(tc->himl);
    for (int pass = 0; pass < 2; pass++) for (int k = 0; k < tc->n; k++) { int sel = k == tc->cur; if ((pass == 0) == sel) continue; int x = tc->t[k].x, tw = tc->t[k].w; int y0 = bottom ? ch - th : 0, y1 = bottom ? ch : th; if (sel && !buttons) { y0 = bottom ? y0 - 2 : y0 - 2; y1 = bottom ? y1 : y1 + 2; x -= 2; tw += 4; if (y0 < 0) y0 = 0; }
      if (buttons) { if (sel) { fill_rect_px(&s, x, y0 + 1, x + tw, y1 - 1, 0xcce4f7); edge_rect(&s, x, y0 + 1, x + tw, y1 - 1, 0x7eb4ea, 0x7eb4ea); } else edge_rect(&s, x, y0 + 1, x + tw, y1 - 1, 0xd9d9d9, 0xd9d9d9); }
      else { fill_rect_px(&s, x, y0, x + tw, y1, sel ? 0xffffff : 0xf0f0f0); hline(&s, x, x + tw - 1, bottom ? y1 - 1 : y0, 0xd9d9d9); line_px(&s, x, y0, x, y1 - 1, 0xd9d9d9); line_px(&s, x + tw - 1, y0, x + tw - 1, y1 - 1, 0xd9d9d9); if (!sel) { if (bottom) hline(&s, x, x + tw - 1, y0, 0xd9d9d9); } else { /* open towards the page */ hline(&s, x + 1, x + tw - 2, bottom ? y0 : y1 - 1, 0xffffff); hline(&s, x + 1, x + tw - 2, bottom ? y0 - 1 : y1, 0xffffff); } }
      int tx = x + (tw - (tc->t[k].w - 2 * tc->padx)) / 2; if (il && tc->t[k].image >= 0 && tc->t[k].image < il->n) { iml_draw(c, il, tc->t[k].image, hdc, tx, y0 + (y1 - y0 - il->cy) / 2, 0, 0, 0); tx += il->cx + 4; } if (d) cc_text(&s, d, w, tx, y0 + (y1 - y0 - fh) / 2, tc->t[k].text, n->enabled ? 0x000000 : 0x6d6d6d); } }
  ctl_paint_end(c, i, hdc); RET(0); }
/* TCITEM: mask@0 dwState@4 dwStateMask@8 pszText@12/16 cchTextMax@16/24 iImage@20/28 lParam@24/32 */
static void tab_item_io(Cpu *c, int i, TabCtl *tc, int k, u64 it, int set, int wide) { u32 mask = rd32(c, it); u64 txo = c->mode32 ? 12 : 16, cho = c->mode32 ? 16 : 24, imo = c->mode32 ? 20 : 28, lpo = c->mode32 ? 24 : 32;
  if (set) { if (mask & 1) { u64 t = rdp(c, it + txo); if (t && t != (u64)(u32)-1) text_in(c, t, wide, tc->t[k].text, sizeof tc->t[k].text); } if (mask & 2) tc->t[k].image = (int)(s32)rd32(c, it + imo); if (mask & 8) tc->t[k].lparam = rdp(c, it + lpo); if (mask & 0x10) { u32 sm = rd32(c, it + 8); tc->t[k].state = (tc->t[k].state & ~sm) | (rd32(c, it + 4) & sm); } wnd_invalidate(i, 1); return; }
  if (mask & 1) { u64 t = rdp(c, it + txo); u32 cch = rd32(c, it + cho); if (t && cch) text_out_cap(c, t, tc->t[k].text, cch, wide); } if (mask & 2) wr32(c, it + imo, (u32)tc->t[k].image); if (mask & 8) wrp(c, it + lpo, tc->t[k].lparam); if (mask & 0x10) wr32(c, it + 4, tc->t[k].state & rd32(c, it + 8)); }
static void tabsel_resume(Cpu *c, u64 rax) { Win32 *w = W; int ci = w->ncont - 1; int i = (int)w->cont[ci].data[0]; if (w->cont[ci].data[1] || !wnd_alive(i) || !g_wnd[i].cc) { w32_cont_finish(c, 0); return; }   /* TCN_SELCHANGE answered (or the control is gone) */
  TabCtl *tc = g_wnd[i].cc; if ((u32)rax) { tc->pending = -1; w32_cont_finish(c, 0); return; }   /* TCN_SELCHANGING: TRUE vetoes the change */
  tc->cur = tc->pending; tc->pending = -1; wnd_invalidate(i, 1); int p = g_wnd[i].parent; if (p < 0 || !wnd_alive(p)) { w32_cont_finish(c, 0); return; } w->cont[ci].data[1] = 1; nm_hdr(c, tc->nmbuf, i, (u32)-551); w32_guest_call(c, g_wnd[p].wndproc, HWND_OF(p), 0x4E, g_wnd[i].id, tc->nmbuf); }
static void s_NebulaTabProc(Cpu *c) { int i = wnd_of(ARG(0)); if (i < 0) { RET(0); return; } SUPER_ADOPT(i, BI_TAB); u32 msg = (u32)ARG(1); u64 wp = ARG(2), lp = ARG(3); Wnd *n = &g_wnd[i]; Win32 *w = W; TabCtl *tc = n->cc;
  if (!tc && msg != 0x02 && msg != 0x82) { tc = n->cc = emu_alloc(sizeof(TabCtl)); if (!tc) { RET(0); return; } e_memset(tc, 0, sizeof *tc); tc->cur = -1; tc->padx = 6; tc->pady = 3; tc->pending = -1; }
  switch (msg) {
    case 0x0F: tab_paint(c, i); return;
    case 0x14: RET(1); return;
    case 0x201: { tab_layout(w, i); int x = (int)(s16)(u16)lp, y = (int)(s16)(u16)(lp >> 16); int th = tab_h(w, n, tc); int bottom = (n->style & 0x2) != 0; int ch = wnd_client_h(i); if (bottom ? y < ch - th : y >= th) { RET(0); return; } int k = -1; for (int q = 0; q < tc->n; q++) if (x >= tc->t[q].x && x < tc->t[q].x + tc->t[q].w) k = q; if (k < 0 || k == tc->cur) { RET(0); return; } set_focus(c, i); tc->pending = k; w32_push_cont(c, CONT_TABSEL, (u64)i); int p = n->parent; if (p < 0 || !wnd_alive(p)) { tabsel_resume(c, 0); return; } if (!tc->nmbuf) tc->nmbuf = w32_heap_alloc(w, 64, 1); nm_hdr(c, tc->nmbuf, i, (u32)-552); w32_guest_call(c, g_wnd[p].wndproc, HWND_OF(p), 0x4E, n->id, tc->nmbuf); return; }
    case 0x100: { if (wp == 0x25 || wp == 0x27) { int k = tc->cur + (wp == 0x27 ? 1 : -1); if (k >= 0 && k < tc->n) { tc->pending = k; w32_push_cont(c, CONT_TABSEL, (u64)i); int p = n->parent; if (p < 0 || !wnd_alive(p)) { tabsel_resume(c, 0); return; } if (!tc->nmbuf) tc->nmbuf = w32_heap_alloc(w, 64, 1); nm_hdr(c, tc->nmbuf, i, (u32)-552); w32_guest_call(c, g_wnd[p].wndproc, HWND_OF(p), 0x4E, n->id, tc->nmbuf); return; } } RET(0); return; }

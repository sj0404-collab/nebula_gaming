/* ---------- common controls: status bar (msctls_statusbar32), toolbar (ToolbarWindow32), tab control (SysTabControl32) ----------
   Per-control state hangs off Wnd.cc; the procedures are shim slots like the other built-in classes (VCL superclasses them and
   routes messages through CallWindowProc). Notifications go to the parent through WM_COMMAND / WM_NOTIFY with continuations. */
#define CC_MAX 64
typedef struct { int n; int right[CC_MAX]; u32 style[CC_MAX]; char text[CC_MAX][128]; int simple; char stext[256]; int minh; } StatusBar;
typedef struct { int image; u32 id; u8 state, style; u64 data; int istr; char text[64]; int x, w, cx; } TbBtn;
typedef struct { int n; TbBtn b[CC_MAX]; u64 himl, himl_hot, himl_dis; int bw, bh; int structsize; int textrows; int nstr; char strs[CC_MAX][64]; u32 exstyle; int padx, pady; int hot, pressed; u64 nmbuf; int indent; } Toolbar;
typedef struct { int n; struct { char text[64]; int image; u64 lparam; u32 state; int x, w; } t[CC_MAX]; int cur; int padx, pady; u64 himl; int fixw, fixh; u64 nmbuf; int extra; int pending; } TabCtl;
static u64 cc_P(Cpu *c) { return PSZ_OF(c); }
static void nm_hdr(Cpu *c, u64 buf, int i, u32 code) { u64 P = cc_P(c); wrp(c, buf, HWND_OF(i)); wrp(c, buf + P, g_wnd[i].id); wr32(c, buf + 2 * P, code); }
static int cc_font_h(Win32 *w, Wnd *n) { int cw, fh; font_dims(w, n->font ? n->font : g_dlg_font, &cw, &fh); return fh; }
static GdiObj *cc_dc(Win32 *w, u64 hdc, Wnd *n) { GdiObj *d = gdi_get(w, hdc); if (d) { GdiObj *fo = gdi_get(w, n->font ? n->font : g_dlg_font); if (fo) d->font = n->font ? n->font : g_dlg_font; d->bk_mode = 1; } return d; }
static void cc_text(Surf *s, GdiObj *d, Win32 *w, int x, int y, const char *t, u32 col) { d->text_color = px2cr(col); draw_text(s, d, w, x, y, t, (int)e_strlen(t)); }

/* ===== status bar ===== */
static void status_paint(Cpu *c, int i) { Win32 *w = W; Wnd *n = &g_wnd[i]; StatusBar *sb = n->cc; u64 hdc = ctl_paint_begin(c, i); if (!hdc) { RET(0); return; } Surf s; if (dc_surf(c, hdc, &s) && sb) { GdiObj *d = cc_dc(w, hdc, n); int cw = wnd_client_w(i), ch = wnd_client_h(i); int fh = cc_font_h(w, n); fill_rect_px(&s, 0, 0, cw, ch, 0xf0f0f0); hline(&s, 0, cw - 1, 0, 0xd5d5d5);
    if (d) { if (sb->simple) cc_text(&s, d, w, 4, (ch - fh) / 2, sb->stext, 0x000000); else { int x = 0; for (int k = 0; k < sb->n; k++) { int r = sb->right[k] < 0 || k == sb->n - 1 ? cw : sb->right[k]; if (r > cw) r = cw; if (k > 0) { line_px(&s, x, 2, x, ch - 2, 0xa0a0a0); line_px(&s, x + 1, 2, x + 1, ch - 2, 0xffffff); } if (!(sb->style[k] & 0x1000)) { Surf part = s; int lim = r - 2; if (lim < part.w) part.w = lim; cc_text(&part, d, w, x + 4, (ch - fh) / 2, sb->text[k], 0x000000); } x = r; } } } }
  ctl_paint_end(c, i, hdc); RET(0); }
static void s_NebulaStatusProc(Cpu *c) { int i = wnd_of(ARG(0)); if (i < 0) { RET(0); return; } SUPER_ADOPT(i, BI_STATUS); u32 msg = (u32)ARG(1); u64 wp = ARG(2), lp = ARG(3); Wnd *n = &g_wnd[i]; Win32 *w = W; StatusBar *sb = n->cc;
  if (!sb && msg != 0x02 && msg != 0x82) { sb = n->cc = emu_alloc(sizeof(StatusBar)); if (!sb) { RET(0); return; } e_memset(sb, 0, sizeof *sb); sb->n = 1; sb->right[0] = -1; }
  switch (msg) {
    case 0x01: { /* the bar sizes itself along the bottom of the parent (CCS_BOTTOM default) */ int p = n->parent; int h = cc_font_h(w, n) + 8; if (p >= 0) { n->w = wnd_client_w(p); n->h = h; n->x = 0; n->y = wnd_client_h(p) - h; } RET(0); return; }
    case 0x0F: status_paint(c, i); return;
    case 0x14: RET(1); return;
    case 0x05: { /* WM_SIZE from the parent: follow its width */ int p = n->parent; if (p >= 0 && !(n->style & 0x3 /* CCS_TOP/NOMOVEY */)) { int h = n->h; n->w = wnd_client_w(p); n->y = wnd_client_h(p) - h; wnd_invalidate(i, 1); } RET(0); return; }
    case 0x404: { /* SB_SETPARTS */ int cnt = (int)wp; if (cnt < 1) cnt = 1; if (cnt > CC_MAX) cnt = CC_MAX; sb->n = cnt; for (int k = 0; k < cnt; k++) sb->right[k] = lp ? (int)(s32)rd32(c, lp + 4 * k) : -1; wnd_invalidate(i, 0); RET(1); return; }
    case 0x406: { /* SB_GETPARTS */ int cnt = (int)wp; if (cnt > sb->n) cnt = sb->n; for (int k = 0; k < cnt && lp; k++) wr32(c, lp + 4 * k, (u32)sb->right[k]); RET((u32)sb->n); return; }
    case 0x401: case 0x40B: { /* SB_SETTEXT A/W: wParam = part | SBT_* */ int part = (int)(wp & 0xff); u32 st = ((u32)wp & 0xff00) | ((u32)wp & 0x1000); if (part == 255) { text_in(c, lp, msg == 0x40B, sb->stext, sizeof sb->stext); } else { if (part >= CC_MAX) { RET(0); return; } sb->style[part] = st; if (st & 0x1000) sb->text[part][0] = 0; else text_in(c, lp, msg == 0x40B, sb->text[part], sizeof sb->text[part]); } wnd_invalidate(i, 0); RET(1); return; }
    case 0x402: case 0x40D: { /* SB_GETTEXT */ int part = (int)(wp & 0xff); const char *t = part == 255 ? sb->stext : part < CC_MAX ? sb->text[part] : ""; u32 len = msg == 0x40D ? utf8_u16len(t) : (u32)e_strlen(t); if (lp) text_out_cap(c, lp, t, 512, msg == 0x40D); RET(len | ((u64)(part < CC_MAX ? sb->style[part] : 0) << 16)); return; }
    case 0x403: case 0x40C: { int part = (int)(wp & 0xff); const char *t = part == 255 ? sb->stext : part < CC_MAX ? sb->text[part] : ""; RET((msg == 0x40C ? utf8_u16len(t) : (u32)e_strlen(t)) | ((u64)(part < CC_MAX ? sb->style[part] : 0) << 16)); return; }
    case 0x408: { sb->minh = (int)wp; int want = (int)wp + 4; if (want > n->h) { n->h = want; if (n->parent >= 0) n->y = wnd_client_h(n->parent) - n->h; } RET(0); return; }   /* SB_SETMINHEIGHT */
    case 0x409: { sb->simple = wp != 0; wnd_invalidate(i, 0); RET(1); return; }   /* SB_SIMPLE */
    case 0x40E: RET(sb->simple); return;
    case 0x40A: { /* SB_GETRECT */ int part = (int)wp; if (part < 0 || part >= sb->n || !lp) { RET(0); return; } int x = 0; for (int k = 0; k < part; k++) x = sb->right[k] < 0 ? wnd_client_w(i) : sb->right[k]; int r = sb->right[part] < 0 || part == sb->n - 1 ? wnd_client_w(i) : sb->right[part]; wr32(c, lp, (u32)x); wr32(c, lp + 4, 0); wr32(c, lp + 8, (u32)r); wr32(c, lp + 12, (u32)wnd_client_h(i)); RET(1); return; }
    case 0x407: { if (lp) { wr32(c, lp, 0); wr32(c, lp + 4, 2); wr32(c, lp + 8, 2); } RET(1); return; }   /* SB_GETBORDERS */
    case 0x40F: case 0x410: case 0x411: case 0x2001: case 0x2005: case 0x2007: case 0x200B: RET(1); return;   /* icons, tips, colours, unicode, version, theme */
    default: if (ctl_common(c, i, msg, wp, lp)) return; def_window_proc(c, i, msg, wp, lp); return; } }

/* ===== toolbar ===== */
static void tb_layout(Win32 *w, int i) { Wnd *n = &g_wnd[i]; Toolbar *tb = n->cc; int x = tb->padx + tb->indent; int list = (n->style & 0x1000) != 0; for (int k = 0; k < tb->n; k++) { TbBtn *b = &tb->b[k]; if (b->state & 8) { b->x = x; b->w = 0; continue; } int bw;
    if (b->style & 1) bw = b->image > 0 ? b->image : 8; else if (b->cx > 0) bw = b->cx; else { bw = tb->bw; if (b->text[0] && tb->textrows) { int tw = text_width(w, n->font ? n->font : g_dlg_font, b->text, (int)e_strlen(b->text)); if (list) bw = tb->bw + tw + 6; else if (tw + 8 > bw) bw = tw + 8; } if (b->style & 0x8) bw += 12; }
    b->x = x; b->w = bw; x += bw; } }
static int tb_hit(Toolbar *tb, int x, int y, int bh) { if (y < 0 || y >= bh + 2 * tb->pady) return -1; for (int k = 0; k < tb->n; k++) if (!(tb->b[k].state & 8) && !(tb->b[k].style & 1) && x >= tb->b[k].x && x < tb->b[k].x + tb->b[k].w) return k; return -1; }
static int tb_index_of(Toolbar *tb, u32 id) { for (int k = 0; k < tb->n; k++) if (tb->b[k].id == id && !(tb->b[k].style & 1)) return k; return -1; }
static void tb_paint(Cpu *c, int i) { Win32 *w = W; Wnd *n = &g_wnd[i]; Toolbar *tb = n->cc; u64 hdc = ctl_paint_begin(c, i); if (!hdc) { RET(0); return; } Surf s; if (dc_surf(c, hdc, &s) && tb) { GdiObj *d = cc_dc(w, hdc, n); int cw = wnd_client_w(i), ch = wnd_client_h(i); int fh = cc_font_h(w, n); tb_layout(w, i); fill_rect_px(&s, 0, 0, cw, ch, 0xf0f0f0); int flat = (n->style & 0x800) != 0; int list = (n->style & 0x1000) != 0;
    ImgList *il = iml_of(tb->himl), *ild = iml_of(tb->himl_dis), *ilh = iml_of(tb->himl_hot);
    for (int k = 0; k < tb->n; k++) { TbBtn *b = &tb->b[k]; if (b->state & 8) continue; int y0 = tb->pady, bh = tb->bh; if (b->style & 1) { int sx = b->x + b->w / 2; if (flat) { line_px(&s, sx, y0 + 2, sx, y0 + bh - 3, 0xa0a0a0); line_px(&s, sx + 1, y0 + 2, sx + 1, y0 + bh - 3, 0xffffff); } continue; }
      int en = (b->state & 4) != 0, chk = (b->state & 1) != 0, hot = tb->hot == k && en, pressed = (b->state & 2) || (tb->pressed == k && hot);
      if (pressed) { fill_rect_px(&s, b->x, y0, b->x + b->w, y0 + bh, 0xcce4f7); edge_rect(&s, b->x, y0, b->x + b->w, y0 + bh, 0x005499, 0x005499); } else if (chk) { fill_rect_px(&s, b->x, y0, b->x + b->w, y0 + bh, hot ? 0xd8e6f2 : 0xe6e6e6); edge_rect(&s, b->x, y0, b->x + b->w, y0 + bh, 0x7eb4ea, 0x7eb4ea); } else if (hot) { fill_rect_px(&s, b->x, y0, b->x + b->w, y0 + bh, 0xe5f1fb); edge_rect(&s, b->x, y0, b->x + b->w, y0 + bh, 0x7eb4ea, 0x7eb4ea); } else if (!flat) edge_rect(&s, b->x, y0, b->x + b->w, y0 + bh, 0xffffff, 0xa0a0a0);
      ImgList *use = !en && ild ? ild : hot && ilh ? ilh : il; int tx = b->x, iw = use ? use->cx : 0, ih = use ? use->cy : 0; int has_text = b->text[0] && tb->textrows;
      if (use && b->image >= 0 && b->image < use->n) { int ix = list || !has_text ? b->x + (list ? 4 : (b->w - (b->style & 0x8 ? 12 : 0) - iw) / 2) : b->x + (b->w - iw) / 2; int iy = list || !has_text ? y0 + (bh - ih) / 2 : y0 + 3; iml_draw(c, use, b->image, hdc, ix, iy, 0, 0, en || ild ? 0 : 0); if (!en && !ild) { /* dim a disabled glyph */ for (int yy = iy; yy < iy + ih && yy < s.h; yy++) if (yy >= s.y0) { u32 *row = srow(&s, yy); for (int xx = ix; xx < ix + iw && xx < s.w; xx++) if (xx >= s.x0) { u32 v = row[xx]; row[xx] = ((v >> 1) & 0x7f7f7f) + 0x787878; } } } tx = ix + iw; }
      if (has_text && d) { int tw = text_width(w, n->font ? n->font : g_dlg_font, b->text, (int)e_strlen(b->text)); int ty = list || !use ? y0 + (bh - fh) / 2 : y0 + bh - fh - 2; int txx = list ? tx + 4 : b->x + (b->w - (b->style & 0x8 ? 12 : 0) - tw) / 2; cc_text(&s, d, w, txx, ty, b->text, en ? 0x000000 : 0x6d6d6d); }
      if (b->style & 0x8) { int ax = b->x + b->w - 9, ay = y0 + bh / 2 - 1; for (int q = 0; q < 3; q++) hline(&s, ax - 2 + q, ax + 2 - q, ay + q, en ? 0x000000 : 0x6d6d6d); } } }
  ctl_paint_end(c, i, hdc); RET(0); }
/* TBBUTTON: x86 iBitmap@0 idCommand@4 fsState@8 fsStyle@9 dwData@12 iString@16 (20); x64 … dwData@16 iString@24 (32) */
static void tb_read_button(Cpu *c, Toolbar *tb, u64 p, TbBtn *b, int wide) { b->image = (int)(s32)rd32(c, p); b->id = rd32(c, p + 4); b->state = rd8(c, p + 8); b->style = rd8(c, p + 9); b->data = rdp(c, p + (c->mode32 ? 12 : 16)); u64 str = rdp(c, p + (c->mode32 ? 16 : 24)); b->text[0] = 0; b->istr = -1; b->cx = 0;
  if (str == (u64)(u32)-1 || str == ~0ull) { } else if (str >= 0x10000) text_in(c, str, wide, b->text, sizeof b->text); else if ((int)str >= 0 && (int)str < tb->nstr) { b->istr = (int)str; e_snprintf(b->text, sizeof b->text, "%s", tb->strs[(int)str]); } }
static void tb_write_button(Cpu *c, Toolbar *tb, u64 p, TbBtn *b) { (void)tb; wr32(c, p, (u32)b->image); wr32(c, p + 4, b->id); wr8(c, p + 8, b->state); wr8(c, p + 9, b->style); wrp(c, p + (c->mode32 ? 12 : 16), b->data); wrp(c, p + (c->mode32 ? 16 : 24), b->istr >= 0 ? (u64)(u32)b->istr : (u64)(u32)-1); }
static int tb_add_strings(Cpu *c, Toolbar *tb, u64 lp, int wide) { int first = tb->nstr; if (lp < 0x10000) return -1; /* a double-NUL terminated list */ u64 p = lp; for (int guard = 0; guard < CC_MAX && tb->nstr < CC_MAX; guard++) { char t[64]; if (wide) { if (!rd16(c, p)) break; wstr_to_utf8(c, p, t, sizeof t, -1); while (rd16(c, p)) p += 2; p += 2; } else { if (!rd8(c, p)) break; const char *s = rd_str(c, p, 64); e_snprintf(t, sizeof t, "%s", s ? s : ""); while (rd8(c, p)) p++; p++; } e_snprintf(tb->strs[tb->nstr++], 64, "%s", t); } return first; }
/* TBBUTTONINFO: x86 cbSize@0 dwMask@4 idCommand@8 iImage@12 fsState@16 fsStyle@17 cx@18 lParam@20 pszText@24 cchText@28; x64 … cx@18 lParam@24 pszText@32 cchText@40 */
static void tb_buttoninfo(Cpu *c, int i, Toolbar *tb, u64 idx_or_id, u64 bi, int set, int wide) { u32 mask = rd32(c, bi + 4); int k = (mask & 0x80000000u) ? (int)idx_or_id : tb_index_of(tb, (u32)idx_or_id); if (k < 0 || k >= tb->n) { RET((u64)(u32)-1); return; } TbBtn *b = &tb->b[k]; u64 lpo = c->mode32 ? 20 : 24, txo = c->mode32 ? 24 : 32, cho = c->mode32 ? 28 : 40;
  if (set) { if (mask & 0x20) b->id = rd32(c, bi + 8); if (mask & 0x1) b->image = (int)(s32)rd32(c, bi + 12); if (mask & 0x4) b->state = rd8(c, bi + 16); if (mask & 0x8) b->style = rd8(c, bi + 17); if (mask & 0x40) b->cx = rd16(c, bi + 18); if (mask & 0x10) b->data = rdp(c, bi + lpo); if (mask & 0x2) { u64 t = rdp(c, bi + txo); if (t) text_in(c, t, wide, b->text, sizeof b->text); } wnd_invalidate(i, 1); RET(1); return; }
  if (mask & 0x20) wr32(c, bi + 8, b->id); if (mask & 0x1) wr32(c, bi + 12, (u32)b->image); if (mask & 0x4) wr8(c, bi + 16, b->state); if (mask & 0x8) wr8(c, bi + 17, b->style); if (mask & 0x40) wr16(c, bi + 18, (u16)(b->w ? b->w : b->cx)); if (mask & 0x10) wrp(c, bi + lpo, b->data); if (mask & 0x2) { u64 t = rdp(c, bi + txo); u32 cch = rd32(c, bi + cho); if (t && cch) text_out_cap(c, t, b->text, cch, wide); } RET((u64)k); }
static void tb_rect(Cpu *c, int i, Toolbar *tb, int k, u64 r) { Win32 *w = W; tb_layout(w, i); TbBtn *b = &tb->b[k]; wr32(c, r, (u32)b->x); wr32(c, r + 4, (u32)tb->pady); wr32(c, r + 8, (u32)(b->x + b->w)); wr32(c, r + 12, (u32)(tb->pady + tb->bh)); }
static void tb_click(Cpu *c, int i, int k) { Win32 *w = W; Wnd *n = &g_wnd[i]; Toolbar *tb = n->cc; TbBtn *b = &tb->b[k]; if (!(b->state & 4)) { RET(0); return; }
  if (b->style & 2) { /* check / check-group */ if (b->style & 4) { for (int q = 0; q < tb->n; q++) if ((tb->b[q].style & 6) == 6 && q != k) tb->b[q].state &= ~1u; b->state |= 1; } else b->state ^= 1; }
  wnd_invalidate(i, 1); int p = n->parent; if (p < 0 || !wnd_alive(p)) { RET(0); return; }
  if (b->style & 0x88) { /* drop-down: TBN_DROPDOWN (NMTOOLBAR { hdr, iItem, tbButton, cchText, pszText, rcButton }) */ if (!tb->nmbuf) tb->nmbuf = w32_heap_alloc(w, 160, 1); u64 nm = tb->nmbuf; u64 P = cc_P(c); nm_hdr(c, nm, i, (u32)-710); wr32(c, nm + 3 * P, b->id); u64 rc = nm + 3 * P + 4 + (c->mode32 ? 20 : 36) + 4 + P; rc = (rc + 3) & ~3ull; wr32(c, rc, (u32)b->x); wr32(c, rc + 4, (u32)tb->pady); wr32(c, rc + 8, (u32)(b->x + b->w)); wr32(c, rc + 12, (u32)(tb->pady + tb->bh)); send_to(c, p, 0x4E, n->id, nm, CONT_RET_VAL_, 0); return; }
  send_to(c, p, 0x111, (u64)b->id, HWND_OF(i), CONT_RET_VAL_, 0); }
static void s_NebulaToolbarProc(Cpu *c) { int i = wnd_of(ARG(0)); if (i < 0) { RET(0); return; } SUPER_ADOPT(i, BI_TOOLBAR); u32 msg = (u32)ARG(1); u64 wp = ARG(2), lp = ARG(3); Wnd *n = &g_wnd[i]; Win32 *w = W; Toolbar *tb = n->cc;
  if (!tb && msg != 0x02 && msg != 0x82) { tb = n->cc = emu_alloc(sizeof(Toolbar)); if (!tb) { RET(0); return; } e_memset(tb, 0, sizeof *tb); tb->bw = 23; tb->bh = 22; tb->structsize = c->mode32 ? 20 : 32; tb->textrows = 1; tb->hot = -1; tb->pressed = -1; tb->padx = 0; tb->pady = 0; }
  switch (msg) {
    case 0x01: { /* default size: a row along the top of the parent */ int p = n->parent; if (p >= 0 && (!n->h || n->h < 4)) { n->w = wnd_client_w(p); n->h = tb->bh + 2; } RET(0); return; }
    case 0x0F: tb_paint(c, i); return;
    case 0x14: RET(1); return;
    case 0x200: { tb_layout(w, i); int k = tb_hit(tb, (int)(s16)(u16)lp, (int)(s16)(u16)(lp >> 16), tb->bh); if (k != tb->hot) { tb->hot = k; wnd_invalidate(i, 0); } RET(0); return; }
    case 0x2A3: { if (tb->hot >= 0) { tb->hot = -1; wnd_invalidate(i, 0); } RET(0); return; }   /* WM_MOUSELEAVE */
    case 0x201: { tb_layout(w, i); int k = tb_hit(tb, (int)(s16)(u16)lp, (int)(s16)(u16)(lp >> 16), tb->bh); tb->pressed = k; tb->hot = k; if (k >= 0) { g_capture = i; wnd_invalidate(i, 0); } RET(0); return; }
    case 0x202: { tb_layout(w, i); int k = tb_hit(tb, (int)(s16)(u16)lp, (int)(s16)(u16)(lp >> 16), tb->bh); int was = tb->pressed; tb->pressed = -1; if (g_capture == i) g_capture = -1; if (k >= 0 && k == was) { tb_click(c, i, k); return; } wnd_invalidate(i, 0); RET(0); return; }
    case 0x41E: tb->structsize = (int)wp; RET(0); return;                                                   /* TB_BUTTONSTRUCTSIZE */
    case 0x414: case 0x444: { /* TB_ADDBUTTONS A/W */ int cnt = (int)wp; u64 p = lp; int added = 0; for (int k = 0; k < cnt && tb->n < CC_MAX; k++, p += tb->structsize) { tb_read_button(c, tb, p, &tb->b[tb->n], msg == 0x444); tb->n++; added++; } tb_layout(w, i); wnd_invalidate(i, 1); RET(added > 0); return; }
    case 0x415: case 0x443: { /* TB_INSERTBUTTON */ int pos = (int)(s32)(u32)wp; if (pos < 0 || pos > tb->n) pos = tb->n; if (tb->n >= CC_MAX) { RET(0); return; } for (int k = tb->n; k > pos; k--) tb->b[k] = tb->b[k - 1]; tb->n++; tb_read_button(c, tb, lp, &tb->b[pos], msg == 0x443); tb_layout(w, i); wnd_invalidate(i, 1); RET(1); return; }
    case 0x416: { int k = (int)wp; if (k < 0 || k >= tb->n) { RET(0); return; } for (; k + 1 < tb->n; k++) tb->b[k] = tb->b[k + 1]; tb->n--; tb_layout(w, i); wnd_invalidate(i, 1); RET(1); return; }   /* TB_DELETEBUTTON */
    case 0x417: { int k = (int)wp; if (k < 0 || k >= tb->n || !lp) { RET(0); return; } tb_write_button(c, tb, lp, &tb->b[k]); RET(1); return; }   /* TB_GETBUTTON */
    case 0x418: RET((u64)tb->n); return;                                                                     /* TB_BUTTONCOUNT */
    case 0x419: RET((u64)(u32)tb_index_of(tb, (u32)wp)); return;                                             /* TB_COMMANDTOINDEX */

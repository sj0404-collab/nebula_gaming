    case 0x1302: RET(tc->himl); return; case 0x1303: { u64 old = tc->himl; tc->himl = lp; wnd_invalidate(i, 1); RET(old); return; }   /* TCM_GET/SETIMAGELIST */
    case 0x1304: RET((u64)tc->n); return;                                                                    /* TCM_GETITEMCOUNT */
    case 0x1305: case 0x133C: { int k = (int)wp; if (k < 0 || k >= tc->n || !lp) { RET(0); return; } tab_item_io(c, i, tc, k, lp, 0, msg == 0x133C); RET(1); return; }   /* TCM_GETITEM A/W */
    case 0x1306: case 0x133D: { int k = (int)wp; if (k < 0 || k >= tc->n || !lp) { RET(0); return; } tab_item_io(c, i, tc, k, lp, 1, msg == 0x133D); RET(1); return; }   /* TCM_SETITEM A/W */
    case 0x1307: case 0x133E: { /* TCM_INSERTITEM A/W */ int pos = (int)wp; if (pos < 0 || pos > tc->n) pos = tc->n; if (tc->n >= CC_MAX || !lp) { RET((u64)(u32)-1); return; } for (int k = tc->n; k > pos; k--) tc->t[k] = tc->t[k - 1]; e_memset(&tc->t[pos], 0, sizeof tc->t[pos]); tc->t[pos].image = -1; tc->n++; tab_item_io(c, i, tc, pos, lp, 1, msg == 0x133E); if (tc->cur < 0) tc->cur = 0; else if (pos <= tc->cur && tc->n > 1) tc->cur++; wnd_invalidate(i, 1); RET((u64)pos); return; }
    case 0x1308: { int k = (int)wp; if (k < 0 || k >= tc->n) { RET(0); return; } for (; k + 1 < tc->n; k++) tc->t[k] = tc->t[k + 1]; tc->n--; if (tc->cur >= tc->n) tc->cur = tc->n - 1; wnd_invalidate(i, 1); RET(1); return; }   /* TCM_DELETEITEM */
    case 0x1309: tc->n = 0; tc->cur = -1; wnd_invalidate(i, 1); RET(1); return;                            /* TCM_DELETEALLITEMS */
    case 0x130A: { int k = (int)wp; if (k < 0 || k >= tc->n || !lp) { RET(0); return; } tab_layout(w, i); int th = tab_h(w, n, tc); int bottom = (n->style & 0x2) != 0; int ch = wnd_client_h(i); wr32(c, lp, (u32)tc->t[k].x); wr32(c, lp + 4, (u32)(bottom ? ch - th : 0)); wr32(c, lp + 8, (u32)(tc->t[k].x + tc->t[k].w)); wr32(c, lp + 12, (u32)(bottom ? ch : th)); RET(1); return; }   /* TCM_GETITEMRECT */
    case 0x130B: RET((u64)(u32)tc->cur); return;                                                             /* TCM_GETCURSEL */
    case 0x130C: { int old = tc->cur; int k = (int)(s32)(u32)wp; if (k >= -1 && k < tc->n) { tc->cur = k; wnd_invalidate(i, 1); } RET((u64)(u32)old); return; }   /* TCM_SETCURSEL (no notification) */
    case 0x130D: { /* TCM_HITTEST: TCHITTESTINFO { POINT pt; UINT flags } */ if (!lp) { RET((u64)(u32)-1); return; } tab_layout(w, i); int x = (int)(s32)rd32(c, lp), y = (int)(s32)rd32(c, lp + 4); int th = tab_h(w, n, tc); int bottom = (n->style & 0x2) != 0; int ch = wnd_client_h(i); int k = -1; if (bottom ? y >= ch - th : y < th) for (int q = 0; q < tc->n; q++) if (x >= tc->t[q].x && x < tc->t[q].x + tc->t[q].w) k = q; wr32(c, lp + 8, k >= 0 ? 6 : 1); RET((u64)(u32)k); return; }
    case 0x130E: tc->extra = (int)wp; RET(1); return;                                                        /* TCM_SETITEMEXTRA */
    case 0x1328: { /* TCM_ADJUSTRECT: FALSE = window → display area, TRUE = display → window */ if (!lp) { RET(0); return; } int th = tab_h(w, n, tc) + 2; int bottom = (n->style & 0x2) != 0; int d = wp ? -1 : 1; s32 l = (s32)rd32(c, lp), t = (s32)rd32(c, lp + 4), r = (s32)rd32(c, lp + 8), b = (s32)rd32(c, lp + 12); l += 4 * d; r -= 4 * d; if (bottom) { t += 4 * d; b -= th * d; } else { t += th * d; b -= 4 * d; } wr32(c, lp, (u32)l); wr32(c, lp + 4, (u32)t); wr32(c, lp + 8, (u32)r); wr32(c, lp + 12, (u32)b); RET(0); return; }
    case 0x1329: { u32 old = (u32)tc->fixw | ((u32)tc->fixh << 16); tc->fixw = (int)(u16)lp; tc->fixh = (int)(u16)(lp >> 16); wnd_invalidate(i, 1); RET(old); return; }   /* TCM_SETITEMSIZE */
    case 0x132B: tc->padx = (int)(u16)lp; tc->pady = (int)(u16)(lp >> 16); wnd_invalidate(i, 1); RET(0); return;   /* TCM_SETPADDING */
    case 0x132C: RET(1); return;                                                                             /* TCM_GETROWCOUNT */
    case 0x132F: RET((u64)(u32)tc->cur); return; case 0x1330: { int k = (int)(s32)(u32)wp; if (k >= 0 && k < tc->n && k != tc->cur) { tc->cur = k; wnd_invalidate(i, 1); } RET(0); return; }   /* TCM_GETCURFOCUS / SETCURFOCUS */
    case 0x1331: { RET(0); return; } case 0x1332: RET(0); return; case 0x1333: { int k = (int)wp; if (k >= 0 && k < tc->n) { if (lp & 0xffff) tc->t[k].state |= 2; else tc->t[k].state &= ~2u; wnd_invalidate(i, 0); } RET(1); return; }
    case 0x1334: { u32 old = tc->extra; (void)old; RET(0); return; } case 0x1335: RET(0); return; case 0x132A: RET(0); return; case 0x132D: case 0x132E: case 0x2005: case 0x2007: case 0x200B: RET(0); return;
    default: if (ctl_common(c, i, msg, wp, lp)) return; def_window_proc(c, i, msg, wp, lp); return; } }


/* opengl.inc — opengl32.dll: WGL (pixel formats, contexts, SwapBuffers) + the generic OpenGL entry-point bridge.
 *
 * The emulated machine has no GPU driver of its own: every GL call is marshalled (arguments as raw 64-bit words, floats/doubles as
 * their bit patterns, guest pointers left as guest addresses) to the host, where src/lib/x64/gl.ts executes it on the device's
 * WebGL2 context (see gl_funcs.inc / gltable.ts, generated by tools/glgen.py — the id of an entry point is its index there).
 * The host reads/writes guest memory through the x64_gl_ptr / x64_gl_strlen exports (api.c). SwapBuffers reads the WebGL drawing
 * surface back into the window's client area of the software framebuffer, so GL windows compose with everything else like on Windows.
 * The native test runner has no WebGL: host_gl_init returns 0 there and wglCreateContext fails honestly (ERROR_INVALID_PIXEL_FORMAT).
 */
#include "gl_funcs.inc"

static int gl_find(const char *name) {   /* id of a GL entry point (binary search in the generated, sorted table) or -1 */
  int lo = 0, hi = GL_FN_COUNT - 1;
  while (lo <= hi) { int mid = (lo + hi) / 2; int r = e_strcmp(gl_fns[mid].name, name); if (r == 0) return mid; if (r < 0) lo = mid + 1; else hi = mid - 1; }
  return -1; }
const char *gl_sig_of(const char *name) { int i = gl_find(name); return i >= 0 ? gl_fns[i].sig : 0; }
const char *gl_name_of(int id) { return id >= 0 && id < (int)(sizeof gl_fns / sizeof gl_fns[0]) ? gl_fns[id].name : 0; }   /* host-side diagnostics (null driver) */   /* x86 marshalling (win32_x86.inc) */

/* ---- pixel formats: 1 = RGBA8 + depth 24 + stencil 8, double-buffered; 2 = the same single-buffered ---- */
#define GL_NFORMATS 2
#define GL_MAX_CTX 16
static struct { int used; u64 hdc; int wnd; int major, minor; u32 flags, profile; } g_glctx[GL_MAX_CTX];
static struct { int tid; int ctx; u64 hdc; } g_glcur[THREAD_MAX];   /* current context per thread */
static int g_gl_host = -1;         /* host_gl_init: -1 unknown, 0 none, 1 WebGL2 ready */
static int g_gl_swap_interval = 1;
static int g_gl_surf_w, g_gl_surf_h; static u32 *g_gl_present; static size_t g_gl_present_cap; static double g_gl_last_swap_ms;
static int g_gl_pf[MAX_WND];       /* pixel format set on each window (0 = none) */
static int gl_cur_slot(Win32 *w) { int tid = w->th[w->cur_th].tid; for (int i = 0; i < THREAD_MAX; i++) if (g_glcur[i].tid == tid) return i; for (int i = 0; i < THREAD_MAX; i++) if (!g_glcur[i].tid) { g_glcur[i].tid = tid; g_glcur[i].ctx = 0; g_glcur[i].hdc = 0; return i; } return 0; }
static int gl_dc_wnd(Win32 *w, u64 hdc) { GdiObj *dc = gdi_get(w, hdc); if (!dc || dc->kind != K_DC) return -1; return dc->wnd > 0 ? dc->wnd - 1 : (hdc == window_dc || dc->wnd < 0 ? 0 : -1); }
static void gl_describe_pf(Cpu *c, int fmt, u64 pfd) {
  u8 *p = mem_ptr(c->mem, pfd, 40, 1); if (!p) return; e_memset(p, 0, 40);
  wr16(c, pfd, 40); wr16(c, pfd + 2, 1); wr32(c, pfd + 4, 0x4 | 0x20 | (fmt == 1 ? 0x1 : 0) | 0x200 /* DRAW_TO_WINDOW | SUPPORT_OPENGL | DOUBLEBUFFER | SWAP_COPY */);
  wr8(c, pfd + 8, 0); wr8(c, pfd + 9, 32); wr8(c, pfd + 10, 8); wr8(c, pfd + 11, 16); wr8(c, pfd + 12, 8); wr8(c, pfd + 13, 8); wr8(c, pfd + 14, 8); wr8(c, pfd + 15, 0); wr8(c, pfd + 16, 8); wr8(c, pfd + 17, 24);
  wr8(c, pfd + 23, 24); wr8(c, pfd + 24, 8); wr8(c, pfd + 26, 0); }
static void s_DescribePixelFormat(Cpu *c) { int fmt = (int)(s32)ARG(1); if (ARG(3) && (u32)ARG(2) >= 40 && fmt >= 1 && fmt <= GL_NFORMATS) gl_describe_pf(c, fmt, ARG(3)); RET(fmt >= 0 && fmt <= GL_NFORMATS ? GL_NFORMATS : 0); }
static void s_ChoosePixelFormat(Cpu *c) { u64 pfd = ARG(1); if (!pfd) { W->last_error = 87; RET(0); return; } u32 flags = rd32(c, pfd + 4); RET((flags & 0x1) || !(flags & 0x20) ? 1 : 2); }   /* double-buffered unless explicitly single */
static void s_SetPixelFormat(Cpu *c) { int wnd = gl_dc_wnd(W, ARG(0)); int fmt = (int)(s32)ARG(1); if (wnd < 0 || fmt < 1 || fmt > GL_NFORMATS) { W->last_error = 2000; RET(0); return; } if (g_gl_pf[wnd] && g_gl_pf[wnd] != fmt) { W->last_error = 2000; RET(0); return; } g_gl_pf[wnd] = fmt; RET(1); }   /* a window's format is set once, as on Windows */
static void s_GetPixelFormat(Cpu *c) { int wnd = gl_dc_wnd(W, ARG(0)); RET(wnd >= 0 ? g_gl_pf[wnd] : 0); }
static int gl_host_ok(Win32 *w, int wnd) {
  int cw = wnd >= 0 ? wnd_client_w(wnd) : w->screen_w, ch = wnd >= 0 ? wnd_client_h(wnd) : w->screen_h; if (cw < 1) cw = 1; if (ch < 1) ch = 1;
  if (g_gl_host == 0) return 0;
  if (g_gl_host < 0 || cw != g_gl_surf_w || ch != g_gl_surf_h) { g_gl_host = host_gl_init(cw, ch) ? 1 : 0; if (g_gl_host) { g_gl_surf_w = cw; g_gl_surf_h = ch; } }
  return g_gl_host; }
/* ---- contexts ---- */
static u64 gl_ctx_handle(int i) { return 0x10001ull + (u64)i * 0x10; }
static int gl_ctx_of(u64 h) { if (h < 0x10001ull || (h - 0x10001ull) % 0x10) return -1; u64 i = (h - 0x10001ull) / 0x10; return i < GL_MAX_CTX && g_glctx[i].used ? (int)i : -1; }
static u64 gl_create_context(Cpu *c, u64 hdc, int major, int minor, u32 flags, u32 profile) {
  Win32 *w = W; int wnd = gl_dc_wnd(w, hdc); if (wnd < 0 || !g_gl_pf[wnd]) { w->last_error = 2000; return 0; }   /* ERROR_INVALID_PIXEL_FORMAT: SetPixelFormat first */
  if (!gl_host_ok(w, wnd)) { w32_report(w, "OpenGL: this host has no WebGL2 — wglCreateContext fails (ERROR_INVALID_PIXEL_FORMAT)"); w->last_error = 2000; return 0; }
  for (int i = 0; i < GL_MAX_CTX; i++) if (!g_glctx[i].used) { g_glctx[i].used = 1; g_glctx[i].hdc = hdc; g_glctx[i].wnd = wnd; g_glctx[i].major = major; g_glctx[i].minor = minor; g_glctx[i].flags = flags; g_glctx[i].profile = profile;
    e_log("[gl] context %d created for window %d (%dx%d), requested GL %d.%d flags %x profile %x\n", i, wnd, g_gl_surf_w, g_gl_surf_h, major, minor, flags, profile); return gl_ctx_handle(i); }
  w->last_error = 8; return 0; }
static void s_wglCreateContext(Cpu *c) { RET(gl_create_context(c, ARG(0), 1, 0, 0, 0)); }
static void s_wglCreateLayerContext(Cpu *c) { if ((int)(s32)ARG(1) != 0) { W->last_error = 87; RET(0); return; } RET(gl_create_context(c, ARG(0), 1, 0, 0, 0)); }
/* WGL_ARB_create_context: honours the version request up to 3.3 (what the WebGL2 bridge offers); higher versions fail with ERROR_INVALID_VERSION_ARB */
static void s_wglCreateContextAttribsARB(Cpu *c) {
  u64 at = ARG(2); int major = 1, minor = 0; u32 flags = 0, profile = 0;
  for (int k = 0; at && k < 32; k++) { u32 key = rd32(c, at + 8ull * k); if (!key) break; u32 val = rd32(c, at + 8ull * k + 4);
    if (key == 0x2091) major = (int)val; else if (key == 0x2092) minor = (int)val; else if (key == 0x2094) flags = val; else if (key == 0x9126) profile = val; else if (key == 0x2093) { /* layer plane */ } else { W->last_error = 0x2096; RET(0); return; } }   /* ERROR_INVALID_ATTRIBUTE? unknown attribute → fail */
  if (major > 3 || (major == 3 && minor > 3)) { W->last_error = 0x2095; RET(0); return; }   /* ERROR_INVALID_VERSION_ARB */
  if (profile && profile != 1 && profile != 2) { W->last_error = 0x2096; RET(0); return; }   /* ERROR_INVALID_PROFILE_ARB */
  RET(gl_create_context(c, ARG(0), major, minor, flags, profile)); }
static void s_wglDeleteContext(Cpu *c) { int i = gl_ctx_of(ARG(0)); if (i < 0) { W->last_error = 6; RET(0); return; } for (int k = 0; k < THREAD_MAX; k++) if (g_glcur[k].tid && g_glcur[k].ctx == i + 1) { g_glcur[k].ctx = 0; g_glcur[k].hdc = 0; } g_glctx[i].used = 0; RET(1); }
static void s_wglMakeCurrent(Cpu *c) {
  Win32 *w = W; int s = gl_cur_slot(w);
  if (!ARG(1)) { g_glcur[s].ctx = 0; g_glcur[s].hdc = 0; RET(1); return; }
  int i = gl_ctx_of(ARG(1)); if (i < 0) { w->last_error = 6; RET(0); return; }
  int wnd = gl_dc_wnd(w, ARG(0)); if (wnd < 0) { w->last_error = 2000; RET(0); return; }
  g_glctx[i].hdc = ARG(0); g_glctx[i].wnd = wnd; g_glcur[s].ctx = i + 1; g_glcur[s].hdc = ARG(0); gl_host_ok(w, wnd); RET(1); }
static void s_wglMakeContextCurrentARB(Cpu *c) { c->r[RDX] = ARG(2); s_wglMakeCurrent(c); }   /* (draw dc, read dc, ctx): one surface here */
static void s_wglGetCurrentContext(Cpu *c) { int s = gl_cur_slot(W); RET(g_glcur[s].ctx ? gl_ctx_handle(g_glcur[s].ctx - 1) : 0); }
static void s_wglGetCurrentDC(Cpu *c) { int s = gl_cur_slot(W); RET(g_glcur[s].hdc); }
static void s_wglGetCurrentReadDCARB(Cpu *c) { s_wglGetCurrentDC(c); }
static void s_wglShareLists(Cpu *c) { RET(gl_ctx_of(ARG(0)) >= 0 && gl_ctx_of(ARG(1)) >= 0); }   /* all contexts share one WebGL2 object space */
static void s_wglCopyContext(Cpu *c) { RET(gl_ctx_of(ARG(0)) >= 0 && gl_ctx_of(ARG(1)) >= 0); }
static void s_wglSwapIntervalEXT(Cpu *c) { int v = (int)(s32)ARG(0); if (v < 0) v = -v; g_gl_swap_interval = v > 4 ? 4 : v; RET(1); }
static void s_wglGetSwapIntervalEXT(Cpu *c) { RET(g_gl_swap_interval); }
static const char *GL_WGL_EXTENSIONS = "WGL_ARB_extensions_string WGL_EXT_extensions_string WGL_ARB_create_context WGL_ARB_create_context_profile WGL_ARB_pixel_format WGL_ARB_make_current_read WGL_EXT_swap_control";
static u64 g_gl_extstr;
static void s_wglGetExtensionsStringARB(Cpu *c) { if (!g_gl_extstr) g_gl_extstr = w32_guest_strdup(W, GL_WGL_EXTENSIONS); RET(g_gl_extstr); }
static void s_wglGetExtensionsStringEXT(Cpu *c) { s_wglGetExtensionsStringARB(c); }
/* WGL_ARB_pixel_format */
static int gl_pf_attrib(int fmt, u32 key, int *out) {
  switch (key) {
    case 0x2000: *out = GL_NFORMATS; return 1; case 0x2001: *out = 1; return 1; case 0x2002: *out = 0; return 1; case 0x2003: *out = 0x2027; return 1;   /* FULL_ACCELERATION */
    case 0x2004: case 0x2005: case 0x2006: case 0x2008: case 0x2009: case 0x200A: case 0x200B: case 0x200C: case 0x200D: case 0x200E: case 0x200F: *out = 0; return 1;
    case 0x2007: *out = 0x2029; return 1;   /* SWAP_COPY */
    case 0x2010: *out = 1; return 1; case 0x2011: *out = fmt == 1; return 1; case 0x2012: *out = 0; return 1; case 0x2013: *out = 0x202B; return 1;   /* TYPE_RGBA */
    case 0x2014: *out = 32; return 1; case 0x2015: *out = 8; return 1; case 0x2016: *out = 16; return 1; case 0x2017: *out = 8; return 1; case 0x2018: *out = 8; return 1; case 0x2019: *out = 8; return 1; case 0x201A: *out = 0; return 1;
    case 0x201B: *out = 8; return 1; case 0x201C: *out = 24; return 1; case 0x201D: case 0x201E: case 0x201F: case 0x2020: case 0x2021: *out = 0; return 1;
    case 0x2022: *out = 24; return 1; case 0x2023: *out = 8; return 1; case 0x2024: *out = 0; return 1;
    case 0x2041: case 0x2042: *out = 0; return 1;   /* no multisampled formats */
    case 0x20A9: *out = 0; return 1;                /* not sRGB-capable */
    default: return 0; } }
static void s_wglGetPixelFormatAttribivARB(Cpu *c) {
  int fmt = (int)(s32)ARG(1); u32 n = (u32)ARG(3); u64 keys = ARG(4), vals = ARG(5); if (fmt < 0 || fmt > GL_NFORMATS || !keys || !vals) { W->last_error = 87; RET(0); return; }
  for (u32 k = 0; k < n; k++) { int v = 0; u32 key = rd32(c, keys + 4ull * k); if (!gl_pf_attrib(fmt ? fmt : 1, key, &v)) { e_log("[gl] wglGetPixelFormatAttribivARB: unknown attribute 0x%x\n", key); W->last_error = 87; RET(0); return; } wr32(c, vals + 4ull * k, (u32)v); }
  RET(1); }
static void s_wglGetPixelFormatAttribfvARB(Cpu *c) {
  int fmt = (int)(s32)ARG(1); u32 n = (u32)ARG(3); u64 keys = ARG(4), vals = ARG(5); if (fmt < 0 || fmt > GL_NFORMATS || !keys || !vals) { W->last_error = 87; RET(0); return; }
  for (u32 k = 0; k < n; k++) { int v = 0; u32 key = rd32(c, keys + 4ull * k); if (!gl_pf_attrib(fmt ? fmt : 1, key, &v)) { W->last_error = 87; RET(0); return; } float f = (float)v; u32 b; e_memcpy(&b, &f, 4); wr32(c, vals + 4ull * k, b); }
  RET(1); }
static void s_wglChoosePixelFormatARB(Cpu *c) {
  u64 ia = ARG(1), outf = ARG(4), outn = ARG(5); u32 maxf = (u32)ARG(3); if (!outf || !outn || !maxf) { W->last_error = 87; RET(0); return; }
  int ok[GL_NFORMATS + 1] = { 0, 1, 1 };
  for (int k = 0; ia && k < 64; k++) { u32 key = rd32(c, ia + 8ull * k); if (!key) break; int want = (int)(s32)rd32(c, ia + 8ull * k + 4);
    for (int f = 1; f <= GL_NFORMATS; f++) { int have = 0; if (!gl_pf_attrib(f, key, &have)) { ok[f] = 0; continue; }
      switch (key) { case 0x2014: case 0x2015: case 0x2017: case 0x2019: case 0x201B: case 0x2022: case 0x2023: case 0x2041: case 0x2042: case 0x201D: case 0x2024: if (have < want) ok[f] = 0; break;   /* minimums */
        case 0x2011: case 0x2001: case 0x2010: case 0x2003: case 0x2013: case 0x2007: case 0x2012: case 0x2002: case 0x200F: case 0x20A9: if (want && have != want) ok[f] = 0; break; default: break; } } }
  u32 n = 0; for (int f = 1; f <= GL_NFORMATS && n < maxf; f++) if (ok[f]) wr32(c, outf + 4ull * n++, (u32)f);
  wr32(c, outn, n); RET(1); }
/* ---- SwapBuffers: WebGL surface → window client area; with a swap interval the call paces the loop like vsync (16.7 ms per frame) ---- */
static void gl_present_window(Win32 *w, int wnd) {
  if (!w->screen || g_gl_host != 1) return; int cw = g_gl_surf_w, ch = g_gl_surf_h; size_t need = (size_t)cw * ch;
  if (need > g_gl_present_cap) { if (g_gl_present) emu_free(g_gl_present); g_gl_present = emu_alloc(need * 4); g_gl_present_cap = g_gl_present ? need : 0; }
  if (!g_gl_present) return; host_gl_present(g_gl_present, cw, ch);
  int ox = 0, oy = 0; if (wnd >= 0) wnd_client_origin(wnd, &ox, &oy);
  int x0 = ox < 0 ? -ox : 0, y0 = oy < 0 ? -oy : 0, x1 = cw, y1 = ch; if (ox + x1 > w->screen_w) x1 = w->screen_w - ox; if (oy + y1 > w->screen_h) y1 = w->screen_h - oy;
  for (int y = y0; y < y1; y++) e_memcpy(w->screen + (size_t)(oy + y) * w->screen_w + ox + x0, g_gl_present + (size_t)y * cw + x0, (size_t)(x1 - x0) * 4);
  w->dirty = 1; w->blits_since_yield++; }
static void s_SwapBuffers(Cpu *c) {
  Win32 *w = W; int wnd = gl_dc_wnd(w, ARG(0)); if (wnd < 0) { w->last_error = 6; RET(0); return; }
  double now = host_now_ms();
  if (!w->sleeping) { gl_host_ok(w, wnd); gl_present_window(w, wnd);
    double period = g_gl_swap_interval ? 16.6667 * g_gl_swap_interval : 0, until = g_gl_last_swap_ms + period; if (until < now) until = now; g_gl_last_swap_ms = until;
    if (period > 0 && until > now + 0.5) { w->sleeping = 1; w->sleep_until_ms = until; w->block = BLOCK_SLEEP; w32_retry_yield(c); return; }
    RET(1); return; }
  if (now >= w->sleep_until_ms) { w->sleeping = 0; RET(1); return; }
  w->block = BLOCK_SLEEP; w32_retry_yield(c); }
static void s_wglSwapBuffers(Cpu *c) { s_SwapBuffers(c); }
static void s_wglSwapLayerBuffers(Cpu *c) { s_SwapBuffers(c); }
static void s_wglSwapMultipleBuffers(Cpu *c) { u32 n = (u32)ARG(0); u64 p = ARG(1); for (u32 k = 0; k < n && k < 1; k++) { c->r[RCX] = rdp(c, p + k * (c->mode32 ? 8 : 16)); s_SwapBuffers(c); } }

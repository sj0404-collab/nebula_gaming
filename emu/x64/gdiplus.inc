  while (pos < raw) { size_t n = raw - pos; if (n > 65535) n = 65535; z[zp++] = pos + n >= raw ? 1 : 0; z[zp++] = (u8)n; z[zp++] = (u8)(n >> 8); z[zp++] = (u8)~n; z[zp++] = (u8)(~n >> 8); e_memcpy(z + zp, rawb + pos, n); zp += n; pos += n; }
  gp_be32(z + zp, b << 16 | a); zp += 4; gp_be32(p + 8 + zp, gp_crc(p + 4, 4 + zp, 0)); p += 12 + zp;
  gp_be32(p, 0); e_memcpy(p + 4, "IEND", 4); gp_be32(p + 8, gp_crc(p + 4, 4, 0)); p += 12; emu_free(rawb); *out_len = (size_t)(p - out); return out; }
static u8 *gp_bmp_encode(const u32 *px, int bw, int bh, int alpha, size_t *out_len) { int bpp = alpha ? 32 : 24; size_t stride = (((size_t)bw * bpp + 31) / 32) * 4, total = 54 + stride * bh; u8 *o = emu_alloc(total); e_memset(o, 0, total); o[0] = 'B'; o[1] = 'M'; u32 v = (u32)total; e_memcpy(o + 2, &v, 4); v = 54; e_memcpy(o + 10, &v, 4); v = 40; e_memcpy(o + 14, &v, 4); e_memcpy(o + 18, &bw, 4); e_memcpy(o + 22, &bh, 4); o[26] = 1; o[28] = (u8)bpp; v = (u32)(stride * bh); e_memcpy(o + 34, &v, 4); v = 2835; e_memcpy(o + 38, &v, 4); e_memcpy(o + 42, &v, 4);
  for (int y = 0; y < bh; y++) { u8 *d = o + 54 + (size_t)(bh - 1 - y) * stride; for (int x = 0; x < bw; x++) { u32 p = px[(size_t)y * bw + x]; if (alpha) e_memcpy(d + 4 * x, &p, 4); else { d[3 * x] = (u8)p; d[3 * x + 1] = (u8)(p >> 8); d[3 * x + 2] = (u8)(p >> 16); } } } *out_len = total; return o; }
/* encoder CLSIDs: BMP {557cf400-1a04-11d3-9a73-0000f81ef32e}, JPEG ...401, GIF ...402, TIFF ...405, PNG ...406 */
static int gp_encoder_kind(Cpu *c, u64 clsid) { const u8 *g = clsid ? mem_ptr(c->mem, clsid, 16, 0) : 0; if (!g) return 0; u32 d1; e_memcpy(&d1, g, 4); if ((d1 & 0xfffffff0u) != 0x557cf400u) return 0; return (int)(d1 & 0xf) + 1; /* 1 bmp 2 jpeg 3 gif 6 tiff 7 png */ }
static void s_GdipSaveImageToFile(Cpu *c) { GpObj *img = gp_of(ARG(0), GP_IMAGE); if (!img || !ARG(1)) GP_RET(GpInvalidParameter); char path[520]; wstr_to_utf8(c, ARG(1), path, sizeof path, -1); int kind = gp_encoder_kind(c, ARG(2)); u32 *px = gp_image_px(c, img); if (!px) GP_RET(GpGenericError); size_t n; u8 *data;
  if (kind == 1) data = gp_bmp_encode(px, img->bw, img->bh, img->has_alpha, &n); else { if (kind != 7 && kind != 0) { static int once; if (!once++) e_log("[gdip] SaveImageToFile: only the PNG and BMP encoders exist — %s is written as PNG\n", kind == 2 ? "JPEG" : kind == 3 ? "GIF" : "TIFF"); } data = gp_png_encode(px, img->bw, img->bh, img->has_alpha, &n); }
  int fd = vfs_open(path, 2, 2 /* CREATE_ALWAYS */, 0); if (fd < 0) { emu_free(data); GP_RET(GpWin32Error); } s64 wr = vfs_write(fd, data, n); vfs_close(fd); emu_free(data); GP_RET(wr == (s64)n ? GpOk : GpWin32Error); }
static void s_GdipSaveImageToStream(Cpu *c) { GpObj *img = gp_of(ARG(0), GP_IMAGE); if (!img || !ARG(1)) GP_RET(GpInvalidParameter); int kind = gp_encoder_kind(c, ARG(2)); u32 *px = gp_image_px(c, img); if (!px) GP_RET(GpGenericError); size_t n; u8 *data = kind == 1 ? gp_bmp_encode(px, img->bw, img->bh, img->has_alpha, &n) : gp_png_encode(px, img->bw, img->bh, img->has_alpha, &n);
  WObj *own = wobj_of(c, ARG(1), WK_STREAM); if (own) { wic_stream_append(own, data, n); emu_free(data); GP_RET(GpOk); }
  /* a foreign IStream: one Write call with the whole buffer (CONT_RET_VAL returns Ok to the caller) */ u64 buf = w32_heap_alloc(W, n + 8, 0); if (!buf) { emu_free(data); GP_RET(GpOutOfMemory); } u8 *d = mem_ptr(c->mem, buf, n, 1); if (d) e_memcpy(d, data, n); emu_free(data); u64 P = PSZ_OF(c); u64 vt = rdp(c, ARG(1)), fn = rdp(c, vt + 4 * P); w32_push_cont(c, CONT_RET_VAL, 0); w32_guest_call(c, fn, ARG(1), buf, n, buf + n); }

static int gp_line_w(Cpu *c, GdiObj *f, u64 str, int start, int len) { int w = 0; for (int k = 0; k < len; k++) w += fnt_cp_adv(f, rd16(c, str + 2 * (start + k))); return w; }
static void gp_text(Cpu *c, GpObj *g, u64 str, int len, GpObj *font, GpObj *fmt, GpObj *brush, float lx, float ly, float lw, float lh) { Win32 *w = W; GdiObj *dc = gdi_get(w, g->hdc); if (!dc) return;
  float px = gp_font_px(font, g->sy); GdiObj *f = gp_gdi_font(w, font, px); if (!f) return; int h = f->font_h; u64 old_font = dc->font, hf = f->handle; dc->font = hf; u32 old_tc = dc->text_color; int old_bk = dc->bk_mode; u32 argb = brush ? brush->argb : 0xff000000u; dc->text_color = (argb & 0xff00) | (argb >> 16 & 0xff) | (argb & 0xff) << 16; dc->bk_mode = 1;
  int n = len < 0 ? 0 : len; if (len < 0) { for (n = 0; n < 4000 && rd16(c, str + 2 * n); n++) { } }
  int nowrap = fmt && (fmt->flags & 0x1000); int st[256], ln[256]; int nl = gp_lines(c, f, str, n, lw * g->sx, nowrap, st, ln, 256);
  float y = ly * g->sy + g->ty; if (fmt && lh > 0) { if (fmt->line_align == 1) y += (lh * g->sy - nl * h) / 2; else if (fmt->line_align == 2) y += lh * g->sy - nl * h; }
  for (int line = 0; line < nl; line++) { int lwpx = gp_line_w(c, f, str, st[line], ln[line]); float x = lx * g->sx + g->tx; if (fmt && lw > 0) { if (fmt->align == 1) x += (lw * g->sx - lwpx) / 2; else if (fmt->align == 2) x += lw * g->sx - lwpx; }
    if (lh > 0 && !(fmt && (fmt->flags & 0x4000)) && line * h >= lh * g->sy + 1) break;   /* clipped to the layout rectangle unless NoClip */
    text_out(c, g->hdc, (int)(x + 0.5f), (int)(y + line * h + 0.5f), str + 2 * st[line], ln[line], 1); }
  dc->font = old_font; dc->text_color = old_tc; dc->bk_mode = old_bk; f->kind = 0; mark_screen(w, g->hdc); }
static void gp_measure(Cpu *c, GpObj *g, u64 str, int len, GpObj *font, GpObj *fmt, float lw, float lh, float *ow, float *oh, int *lines, int *cps) { Win32 *w = W; float px = gp_font_px(font, 1.0f); GdiObj *f = gp_gdi_font(w, font, px); if (!f) { *ow = *oh = 0; if (lines) *lines = 0; if (cps) *cps = 0; return; } int h = f->font_h;
  int n = len < 0 ? 0 : len; if (len < 0) { for (n = 0; n < 4000 && rd16(c, str + 2 * n); n++) { } } int nowrap = fmt && (fmt->flags & 0x1000); int st[256], ln[256]; int nl = gp_lines(c, f, str, n, lw, nowrap, st, ln, 256);

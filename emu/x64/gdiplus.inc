static void gp_codec_info(Cpu *c, u64 p, u64 strs, int png) { u64 P = PSZ_OF(c); static const u8 clsid_bmp[16] = { 0x00, 0xf4, 0x7c, 0x55, 0x04, 0x1a, 0xd3, 0x11, 0x9a, 0x73, 0x00, 0x00, 0xf8, 0x1e, 0xf3, 0x2e }, clsid_png[16] = { 0x06, 0xf4, 0x7c, 0x55, 0x04, 0x1a, 0xd3, 0x11, 0x9a, 0x73, 0x00, 0x00, 0xf8, 0x1e, 0xf3, 0x2e };
  static const u8 fmt_bmp[16] = { 0xab, 0x3c, 0x6b, 0xb9, 0x28, 0x07, 0xd3, 0x11, 0x9d, 0x7b, 0x00, 0x00, 0xf8, 0x1e, 0xf3, 0x2e }, fmt_png[16] = { 0xaf, 0x3c, 0x6b, 0xb9, 0x28, 0x07, 0xd3, 0x11, 0x9d, 0x7b, 0x00, 0x00, 0xf8, 0x1e, 0xf3, 0x2e };
  u8 *d = mem_ptr(c->mem, p, 32, 1); if (!d) return; e_memcpy(d, png ? clsid_png : clsid_bmp, 16); e_memcpy(d + 16, png ? fmt_png : fmt_bmp, 16);
  const char *s[5] = { png ? "Built-in PNG Codec" : "Built-in BMP Codec", "gdiplus.dll", png ? "PNG" : "BMP", png ? "*.PNG" : "*.BMP", png ? "image/png" : "image/bmp" }; u64 q = strs; for (int i = 0; i < 5; i++) { wrp(c, p + 32 + i * P, q); for (const char *t = s[i]; ; t++) { wr16(c, q, (u8)*t); q += 2; if (!*t) break; } }
  u64 f = p + 32 + 5 * P; wr32(c, f, 0x1 | 0x2 | 0x10); /* Encoder | Decoder | Builtin */ wr32(c, f + 4, 1); wr32(c, f + 8, 1); wr32(c, f + 12, png ? 8 : 2); wrp(c, f + 16, q); wrp(c, f + 16 + P, q + 8); u8 *sg = mem_ptr(c->mem, q, 16, 1); if (sg) { if (png) { static const u8 ps[8] = { 0x89, 'P', 'N', 'G', 13, 10, 26, 10 }; e_memcpy(sg, ps, 8); e_memset(sg + 8, 0xff, 8); } else { sg[0] = 'B'; sg[1] = 'M'; sg[2] = sg[3] = 0xff; } } }

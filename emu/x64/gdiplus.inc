/* gdiplus.inc — GDI+ flat API (gdiplus.dll) on top of the GDI objects of gdi.c.
   Images are 32-bpp BGRA GDI bitmaps in guest memory (so LockBits can hand the bits straight to the program); a Graphics is a
   GDI DC (the window / printer DC the program gave us, or a memory DC with the image selected) so clipping, origins and text
   go through the same code as GDI. Decoders: the PNG / BMP / ICO decoders of win32_wic.inc; encoder: PNG (stored deflate) and BMP.
   Alpha is real: DrawImage composites non-premultiplied ARGB over the target, brushes carry alpha, colour matrices and
   colour keys of ImageAttributes are applied. Status codes are GDI+'s (Ok 0, GenericError 1, InvalidParameter 2,
   OutOfMemory 3, NotImplemented 6, Win32Error 7, WrongState 8, FileNotFound 10, UnknownImageFormat 13, PropertyNotFound 19). */
enum { GP_FREE, GP_GRAPHICS, GP_IMAGE, GP_BRUSH, GP_PEN, GP_PATH, GP_IMGATTR, GP_FONT, GP_FAMILY, GP_STRFMT, GP_REGION, GP_MATRIX };
enum { GpOk = 0, GpGenericError = 1, GpInvalidParameter = 2, GpOutOfMemory = 3, GpNotImplemented = 6, GpWin32Error = 7, GpWrongState = 8, GpFileNotFound = 10, GpUnknownImageFormat = 13, GpFontFamilyNotFound = 14, GpPropertyNotFound = 19 };
#define GP_MAX 4096
#define GP_BASE 0x7D100000ull
#define GP_PATH_MAX 4096
typedef struct { int kind; u32 pid;
  /* graphics */ u64 hdc; int own_dc; int target; int interp, smoothing, compositing, pixoff, texthint, unit; float tx, ty, sx, sy; int clip_on; int cl, ct, cr, cb;
  /* image */ u64 hbm; int bw, bh; int has_alpha; u32 pixfmt; u64 lock_buf; int lock_fmt, lock_x, lock_y, lock_w, lock_h, lock_stride, lock_mode; int lock_direct; int frames;
  /* brush / pen */ int brush_kind; u32 argb, argb2; float width; int grad_mode; float gx0, gy0, gx1, gy1; int dash;
  /* path */ int npts, fillmode, figure_open; float *pts; u8 *types;
  /* image attributes */ int has_cm; float cm[25]; int has_key; u32 key_lo, key_hi; float gamma; int wrap;
  /* font */ float em; int style, funit; char family[64];
  /* string format */ int align, line_align, flags, trimming;
  /* matrix */ float m[6];
} GpObj;
static GpObj g_gp[GP_MAX];
static int g_gp_started;
static u64 gp_handle(int i) { return GP_BASE + (u64)i * 16; }
static GpObj *gp_of(u64 h, int kind) { if (h < GP_BASE || h >= GP_BASE + (u64)GP_MAX * 16 || ((h - GP_BASE) & 15)) return 0; GpObj *o = &g_gp[(h - GP_BASE) / 16]; if (!o->kind || (kind && o->kind != kind)) return 0; return o; }
static GpObj *gp_new(Win32 *w, int kind, u64 *h) { for (int i = 1; i < GP_MAX; i++) if (!g_gp[i].kind) { GpObj *o = &g_gp[i]; e_memset(o, 0, sizeof *o); o->kind = kind; o->pid = w->pid; o->sx = o->sy = 1; o->gamma = 1; o->frames = 1; *h = gp_handle(i); return o; } *h = 0; return 0; }
static void gp_free(GpObj *o) { if (o->pts) emu_free(o->pts); if (o->types) emu_free(o->types); e_memset(o, 0, sizeof *o); }
static float gp_f(u64 bits) { float f; u32 b = (u32)bits; e_memcpy(&f, &b, 4); return f; }
static u32 gp_fbits(float f) { u32 b; e_memcpy(&b, &f, 4); return b; }
/* float argument n of the current call: x64 passes the first four in xmm registers, x86 on the stack (marshalled by the signature) */
static float gp_farg(Cpu *c, int n) { if (c->mode32) return gp_f(ARG(n)); if (n < 4) { float f; e_memcpy(&f, &c->x[n].d[0], 4); return f; } return gp_f(ARG(n)); }
static float gp_rdf(Cpu *c, u64 a) { return gp_f(rd32(c, a)); }
static void gp_wrf(Cpu *c, u64 a, float f) { wr32(c, a, gp_fbits(f)); }
#define GP_RET(st) do { RET((u64)(st)); return; } while (0)
#define GP_RETC(st) RET((u64)(st))

/* ---- pixel formats ---- */
#define PF_1BPP     0x00030101u
#define PF_4BPP     0x00030402u
#define PF_8BPP     0x00030803u
#define PF_16GRAY   0x00101004u
#define PF_16RGB555 0x00021005u
#define PF_16RGB565 0x00021006u
#define PF_16ARGB1555 0x00061007u
#define PF_24RGB    0x00021808u
#define PF_32RGB    0x00022009u
#define PF_32ARGB   0x0026200Au
#define PF_32PARGB  0x000E200Bu
#define PF_48RGB    0x0010300Cu
#define PF_64ARGB   0x0034400Du
#define PF_64PARGB  0x001A400Eu
static int pf_bpp(u32 f) { return (int)((f >> 8) & 0xff); }
static int pf_known(u32 f) { switch (f) { case PF_1BPP: case PF_4BPP: case PF_8BPP: case PF_16RGB555: case PF_16RGB565: case PF_16ARGB1555: case PF_24RGB: case PF_32RGB: case PF_32ARGB: case PF_32PARGB: case PF_16GRAY: case PF_48RGB: case PF_64ARGB: case PF_64PARGB: return 1; } return 0; }
static u32 gp_pal_default(int i, int bpp) { if (bpp == 1) return i ? 0xffffffffu : 0xff000000u; if (bpp == 4) { static const u32 p[16] = { 0xff000000, 0xff800000, 0xff008000, 0xff808000, 0xff000080, 0xff800080, 0xff008080, 0xff808080, 0xffc0c0c0, 0xffff0000, 0xff00ff00, 0xffffff00, 0xff0000ff, 0xffff00ff, 0xff00ffff, 0xffffffff }; return p[i & 15]; } /* 8 bpp: the GDI+ halftone palette approximated as 6x6x6 colour cube after 40 system colours */ if (i < 16) return gp_pal_default(i, 4); if (i >= 40 && i < 256) { int k = i - 40; int b = k % 6, g = (k / 6) % 6, r = k / 36; return 0xff000000u | (u32)(r * 51) << 16 | (u32)(g * 51) << 8 | (u32)(b * 51); } return 0xff000000u | (u32)(i * 0x010101); }
/* one row of `fmt` pixels → BGRA (straight alpha) */
static void gp_row_to_bgra(const u8 *s, u32 fmt, int n, u32 *d) {
  switch (fmt) {
    case PF_32ARGB: case PF_32RGB: for (int x = 0; x < n; x++) { u32 v; e_memcpy(&v, s + 4 * x, 4); d[x] = fmt == PF_32RGB ? v | 0xff000000u : v; } break;
    case PF_32PARGB: for (int x = 0; x < n; x++) { u32 v; e_memcpy(&v, s + 4 * x, 4); u32 a = v >> 24; if (a && a != 255) { u32 r = ((v >> 16) & 0xff) * 255 / a, g = ((v >> 8) & 0xff) * 255 / a, b = (v & 0xff) * 255 / a; if (r > 255) r = 255; if (g > 255) g = 255; if (b > 255) b = 255; v = a << 24 | r << 16 | g << 8 | b; } d[x] = v; } break;
    case PF_24RGB: for (int x = 0; x < n; x++) d[x] = 0xff000000u | (u32)s[3 * x + 2] << 16 | (u32)s[3 * x + 1] << 8 | s[3 * x]; break;
    case PF_16RGB565: for (int x = 0; x < n; x++) { u32 v = s[2 * x] | s[2 * x + 1] << 8; u32 r = (v >> 11) & 31, g = (v >> 5) & 63, b = v & 31; d[x] = 0xff000000u | (r * 255 / 31) << 16 | (g * 255 / 63) << 8 | (b * 255 / 31); } break;
    case PF_16RGB555: case PF_16ARGB1555: for (int x = 0; x < n; x++) { u32 v = s[2 * x] | s[2 * x + 1] << 8; u32 r = (v >> 10) & 31, g = (v >> 5) & 31, b = v & 31; u32 a = fmt == PF_16ARGB1555 && !(v & 0x8000) ? 0 : 0xff; d[x] = a << 24 | (r * 255 / 31) << 16 | (g * 255 / 31) << 8 | (b * 255 / 31); } break;
    case PF_16GRAY: for (int x = 0; x < n; x++) { u32 v = s[2 * x + 1]; d[x] = 0xff000000u | v << 16 | v << 8 | v; } break;
    case PF_8BPP: for (int x = 0; x < n; x++) d[x] = gp_pal_default(s[x], 8); break;
    case PF_4BPP: for (int x = 0; x < n; x++) d[x] = gp_pal_default((s[x >> 1] >> ((x & 1) ? 0 : 4)) & 15, 4); break;
    case PF_1BPP: for (int x = 0; x < n; x++) d[x] = gp_pal_default((s[x >> 3] >> (7 - (x & 7))) & 1, 1); break;
    case PF_48RGB: for (int x = 0; x < n; x++) d[x] = 0xff000000u | (u32)s[6 * x + 5] << 16 | (u32)s[6 * x + 3] << 8 | s[6 * x + 1]; break;
    case PF_64ARGB: case PF_64PARGB: for (int x = 0; x < n; x++) d[x] = (u32)s[8 * x + 7] << 24 | (u32)s[8 * x + 5] << 16 | (u32)s[8 * x + 3] << 8 | s[8 * x + 1]; break;
    default: for (int x = 0; x < n; x++) d[x] = 0xff000000u; }
}
/* BGRA row → `fmt` (indexed formats: nearest of the default palette by luminance / simple cube) */
static void gp_row_from_bgra(const u32 *s, u32 fmt, int n, u8 *d) {
  switch (fmt) {
    case PF_32ARGB: e_memcpy(d, s, (size_t)n * 4); break;
    case PF_32RGB: for (int x = 0; x < n; x++) { u32 v = s[x] | 0xff000000u; e_memcpy(d + 4 * x, &v, 4); } break;
    case PF_32PARGB: for (int x = 0; x < n; x++) { u32 v = s[x], a = v >> 24; u32 r = ((v >> 16) & 0xff) * a / 255, g = ((v >> 8) & 0xff) * a / 255, b = (v & 0xff) * a / 255; v = a << 24 | r << 16 | g << 8 | b; e_memcpy(d + 4 * x, &v, 4); } break;
    case PF_24RGB: for (int x = 0; x < n; x++) { d[3 * x] = (u8)s[x]; d[3 * x + 1] = (u8)(s[x] >> 8); d[3 * x + 2] = (u8)(s[x] >> 16); } break;
    case PF_16RGB565: for (int x = 0; x < n; x++) { u32 v = s[x]; u16 p = (u16)(((v >> 19) & 31) << 11 | ((v >> 10) & 63) << 5 | ((v >> 3) & 31)); d[2 * x] = (u8)p; d[2 * x + 1] = (u8)(p >> 8); } break;
    case PF_16RGB555: case PF_16ARGB1555: for (int x = 0; x < n; x++) { u32 v = s[x]; u16 p = (u16)(((v >> 19) & 31) << 10 | ((v >> 11) & 31) << 5 | ((v >> 3) & 31) | ((v >> 24) >= 128 || fmt == PF_16RGB555 ? 0x8000 : 0)); d[2 * x] = (u8)p; d[2 * x + 1] = (u8)(p >> 8); } break;
    case PF_8BPP: for (int x = 0; x < n; x++) { u32 v = s[x]; int r = ((v >> 16) & 0xff) + 25, g = ((v >> 8) & 0xff) + 25, b = (v & 0xff) + 25; d[x] = (u8)(40 + (r / 51) * 36 + (g / 51) * 6 + b / 51); } break;
    case PF_4BPP: e_memset(d, 0, (size_t)(n + 1) / 2); for (int x = 0; x < n; x++) { u32 v = s[x]; int idx = ((v >> 23) & 1) * 9 + ((v >> 15) & 1) * 10 + ((v >> 7) & 1) * 12; if (idx > 15) idx = 15; d[x >> 1] |= (u8)(idx << ((x & 1) ? 0 : 4)); } break;
    case PF_1BPP: e_memset(d, 0, (size_t)(n + 7) / 8); for (int x = 0; x < n; x++) { u32 v = s[x]; int lum = (((v >> 16) & 0xff) * 77 + ((v >> 8) & 0xff) * 151 + (v & 0xff) * 28) >> 8; if (lum >= 128) d[x >> 3] |= (u8)(0x80 >> (x & 7)); } break;
    default: break; }
}

/* ---- images ---- */
static GpObj *gp_image_new(Cpu *c, int bw, int bh, int alpha, u64 *h) { Win32 *w = W; if (bw <= 0 || bh <= 0 || (u64)bw * bh > 64ull << 20) { *h = 0; return 0; } u64 bits; u64 hbm = make_bitmap(c, bw, bh, 0, &bits); if (!hbm) { *h = 0; return 0; } GpObj *o = gp_new(w, GP_IMAGE, h); if (!o) return 0; o->hbm = hbm; o->bw = bw; o->bh = bh; o->has_alpha = alpha; o->pixfmt = alpha ? PF_32ARGB : PF_32RGB; return o; }
static u32 *gp_image_px(Cpu *c, GpObj *o) { return (u32 *)mem_ptr(c->mem, gdi_get(W, o->hbm)->bits, (u64)o->bw * o->bh * 4, 1); }
static u64 gp_image_from_px(Cpu *c, u32 *px, int bw, int bh, int alpha) { u64 h; GpObj *o = gp_image_new(c, bw, bh, alpha, &h); if (o) { u32 *d = gp_image_px(c, o); if (d) e_memcpy(d, px, (size_t)bw * bh * 4); } emu_free(px); return h; }
static int gp_image_dispose(Win32 *w, GpObj *o) { GdiObj *bm = gdi_get(w, o->hbm); if (bm && bm->kind == K_BITMAP) bm->kind = 0; if (o->lock_buf && o->lock_direct != 2) w32_heap_free(w, o->lock_buf); gp_free(o); return 0; }
/* decode a file image (PNG / BMP / ICO) into a new GpImage; 0 if the format is unknown */
static u64 gp_image_decode(Cpu *c, const u8 *d, size_t n) { int bw, bh, a = 0; u32 *px = 0; if (png_is(d, n)) px = png_decode(d, n, &bw, &bh, &a); else if (n > 2 && d[0] == 'B' && d[1] == 'M') px = bmp_decode(d, n, &bw, &bh, &a); else if (n > 4 && !d[0] && !d[1] && (d[2] == 1 || d[2] == 2) && !d[3]) px = ico_decode(d, n, &bw, &bh, &a); if (!px) { e_log("[gdip] cannot decode image (%u bytes, header %02x %02x %02x %02x): PNG, BMP and ICO are built in, JPEG/GIF/TIFF are not\n", (u32)n, n > 0 ? d[0] : 0, n > 1 ? d[1] : 0, n > 2 ? d[2] : 0, n > 3 ? d[3] : 0); return 0; } return gp_image_from_px(c, px, bw, bh, a); }
static u64 gp_image_from_wobj(Cpu *c, WObj *o) { return o && o->data ? gp_image_decode(c, o->data, o->len) : 0; }
/* a Graphics on an HDC the program owns, or on an image (memory DC with the image selected) */
static GpObj *gp_graphics_new(Cpu *c, u64 hdc, int target, u64 *h) { Win32 *w = W; GpObj *g = gp_new(w, GP_GRAPHICS, h); if (!g) return 0; g->hdc = hdc; g->target = target; g->interp = 0; g->unit = 2;
  if (target) { GpObj *img = &g_gp[target]; u64 dc = make_dc(w); GdiObj *d = gdi_get(w, dc); if (!d) { gp_free(g); *h = 0; return 0; } d->bitmap = img->hbm; d->wnd = 0; g->hdc = dc; g->own_dc = 1; }
  return g; }
static int gp_surf(Cpu *c, GpObj *g, Surf *s) { if (!dc_surf(c, g->hdc, s)) return 0; if (g->clip_on) { if (g->cl > s->x0) s->x0 = g->cl; if (g->ct > s->y0) s->y0 = g->ct; if (g->cr < s->w) s->w = g->cr; if (g->cb < s->h) s->h = g->cb; } return 1; }
static int gp_target_alpha(GpObj *g) { return g->target && g_gp[g->target].has_alpha; }
/* composite a straight-alpha source pixel over dest */
static inline u32 gp_over(u32 dv, u32 sv, int keep_alpha) { u32 sa = sv >> 24; if (sa == 255) return keep_alpha ? sv : sv | 0xff000000u; if (!sa) return dv; u32 da = keep_alpha ? dv >> 24 : 255; u32 ia = 255 - sa;
  u32 oa = sa + da * ia / 255; if (!oa) return 0; u32 r = (((sv >> 16) & 0xff) * sa + ((dv >> 16) & 0xff) * da * ia / 255) / oa, gch = (((sv >> 8) & 0xff) * sa + ((dv >> 8) & 0xff) * da * ia / 255) / oa, b = ((sv & 0xff) * sa + (dv & 0xff) * da * ia / 255) / oa;
  return (keep_alpha ? oa : 255u) << 24 | r << 16 | gch << 8 | b; }
static u32 gp_apply_attr(GpObj *at, u32 v) { if (!at) return v; if (at->has_key) { u32 r = (v >> 16) & 0xff, g = (v >> 8) & 0xff, b = v & 0xff; if (r >= ((at->key_lo >> 16) & 0xff) && r <= ((at->key_hi >> 16) & 0xff) && g >= ((at->key_lo >> 8) & 0xff) && g <= ((at->key_hi >> 8) & 0xff) && b >= (at->key_lo & 0xff) && b <= (at->key_hi & 0xff)) return 0; }
  if (at->has_cm) { float in[5] = { ((v >> 16) & 0xff) / 255.f, ((v >> 8) & 0xff) / 255.f, (v & 0xff) / 255.f, (v >> 24) / 255.f, 1 }, out[4]; for (int j = 0; j < 4; j++) { float s = 0; for (int i = 0; i < 5; i++) s += in[i] * at->cm[i * 5 + j]; out[j] = s < 0 ? 0 : s > 1 ? 1 : s; }
    v = (u32)(out[3] * 255 + 0.5f) << 24 | (u32)(out[0] * 255 + 0.5f) << 16 | (u32)(out[1] * 255 + 0.5f) << 8 | (u32)(out[2] * 255 + 0.5f); }
  if (at->gamma > 0 && at->gamma != 1) { u32 ch[3]; for (int k = 0; k < 3; k++) { float f = ((v >> (16 - 8 * k)) & 0xff) / 255.f; f = (float)host_math(5, f, 1.0 / at->gamma); ch[k] = (u32)(f * 255 + 0.5f); } v = (v & 0xff000000u) | ch[0] << 16 | ch[1] << 8 | ch[2]; }
  return v; }
/* DrawImage core: destination rectangle (device, after the world transform), source rectangle in image pixels; bilinear when
   the interpolation mode asks for it or the image is being shrunk, nearest otherwise */
static void gp_draw_image(Cpu *c, GpObj *g, GpObj *img, float dx, float dy, float dw, float dh, float sx, float sy, float sw, float sh, GpObj *attr) {
  Win32 *w = W; Surf d; if (!gp_surf(c, g, &d)) return; u32 *sp = gp_image_px(c, img); if (!sp || dw == 0 || dh == 0 || sw == 0 || sh == 0) return;
  dx += g->tx; dy += g->ty; dw *= g->sx; dh *= g->sy; if (dw < 0) { dx += dw; dw = -dw; sx += sw; sw = -sw; } if (dh < 0) { dy += dh; dh = -dh; sy += sh; sh = -sh; }
  int keep = gp_target_alpha(g); int x0 = (int)(dx + 0.5f), y0 = (int)(dy + 0.5f), x1 = (int)(dx + dw + 0.5f), y1 = (int)(dy + dh + 0.5f); if (x1 <= x0) x1 = x0 + 1; if (y1 <= y0) y1 = y0 + 1;
  int smooth = g->interp >= 3 || g->interp == 0 || (sw > dw * 1.01f) || (sh > dh * 1.01f); if (g->interp == 4 || g->interp == 5) smooth = 0; /* NearestNeighbor = 5 (Low = 4 ≈ nearest) */
  int iw = img->bw, ih = img->bh; float fx = sw / dw, fy = sh / dh;
  for (int y = y0; y < y1; y++) { if (y < d.y0 || y >= d.h) continue; u32 *row = srow(&d, y); float syf = sy + (y + 0.5f - dy) * fy;
    for (int x = x0; x < x1; x++) { if (x < d.x0 || x >= d.w) continue; float sxf = sx + (x + 0.5f - dx) * fx; u32 v;
      if (!smooth) { int ix = (int)sxf, iy = (int)syf; if (ix < 0) ix = 0; if (iy < 0) iy = 0; if (ix >= iw) ix = iw - 1; if (iy >= ih) iy = ih - 1; v = sp[(size_t)iy * iw + ix]; }
      else if (fx > 1.5f || fy > 1.5f) { /* shrinking: box filter over the covered source area (what GDI+ HighQualityBicubic does to thumbnails, visually) */
        int bx0 = (int)(sxf - fx * 0.5f), bx1 = (int)(sxf + fx * 0.5f), by0 = (int)(syf - fy * 0.5f), by1 = (int)(syf + fy * 0.5f); if (bx0 < 0) bx0 = 0; if (by0 < 0) by0 = 0; if (bx1 >= iw) bx1 = iw - 1; if (by1 >= ih) by1 = ih - 1; if (bx1 < bx0) bx1 = bx0; if (by1 < by0) by1 = by0;
        u64 a = 0, r = 0, gg = 0, b = 0, n = 0; for (int yy = by0; yy <= by1; yy++) for (int xx = bx0; xx <= bx1; xx++) { u32 p = sp[(size_t)yy * iw + xx]; u32 pa = p >> 24; a += pa; r += ((p >> 16) & 0xff) * pa; gg += ((p >> 8) & 0xff) * pa; b += (p & 0xff) * pa; n++; }
        if (!n || !a) v = 0; else v = (u32)(a / n) << 24 | (u32)(r / a) << 16 | (u32)(gg / a) << 8 | (u32)(b / a); }
      else { float px = sxf - 0.5f, py = syf - 0.5f; int ix = (int)px, iy = (int)py; if (px < 0) { ix = 0; px = 0; } if (py < 0) { iy = 0; py = 0; } float ax = px - ix, ay = py - iy; int ix1 = ix + 1 < iw ? ix + 1 : iw - 1, iy1 = iy + 1 < ih ? iy + 1 : ih - 1; if (ix >= iw) ix = iw - 1; if (iy >= ih) iy = ih - 1;
        u32 p00 = sp[(size_t)iy * iw + ix], p10 = sp[(size_t)iy * iw + ix1], p01 = sp[(size_t)iy1 * iw + ix], p11 = sp[(size_t)iy1 * iw + ix1]; float w00 = (1 - ax) * (1 - ay), w10 = ax * (1 - ay), w01 = (1 - ax) * ay, w11 = ax * ay;
        float a = (p00 >> 24) * w00 + (p10 >> 24) * w10 + (p01 >> 24) * w01 + (p11 >> 24) * w11; if (a < 0.5f) v = 0; else { float r = ((p00 >> 16) & 0xff) * (p00 >> 24) * w00 + ((p10 >> 16) & 0xff) * (p10 >> 24) * w10 + ((p01 >> 16) & 0xff) * (p01 >> 24) * w01 + ((p11 >> 16) & 0xff) * (p11 >> 24) * w11;
          float gg = ((p00 >> 8) & 0xff) * (p00 >> 24) * w00 + ((p10 >> 8) & 0xff) * (p10 >> 24) * w10 + ((p01 >> 8) & 0xff) * (p01 >> 24) * w01 + ((p11 >> 8) & 0xff) * (p11 >> 24) * w11; float b = (p00 & 0xff) * (p00 >> 24) * w00 + (p10 & 0xff) * (p10 >> 24) * w10 + (p01 & 0xff) * (p01 >> 24) * w01 + (p11 & 0xff) * (p11 >> 24) * w11;
          v = (u32)(a + 0.5f) << 24 | (u32)(r / a + 0.5f) << 16 | (u32)(gg / a + 0.5f) << 8 | (u32)(b / a + 0.5f); } }
      if (!img->has_alpha) v |= 0xff000000u; v = gp_apply_attr(attr, v); if (g->compositing == 1) row[x] = keep ? v : v | 0xff000000u; else row[x] = gp_over(row[x], v, keep); } }
  mark_screen(w, g->hdc); }
/* solid / gradient colour of a brush at device (x, y) */
static u32 gp_brush_at(GpObj *b, int x, int y) { if (b->brush_kind != 1) return b->argb; float t; float dx = b->gx1 - b->gx0, dy = b->gy1 - b->gy0; float l2 = dx * dx + dy * dy; t = l2 > 0 ? ((x + 0.5f - b->gx0) * dx + (y + 0.5f - b->gy0) * dy) / l2 : 0; if (b->wrap == 1 || b->wrap == 3) { /* TileFlipX/XY: ping-pong */ float m = t - 2 * (float)(long)(t / 2); if (m < 0) m += 2; t = m > 1 ? 2 - m : m; } else { t -= (float)(long)t; if (t < 0) t += 1; } if (t < 0) t = 0; if (t > 1) t = 1;
  u32 a = (u32)((b->argb >> 24) * (1 - t) + (b->argb2 >> 24) * t + 0.5f), r = (u32)(((b->argb >> 16) & 0xff) * (1 - t) + ((b->argb2 >> 16) & 0xff) * t + 0.5f), g = (u32)(((b->argb >> 8) & 0xff) * (1 - t) + ((b->argb2 >> 8) & 0xff) * t + 0.5f), bb = (u32)((b->argb & 0xff) * (1 - t) + (b->argb2 & 0xff) * t + 0.5f); return a << 24 | r << 16 | g << 8 | bb; }
static void gp_fill_rect(Cpu *c, GpObj *g, GpObj *b, float x, float y, float fw, float fh) { Win32 *w = W; Surf d; if (!gp_surf(c, g, &d)) return; x += g->tx; y += g->ty; fw *= g->sx; fh *= g->sy; int x0 = (int)(x + 0.5f), y0 = (int)(y + 0.5f), x1 = (int)(x + fw + 0.5f), y1 = (int)(y + fh + 0.5f); int keep = gp_target_alpha(g);
  for (int yy = y0; yy < y1; yy++) { if (yy < d.y0 || yy >= d.h) continue; u32 *row = srow(&d, yy); for (int xx = x0; xx < x1; xx++) { if (xx < d.x0 || xx >= d.w) continue; u32 v = gp_brush_at(b, xx, yy); row[xx] = g->compositing == 1 ? (keep ? v : v | 0xff000000u) : gp_over(row[xx], v, keep); } } mark_screen(w, g->hdc); }
/* scanline polygon fill (even-odd / winding) of a flattened path */
static void gp_fill_poly(Cpu *c, GpObj *g, GpObj *b, const float *pts, const u8 *types, int n, int winding) { Win32 *w = W; Surf d; if (!gp_surf(c, g, &d) || n < 3) return; int keep = gp_target_alpha(g);
  float miny = 1e9f, maxy = -1e9f; for (int i = 0; i < n; i++) { float y = pts[2 * i + 1] * g->sy + g->ty; if (y < miny) miny = y; if (y > maxy) maxy = y; }
  int y0 = (int)miny, y1 = (int)(maxy + 1); if (y0 < d.y0) y0 = d.y0; if (y1 > d.h) y1 = d.h; float xs[512]; int dirs[512];
  /* figures: a point with type bit 0x80 closes the figure; a type 0 (start) opens a new one */
  for (int yy = y0; yy < y1; yy++) { float cy = yy + 0.5f; int nx = 0; int start = 0;
    for (int i = 0; i < n; i++) { int last = i == n - 1 || (types && (types[i] & 0x80)) || (types && i + 1 < n && (types[i + 1] & 7) == 0); int j = last ? start : i + 1;
      float ax = pts[2 * i] * g->sx + g->tx, ay = pts[2 * i + 1] * g->sy + g->ty, bx = pts[2 * j] * g->sx + g->tx, by = pts[2 * j + 1] * g->sy + g->ty;
      if ((ay <= cy && by > cy) || (by <= cy && ay > cy)) { if (nx < 512) { xs[nx] = ax + (cy - ay) * (bx - ax) / (by - ay); dirs[nx] = by > ay ? 1 : -1; nx++; } }
      if (last) start = i + 1; }
    for (int i = 1; i < nx; i++) { float t = xs[i]; int dd = dirs[i]; int k = i - 1; while (k >= 0 && xs[k] > t) { xs[k + 1] = xs[k]; dirs[k + 1] = dirs[k]; k--; } xs[k + 1] = t; dirs[k + 1] = dd; }
    u32 *row = srow(&d, yy); int wind = 0; for (int i = 0; i + 1 < nx; i++) { wind += winding ? dirs[i] : 1; int inside = winding ? wind != 0 : (wind & 1); if (!inside) continue; int xa = (int)(xs[i] + 0.5f), xb = (int)(xs[i + 1] + 0.5f); if (xa < d.x0) xa = d.x0; if (xb > d.w) xb = d.w; for (int xx = xa; xx < xb; xx++) { u32 v = gp_brush_at(b, xx, yy); row[xx] = g->compositing == 1 ? (keep ? v : v | 0xff000000u) : gp_over(row[xx], v, keep); } } }

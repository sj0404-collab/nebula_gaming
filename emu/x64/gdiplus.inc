/* ---- startup ---- */
static void s_GdiplusStartup(Cpu *c) { u64 token = ARG(0), in = ARG(1), out = ARG(2); if (!token || !in) GP_RET(GpInvalidParameter); u32 ver = rd32(c, in); if (ver < 1 || ver > 2) GP_RET(17); wrp(c, token, 0x6D1Full); g_gp_started = 1;
  if (out) { u64 P = PSZ_OF(c); wr32(c, out, 1); wrp(c, out + P, 0); wrp(c, out + 2 * P, 0); }   /* GdiplusStartupOutput: hook/unhook procs NULL (no background thread) */ GP_RET(GpOk); }
static void s_GdiplusShutdown(Cpu *c) { Win32 *w = W; for (int i = 1; i < GP_MAX; i++) if (g_gp[i].kind && g_gp[i].pid == w->pid) { if (g_gp[i].kind == GP_IMAGE) gp_image_dispose(w, &g_gp[i]); else gp_free(&g_gp[i]); } RET(0); }
static void s_GdipAlloc(Cpu *c) { RET(w32_heap_alloc(W, ARG(0) ? ARG(0) : 1, 0)); }
static void s_GdipFree(Cpu *c) { if (ARG(0)) w32_heap_free(W, ARG(0)); RET(0); }

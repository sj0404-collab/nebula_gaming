static void gp_put(Surf *d, int x, int y, u32 v, int keep, int copy) { if (x < d->x0 || x >= d->w || y < d->y0 || y >= d->h) return; u32 *p = srow(d, y) + x; *p = copy ? (keep ? v : v | 0xff000000u) : gp_over(*p, v, keep); }
static void gp_line(Cpu *c, GpObj *g, GpObj *pen, float x0, float y0, float x1, float y1) { Surf d; if (!gp_surf(c, g, &d)) return; x0 = x0 * g->sx + g->tx; y0 = y0 * g->sy + g->ty; x1 = x1 * g->sx + g->tx; y1 = y1 * g->sy + g->ty; int keep = gp_target_alpha(g), copy = g->compositing == 1; int wd = (int)(pen->width + 0.5f); if (wd < 1) wd = 1;
  float dx = x1 - x0, dy = y1 - y0; float len = dx < 0 ? -dx : dx; if ((dy < 0 ? -dy : dy) > len) len = dy < 0 ? -dy : dy; int steps = (int)len + 1; for (int i = 0; i <= steps; i++) { float t = steps ? (float)i / steps : 0; int px = (int)(x0 + dx * t), py = (int)(y0 + dy * t); if (pen->dash > 0 && pen->dash < 5 && ((i / (pen->dash == 1 ? 3 : 1)) & 1)) continue; for (int k = 0; k < wd; k++) for (int m = 0; m < wd; m++) gp_put(&d, px + k - wd / 2, py + m - wd / 2, pen->argb, keep, copy); }
  mark_screen(W, g->hdc); }
/* ellipse / arc flattening into path points */
static int gp_path_add(GpObj *p, float x, float y, u8 type) { if (p->npts >= GP_PATH_MAX) return 0; if (!p->pts) { p->pts = emu_alloc(GP_PATH_MAX * 2 * sizeof(float)); p->types = emu_alloc(GP_PATH_MAX); } p->pts[2 * p->npts] = x; p->pts[2 * p->npts + 1] = y; p->types[p->npts] = type; p->npts++; return 1; }
static void gp_path_arc(GpObj *p, float x, float y, float w, float h, float a0, float sweep) { int n = (int)((sweep < 0 ? -sweep : sweep) / 6) + 2; if (n > 128) n = 128; for (int i = 0; i <= n; i++) { float a = (a0 + sweep * i / n) * 3.14159265f / 180; float px = x + w / 2 + (float)host_math(1, a, 0) * w / 2, py = y + h / 2 + (float)host_math(0, a, 0) * h / 2; gp_path_add(p, px, py, (u8)(p->npts == 0 || !p->figure_open ? 0 : 1)); p->figure_open = 1; } }
static void gp_path_close(GpObj *p) { if (p->npts && p->figure_open) { p->types[p->npts - 1] |= 0x80; p->figure_open = 0; } }
static void gp_stroke_path(Cpu *c, GpObj *g, GpObj *pen, GpObj *p) { int start = 0; for (int i = 0; i < p->npts; i++) { int t = p->types[i] & 7; if (t == 0) { if (i > 0 && (p->types[i - 1] & 0x80)) gp_line(c, g, pen, p->pts[2 * (i - 1)], p->pts[2 * (i - 1) + 1], p->pts[2 * start], p->pts[2 * start + 1]); start = i; continue; } gp_line(c, g, pen, p->pts[2 * (i - 1)], p->pts[2 * (i - 1) + 1], p->pts[2 * i], p->pts[2 * i + 1]); if (p->types[i] & 0x80) gp_line(c, g, pen, p->pts[2 * i], p->pts[2 * i + 1], p->pts[2 * start], p->pts[2 * start + 1]); } }
/* text: GDI font of the right height selected into the Graphics' DC, colour from the brush */
/* GDI+ font → a GDI font object for the text engine (px = em in device pixels; style bit0 bold, bit1 italic, bit2 underline, bit3 strikeout) */
static float gp_font_px(GpObj *font, float sy) { float em = font ? font->em : 12; int unit = font ? font->funit : 3; float px = unit == 3 ? em * 96 / 72 : unit == 4 ? em * 96 : unit == 5 ? em * 96 / 25.4f : unit == 6 ? em * 96 / 1200 : em; return px * sy; }
static GdiObj *gp_gdi_font(Win32 *w, GpObj *font, float px) { GdiObj *f = gdi_new(w, K_FONT); if (!f) return 0; int st = font ? font->style : 0; fnt_setup(f, -(int)(px + 0.5f), st & 1 ? 700 : 400, st & 2, st & 4, st & 8, 0, font && font->family[0] ? font->family : "Segoe UI"); return f; }
/* lines of a UTF-16 string: split at \n, wrapped by pixel width (space boundaries) unless NoWrap; returns the count, fills starts/lens (UTF-16 units) */
static int gp_lines(Cpu *c, GdiObj *f, u64 str, int n, float lw, int nowrap, int *starts, int *lens, int cap) { int nl = 0, i = 0; int maxw = lw > 0 && !nowrap ? (int)lw : 0;
  while (i <= n && nl < cap) { int e = i; while (e < n && rd16(c, str + 2 * e) != '\n') e++; int seg = i;
    if (seg == e) { starts[nl] = seg; lens[nl] = 0; nl++; }
    while (seg < e && nl < cap) { if (!maxw) { starts[nl] = seg; lens[nl] = e - seg; nl++; seg = e; break; }
      int cut = seg, wacc = 0, last_space = -1; while (cut < e) { u32 ch = rd16(c, str + 2 * cut); if (ch == ' ') last_space = cut; int a = fnt_cp_adv(f, ch); if (wacc + a > maxw && cut > seg) break; wacc += a; cut++; }
      int endl = cut < e && last_space > seg ? last_space : cut; starts[nl] = seg; lens[nl] = endl - seg; nl++; seg = endl; while (seg < e && rd16(c, str + 2 * seg) == ' ') seg++; }
    i = e + 1; }

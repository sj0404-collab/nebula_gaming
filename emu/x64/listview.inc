      if (d) { Surf cs = s; int lim = report && lv->ncol ? ccx0 + cwid - 2 : (report ? cw - sbw : cx0 + cellw - 2); if (lim < cs.w) cs.w = lim; cc_text(&cs, d, w, tx, y + (ih - fh) / 2, t, hl && n->focus_draw && (fullrow || col == 0) ? 0xffffff : fg); } }
    if (foc) { for (int xx = rowl; xx < rowr; xx += 2) { if (y >= s.y0 && y < s.h) srow(&s, y)[xx] ^= 0xffffff; if (y + ih - 1 >= s.y0 && y + ih - 1 < s.h) srow(&s, y + ih - 1)[xx] ^= 0xffffff; } }
    if (gridlines) hline(&s, 0, cw - 1 - sbw, y + ih - 1, 0xe5e5e5); }
  (void)grid; if (gridlines) for (int col = 1; col <= lv->ncol; col++) { int x = lv_col_x(lv, col); if (x < cw) line_px(&s, x - 1, hh, x - 1, ch - 1, 0xe5e5e5); }
  if (hh) { fill_rect_px(&s, 0, 0, cw, hh, 0xffffff); hline(&s, 0, cw - 1, hh - 1, 0xe5e5e5); for (int col = 0; col < lv->ncol; col++) { int x = lv_col_x(lv, col), cwid = lv->col[col].cx; line_px(&s, x + cwid - 1, 2, x + cwid - 1, hh - 3, 0xe5e5e5); int tw = text_width(w, font, lv->col[col].text, (int)e_strlen(lv->col[col].text)); int fmt = lv->col[col].fmt & 3; int tx = fmt == 1 ? x + cwid - 6 - tw : fmt == 2 ? x + (cwid - tw) / 2 : x + 6; if (tx < x + 2) tx = x + 2; if (d) { Surf cs = s; if (x + cwid - 2 < cs.w) cs.w = x + cwid - 2; cc_text(&cs, d, w, tx, (hh - fh) / 2, lv->col[col].text, 0x000000); } } }
  if (sbw) { int bar_y = hh + 1, bar_h = ch - hh - 2, th = page * bar_h / (units ? units : 1); if (th < 8) th = 8; int ty = bar_y + lv->top * (bar_h - th) / (units - page > 0 ? units - page : 1); fill_rect_px(&s, cw - sbw, bar_y, cw - 1, ch - 1, 0xf0f0f0); fill_rect_px(&s, cw - sbw + 2, ty, cw - 3, ty + th, 0xcdcdcd); }

/* listview.inc — comctl32 SysListView32: report view (rows + header), icon view (grid of large icons with centred, wrapped labels),
   small-icon view (grid of small icon + label) and list view (columns flowing top-to-bottom, horizontal scrolling); included from gdi.c after treeview.inc.
   Items and subitem texts live on the host; LVS_OWNERDATA and LPSTR_TEXTCALLBACK texts are fetched through LVN_GETDISPINFO before
   painting (continuation CONT_LVDISP).  State changes raise LVN_ITEMCHANGING/ITEMCHANGED through CONT_LVCHG; LVM_SORTITEMS(EX) runs an
   insertion sort whose comparisons are guest calls (CONT_LVSORT).  Columns, header row with LVN_COLUMNCLICK, checkboxes
   (LVS_EX_CHECKBOXES), full-row select, grid lines, keyboard navigation, NM_CLICK/DBLCLK/RCLICK/RETURN, LVN_ITEMACTIVATE, LVN_KEYDOWN,
   LVN_DELETEITEM/DELETEALLITEMS/INSERTITEM.  In-place label editing (LVM_EDITLABEL / F2 with LVS_EDITLABELS: LVN_BEGINLABELEDIT, an Edit child over
   the label, Enter / focus loss commit and Escape cancels through LVN_ENDLABELEDIT, CONT_LVEDIT).  No groups, no drag images, no custom draw. */
#define LV_MAXCOL 16
typedef struct { u32 state; int image, indent; u64 lparam; u8 cb, fetched; char *sub[LV_MAXCOL]; } LvItem;
typedef struct { char text[64]; int cx, fmt, image; } LvCol;
typedef struct { LvItem *it; int n, cap; LvCol col[LV_MAXCOL]; int ncol; int top, focus, mark; u64 himl, himl_small, himl_state; u32 bk, fg, tbk; int bk_set, fg_set, tbk_set; u32 exstyle; int odcount; char *odtext; int odrows, odcols, odtop; u8 *odgot; u64 nmbuf, txtbuf; struct { int item; u32 nst, ost; } chg[16]; int nchg; int hot; u64 sortfn, sortlp; int sortex, sort_i, sort_j; int itemh_cache; int sp_cx, sp_cy, listw; int edit_item; char editbuf[520]; u64 edbuf; } ListView;
static ListView *lv_of(int i) { return g_wnd[i].cc; }
static int lv_strnicmp(const char *a, const char *b, size_t n) { for (size_t k = 0; k < n; k++) { int x = (unsigned char)a[k], y = (unsigned char)b[k]; if (x >= 'A' && x <= 'Z') x += 32; if (y >= 'A' && y <= 'Z') y += 32; if (x != y) return x - y; if (!x) return 0; } return 0; }
static int lv_report(Wnd *n) { return (n->style & 3) == 1; }
static int lv_ownerdata(Wnd *n) { return (n->style & 0x1000) != 0; }
static int lv_count(Wnd *n, ListView *lv) { return lv_ownerdata(n) ? lv->odcount : lv->n; }
static int lv_mode(Wnd *n) { return n->style & 3; }   /* 0 icon, 1 report, 2 small icon, 3 list */
static int lv_grid(Wnd *n) { int m = n->style & 3; return m == 0 || m == 2; }   /* rows of cells, vertical scrolling in grid rows */
static int lv_list(Wnd *n) { return (n->style & 3) == 3; }                       /* columns of cells, horizontal scrolling in columns */
static ImgList *lv_iml(Wnd *n, ListView *lv) { ImgList *il = iml_of(lv_mode(n) == 0 ? lv->himl : lv->himl_small); if (!il) il = iml_of(lv_mode(n) == 0 ? lv->himl_small : lv->himl); return il; }
static int lv_item_h(Win32 *w, Wnd *n, ListView *lv) { int h = cc_font_h(w, n) + 4; ImgList *il = iml_of(lv_mode(n) != 0 ? lv->himl_small : lv->himl); if (il && il->cy + 2 > h) h = il->cy + 2; if ((lv->exstyle & 4) && h < 17) h = 17; (void)lv; return h; }
static int lv_header_h(Win32 *w, Wnd *n) { return lv_report(n) && !(n->style & 0x4000) ? cc_font_h(w, n) + 8 : 0; }
static int lv_total_w(Wnd *n, ListView *lv, int i);
static const char *lv_cell(Wnd *n, ListView *lv, int k, int col);
/* cell size per view: icon = LVM_SETICONSPACING or icon + margins; small icon / list = widest label + icon (or LVM_SETCOLUMNWIDTH in list view) */
static void lv_cell_size(Win32 *w, int i, ListView *lv, int *cw_, int *ch_) { Wnd *n = &g_wnd[i]; int fh = cc_font_h(w, n); int m = lv_mode(n);
  if (m == 0) { ImgList *il = lv_iml(n, lv); int icx = il ? il->cx : 32, icy = il ? il->cy : 32; *cw_ = lv->sp_cx > 0 ? lv->sp_cx : (icx + 43 < 75 ? 75 : icx + 43); *ch_ = lv->sp_cy > 0 ? lv->sp_cy : icy + 2 * fh + 14; return; }
  if (m == 1) { *cw_ = lv_total_w(n, lv, i); *ch_ = lv_item_h(w, n, lv); return; }
  int ih = lv_item_h(w, n, lv); if (m == 3 && lv->listw > 0) { *cw_ = lv->listw; *ch_ = ih; return; }
  if (lv->listw < 0) { /* cached auto width */ *cw_ = -lv->listw; *ch_ = ih; return; }
  ImgList *il = lv_iml(n, lv); int best = 40, cnt = lv_count(n, lv); for (int k = 0; k < cnt && k < 2000; k++) { const char *t = lv_cell(n, lv, k, 0); int tw = text_width(w, n->font ? n->font : g_dlg_font, t, (int)e_strlen(t)); if (tw > best) best = tw; } int cw = best + 10 + (il ? il->cx + 3 : 0) + ((lv->exstyle & 4) ? 16 : 0); if (cw > 400) cw = 400; lv->listw = -cw; *cw_ = cw; *ch_ = ih; }
/* items per scroll unit (grid: cells per row, list: cells per column, report: 1) */
static int lv_per(Win32 *w, int i, ListView *lv) { Wnd *n = &g_wnd[i]; if (lv_report(n)) return 1; int cw, ch; lv_cell_size(w, i, lv, &cw, &ch); if (lv_grid(n)) { int cnt = lv_count(n, lv); int avail = wnd_client_w(i) - 4; int per = avail / (cw ? cw : 1); if (per < 1) per = 1; int rows = (cnt + per - 1) / per; if (rows * ch > wnd_client_h(i) - 4) { per = (avail - 12) / (cw ? cw : 1); if (per < 1) per = 1; } return per; } int per = (wnd_client_h(i) - 2) / (ch ? ch : 1); return per < 1 ? 1 : per; }
static int lv_units(Win32 *w, int i, ListView *lv) { Wnd *n = &g_wnd[i]; int cnt = lv_count(n, lv); if (lv_report(n)) return cnt; int per = lv_per(w, i, lv); return (cnt + per - 1) / per; }
/* scroll units that fit on the page (rows / grid rows / columns) */
static int lv_rows_full(Win32 *w, int i, ListView *lv) { Wnd *n = &g_wnd[i]; if (lv_report(n)) { int ch = wnd_client_h(i) - lv_header_h(w, n) - 2; int ih = lv_item_h(w, n, lv); return ch > 0 ? ch / ih : 1; } int cw, ch; lv_cell_size(w, i, lv, &cw, &ch); int page = lv_list(n) ? (wnd_client_w(i) - 2) / (cw ? cw : 1) : (wnd_client_h(i) - 2) / (ch ? ch : 1); return page < 1 ? 1 : page; }
static int lv_rows_fit(Win32 *w, int i, ListView *lv) { return lv_rows_full(w, i, lv) + 1; }
static void lv_clamp_top(Win32 *w, int i, ListView *lv) { int units = lv_units(w, i, lv), fit = lv_rows_full(w, i, lv); if (lv->top > units - fit) lv->top = units - fit; if (lv->top < 0) lv->top = 0; }
static int lv_unit_of(Win32 *w, int i, ListView *lv, int r) { return lv_report(&g_wnd[i]) ? r : r / lv_per(w, i, lv); }
static void lv_ensure_visible(Win32 *w, int i, ListView *lv, int r) { int u = lv_unit_of(w, i, lv, r), fit = lv_rows_full(w, i, lv); if (u < lv->top) lv->top = u; else if (u >= lv->top + fit) lv->top = u - fit + 1; lv_clamp_top(w, i, lv); }
/* top-left of item r's cell in client coordinates */
static void lv_item_xy(Win32 *w, int i, ListView *lv, int r, int *x, int *y) { Wnd *n = &g_wnd[i]; if (lv_report(n)) { *x = 0; *y = lv_header_h(w, n) + 1 + (r - lv->top) * lv_item_h(w, n, lv); return; } int cw, ch; lv_cell_size(w, i, lv, &cw, &ch); int per = lv_per(w, i, lv); if (lv_grid(n)) { *x = 2 + (r % per) * cw; *y = 2 + (r / per - lv->top) * ch; } else { *x = 2 + (r / per - lv->top) * cw; *y = 1 + (r % per) * ch; } }
/* icon view labels: up to two lines, the second one clipped */
static void lv_wrap(Win32 *w, Wnd *n, const char *t, int maxw, char *l1, char *l2, size_t cap) { u64 font = n->font ? n->font : g_dlg_font; size_t len = e_strlen(t); if (text_width(w, font, t, (int)len) <= maxw) { e_snprintf(l1, cap, "%s", t); l2[0] = 0; return; }
  size_t cut = len, sp = 0; for (size_t k = 1; k <= len; k++) { if (text_width(w, font, t, (int)k) > maxw) { cut = k - 1; break; } if (t[k - 1] == ' ' || t[k - 1] == '-' || t[k - 1] == '_' || t[k - 1] == '.') sp = k; } if (sp > 0 && sp < cut + 1 && cut < len) cut = sp; if (cut < 1) cut = 1;
  e_snprintf(l1, cap, "%.*s", (int)cut, t); const char *rest = t + cut; while (*rest == ' ') rest++; e_snprintf(l2, cap, "%s", rest); }
static int lv_ensure_cap(ListView *lv, int need) { if (need <= lv->cap) return 1; int nc = lv->cap ? lv->cap : 64; while (nc < need) nc *= 2; LvItem *ni = emu_alloc(sizeof(LvItem) * nc); if (!ni) return 0; e_memset(ni, 0, sizeof(LvItem) * nc); if (lv->it) { e_memcpy(ni, lv->it, sizeof(LvItem) * lv->n); emu_free(lv->it); } lv->it = ni; lv->cap = nc; return 1; }
static void lv_set_sub(LvItem *t, int col, const char *s) { if (col < 0 || col >= LV_MAXCOL) return; if (t->sub[col]) { emu_free(t->sub[col]); t->sub[col] = 0; } if (!s || !*s) return; size_t l = e_strlen(s); char *d = emu_alloc(l + 1); if (!d) return; e_memcpy(d, s, l + 1); t->sub[col] = d; }
static const char *lv_sub(ListView *lv, int k, int col) { if (k < 0 || k >= lv->n || col < 0 || col >= LV_MAXCOL) return ""; return lv->it[k].sub[col] ? lv->it[k].sub[col] : ""; }
static void lv_free_item(LvItem *t) { for (int q = 0; q < LV_MAXCOL; q++) if (t->sub[q]) emu_free(t->sub[q]); e_memset(t, 0, sizeof *t); }
/* owner-data / callback text cache for the rows on screen: odtext[(row - odtop) * odcols + col][96] */
static const char *lv_cell(Wnd *n, ListView *lv, int k, int col) { if (lv_ownerdata(n) || (k < lv->n && lv->it[k].cb)) { if (!lv->odtext || k < lv->odtop || k >= lv->odtop + lv->odrows || col >= lv->odcols) return ""; return lv->odtext + ((k - lv->odtop) * lv->odcols + col) * 96; } return lv_sub(lv, k, col); }
static u32 lv_state(Wnd *n, ListView *lv, int k) { if (lv_ownerdata(n)) { u32 s = 0; if (k == lv->focus) s |= 1; if (k >= 0 && k < lv->n && (lv->it[k].state & 2)) s |= 2; /* owner data keeps selection in a shadow array */ if (k >= 0 && k < lv->n) s |= lv->it[k].state & ~3u; return s; } return k >= 0 && k < lv->n ? (lv->it[k].state | (k == lv->focus ? 1 : 0)) : 0; }
static int lv_shadow(ListView *lv, int k) { if (k < 0) return 0; if (!lv_ensure_cap(lv, k + 1)) return 0; if (lv->n < k + 1) lv->n = k + 1; return 1; }
static int lv_col_x(ListView *lv, int col) { int x = 0; for (int q = 0; q < col && q < lv->ncol; q++) x += lv->col[q].cx; return x; }
static int lv_total_w(Wnd *n, ListView *lv, int i) { if (!lv_report(n)) return wnd_client_w(i); int x = lv_col_x(lv, lv->ncol); return x > 0 ? x : wnd_client_w(i); }
static void lv_paint_core(Cpu *c, int i, u64 hdc) { Win32 *w = W; Wnd *n = &g_wnd[i]; ListView *lv = n->cc; Surf s; if (!dc_surf(c, hdc, &s) || !lv) return; int cw = wnd_client_w(i), ch = wnd_client_h(i); int en = wnd_enabled_chain(i); u32 bg = lv->bk_set ? lv->bk : (en ? 0xffffff : 0xf0f0f0); fill_rect_px(&s, 0, 0, cw, ch, bg);
  GdiObj *d = cc_dc(w, hdc, n); u64 font = n->font ? n->font : g_dlg_font; int fh = cc_font_h(w, n); int ih = lv_item_h(w, n, lv), hh = lv_header_h(w, n); int cnt = lv_count(n, lv); lv_clamp_top(w, i, lv); int report = lv_report(n), grid = lv_grid(n), list = lv_list(n), iconview = lv_mode(n) == 0; int fullrow = (lv->exstyle & 0x20) != 0 || !report, gridlines = (lv->exstyle & 1) != 0 && report, checks = (lv->exstyle & 4) != 0; ImgList *il = lv_iml(n, lv);
  int units = lv_units(w, i, lv), page = lv_rows_full(w, i, lv); int scroll = units > page; int sbw = scroll && !list ? 12 : 0, sbh = scroll && list ? 12 : 0; int ncol = report ? (lv->ncol ? lv->ncol : 1) : 1; int cellw = cw, cellh = ih; if (!report) lv_cell_size(w, i, lv, &cellw, &cellh); int per = report ? 1 : lv_per(w, i, lv);
  int first = report ? lv->top : lv->top * per, last = report ? lv->top + page + 1 : (lv->top + page + 1) * per; if (last > cnt) last = cnt; u32 hbg = n->focus_draw ? 0x0078d7 : 0xcccccc; u32 fg = !en ? 0x6d6d6d : lv->fg_set ? lv->fg : 0x000000;
  for (int r = first; r < last; r++) { int cx0, cy0; lv_item_xy(w, i, lv, r, &cx0, &cy0); if (cy0 >= ch - sbh || cx0 >= cw - sbw) continue; u32 st = lv_state(n, lv, r); int sel = (st & 2) != 0, foc = r == lv->focus && n->focus_draw; int hl = sel && (n->focus_draw || (n->style & 8)); const char *t0 = lv_cell(n, lv, r, 0); int im = r < lv->n ? lv->it[r].image : -1;
    if (iconview) { /* large icon centred on top, label centred below (two lines when selected or short enough) */ int icx = il ? il->cx : 32, icy = il ? il->cy : 32; int ix = cx0 + (cellw - icx) / 2, iy = cy0 + 4; char l1[128], l2[128]; lv_wrap(w, n, t0, cellw - 6, l1, l2, sizeof l1); if (!sel && l2[0]) { /* unselected labels show one line with an ellipsis */ size_t L = e_strlen(l1); if (L > 3) { l1[L - 1] = 0; while (L > 2 && text_width(w, font, l1, (int)e_strlen(l1)) + text_width(w, font, "...", 3) > cellw - 6) l1[--L - 1] = 0; size_t q = e_strlen(l1); e_snprintf(l1 + q, sizeof l1 - q, "..."); } l2[0] = 0; }
      int tw1 = text_width(w, font, l1, (int)e_strlen(l1)), tw2 = l2[0] ? text_width(w, font, l2, (int)e_strlen(l2)) : 0; int tw = tw1 > tw2 ? tw1 : tw2; int lx = cx0 + (cellw - tw) / 2 - 2, ly = iy + icy + 3, lh = fh * (l2[0] ? 2 : 1) + 4; if (lx < cx0) lx = cx0; int lr = lx + tw + 4; if (lr > cx0 + cellw) lr = cx0 + cellw;
      if (hl) { fill_rect_px(&s, ix - 2, iy - 2, ix + icx + 2, iy + icy + 2, n->focus_draw ? 0xcce8ff : 0xe5e5e5); fill_rect_px(&s, lx, ly, lr, ly + lh, hbg); } else if (lv->tbk_set) fill_rect_px(&s, lx, ly, lr, ly + lh, lv->tbk);

      if (d) { Surf cs = s; if (cx0 + cellw < cs.w) cs.w = cx0 + cellw; u32 tc = hl && n->focus_draw ? 0xffffff : fg; cc_text(&cs, d, w, cx0 + (cellw - tw1) / 2, ly + 2, l1, tc); if (l2[0]) cc_text(&cs, d, w, cx0 + (cellw - tw2) / 2, ly + 2 + fh, l2, tc); }
      if (foc) { for (int xx = lx; xx < lr; xx += 2) { if (ly >= s.y0 && ly < s.h) srow(&s, ly)[xx] ^= 0xffffff; if (ly + lh - 1 >= s.y0 && ly + lh - 1 < s.h) srow(&s, ly + lh - 1)[xx] ^= 0xffffff; } } continue; }
    int y = cy0, x = cx0 + 2; if (checks) { int on = ((st >> 12) & 0xF) == 2; int cy = y + ih / 2; fill_rect_px(&s, x, cy - 6, x + 13, cy + 7, 0xffffff); edge_rect(&s, x, cy - 6, x + 13, cy + 7, 0x333333, 0x333333); if (on) { line_px(&s, x + 3, cy, x + 5, cy + 3, 0); line_px(&s, x + 5, cy + 3, x + 10, cy - 3, 0); } x += 16; }
    if (il && im >= 0 && im < il->n) { iml_draw(c, il, im, hdc, x, y + (ih - il->cy) / 2, 0, 0, 0); } if (il) x += il->cx + 3; int text_x0 = x + (r < lv->n ? lv->it[r].indent * 16 : 0);
    int tw0 = text_width(w, font, t0, (int)e_strlen(t0)) + 4; int rowr = report ? (fullrow ? lv_total_w(n, lv, i) : text_x0 + tw0) : text_x0 + tw0; if (report && !fullrow && lv->ncol && rowr > lv->col[0].cx) rowr = lv->col[0].cx; if (!report && rowr > cx0 + cellw - 2) rowr = cx0 + cellw - 2; int rowl = report && fullrow ? 1 : text_x0 - 1;

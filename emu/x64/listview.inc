      if (y < hh && lv_report(n)) { /* header click → LVN_COLUMNCLICK */ int cx = 0, col = -1; for (int q = 0; q < lv->ncol; q++) { if (x >= cx && x < cx + lv->col[q].cx) { col = q; break; } cx += lv->col[q].cx; } if (col >= 0 && msg == 0x201) { lv_nm_simple(c, i, (u32)-108, -1, col, 0); return; } RET(0); return; }

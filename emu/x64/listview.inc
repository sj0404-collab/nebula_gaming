/* listview.inc — comctl32 SysListView32 (report / list / icon views drawn as rows; included from gdi.c after treeview.inc).
   Items and subitem texts live on the host; LVS_OWNERDATA and LPSTR_TEXTCALLBACK texts are fetched through LVN_GETDISPINFO before
   painting (continuation CONT_LVDISP).  State changes raise LVN_ITEMCHANGING/ITEMCHANGED through CONT_LVCHG; LVM_SORTITEMS(EX) runs an
   insertion sort whose comparisons are guest calls (CONT_LVSORT).  Columns, header row with LVN_COLUMNCLICK, checkboxes
   (LVS_EX_CHECKBOXES), full-row select, grid lines, keyboard navigation, NM_CLICK/DBLCLK/RCLICK/RETURN, LVN_ITEMACTIVATE, LVN_KEYDOWN,
   LVN_DELETEITEM/DELETEALLITEMS/INSERTITEM.  No label editing, no groups, no drag images, no custom draw. */
#define LV_MAXCOL 16
typedef struct { u32 state; int image, indent; u64 lparam; u8 cb, fetched; char *sub[LV_MAXCOL]; } LvItem;
typedef struct { char text[64]; int cx, fmt, image; } LvCol;
typedef struct { LvItem *it; int n, cap; LvCol col[LV_MAXCOL]; int ncol; int top, focus, mark; u64 himl, himl_small, himl_state; u32 bk, fg, tbk; int bk_set, fg_set, tbk_set; u32 exstyle; int odcount; char *odtext; int odrows, odcols, odtop; u8 *odgot; u64 nmbuf, txtbuf; struct { int item; u32 nst, ost; } chg[16]; int nchg; int hot; u64 sortfn, sortlp; int sortex, sort_i, sort_j; int itemh_cache; } ListView;
static ListView *lv_of(int i) { return g_wnd[i].cc; }
static int lv_strnicmp(const char *a, const char *b, size_t n) { for (size_t k = 0; k < n; k++) { int x = (unsigned char)a[k], y = (unsigned char)b[k]; if (x >= 'A' && x <= 'Z') x += 32; if (y >= 'A' && y <= 'Z') y += 32; if (x != y) return x - y; if (!x) return 0; } return 0; }
static int lv_report(Wnd *n) { return (n->style & 3) == 1; }
static int lv_ownerdata(Wnd *n) { return (n->style & 0x1000) != 0; }
static int lv_count(Wnd *n, ListView *lv) { return lv_ownerdata(n) ? lv->odcount : lv->n; }
static int lv_item_h(Win32 *w, Wnd *n, ListView *lv) { int h = cc_font_h(w, n) + 4; ImgList *il = iml_of(lv_report(n) || (n->style & 3) != 0 ? lv->himl_small : lv->himl); if (il && il->cy + 2 > h) h = il->cy + 2; if ((lv->exstyle & 4) && h < 17) h = 17; (void)lv; return h; }
static int lv_header_h(Win32 *w, Wnd *n) { return lv_report(n) && !(n->style & 0x4000) ? cc_font_h(w, n) + 8 : 0; }
static int lv_rows_fit(Win32 *w, int i, ListView *lv) { Wnd *n = &g_wnd[i]; int ch = wnd_client_h(i) - lv_header_h(w, n) - 2; int ih = lv_item_h(w, n, lv); return ch > 0 ? (ch + ih - 1) / ih : 1; }
static int lv_rows_full(Win32 *w, int i, ListView *lv) { Wnd *n = &g_wnd[i]; int ch = wnd_client_h(i) - lv_header_h(w, n) - 2; int ih = lv_item_h(w, n, lv); return ch > 0 ? ch / ih : 1; }
static void lv_clamp_top(Win32 *w, int i, ListView *lv) { Wnd *n = &g_wnd[i]; int cnt = lv_count(n, lv), fit = lv_rows_full(w, i, lv); if (lv->top > cnt - fit) lv->top = cnt - fit; if (lv->top < 0) lv->top = 0; }
static int lv_ensure_cap(ListView *lv, int need) { if (need <= lv->cap) return 1; int nc = lv->cap ? lv->cap : 64; while (nc < need) nc *= 2; LvItem *ni = emu_alloc(sizeof(LvItem) * nc); if (!ni) return 0; e_memset(ni, 0, sizeof(LvItem) * nc); if (lv->it) { e_memcpy(ni, lv->it, sizeof(LvItem) * lv->n); emu_free(lv->it); } lv->it = ni; lv->cap = nc; return 1; }
static void lv_set_sub(LvItem *t, int col, const char *s) { if (col < 0 || col >= LV_MAXCOL) return; if (t->sub[col]) { emu_free(t->sub[col]); t->sub[col] = 0; } if (!s || !*s) return; size_t l = e_strlen(s); char *d = emu_alloc(l + 1); if (!d) return; e_memcpy(d, s, l + 1); t->sub[col] = d; }
static const char *lv_sub(ListView *lv, int k, int col) { if (k < 0 || k >= lv->n || col < 0 || col >= LV_MAXCOL) return ""; return lv->it[k].sub[col] ? lv->it[k].sub[col] : ""; }
static void lv_free_item(LvItem *t) { for (int q = 0; q < LV_MAXCOL; q++) if (t->sub[q]) emu_free(t->sub[q]); e_memset(t, 0, sizeof *t); }
/* owner-data / callback text cache for the rows on screen: odtext[(row - odtop) * odcols + col][96] */
static const char *lv_cell(Wnd *n, ListView *lv, int k, int col) { if (lv_ownerdata(n) || (k < lv->n && lv->it[k].cb)) { if (!lv->odtext || k < lv->odtop || k >= lv->odtop + lv->odrows || col >= lv->odcols) return ""; return lv->odtext + ((k - lv->odtop) * lv->odcols + col) * 96; } return lv_sub(lv, k, col); }
static u32 lv_state(Wnd *n, ListView *lv, int k) { if (lv_ownerdata(n)) { u32 s = 0; if (k == lv->focus) s |= 1; if (k >= 0 && k < lv->n && (lv->it[k].state & 2)) s |= 2; /* owner data keeps selection in a shadow array */ if (k >= 0 && k < lv->n) s |= lv->it[k].state & ~3u; return s; } return k >= 0 && k < lv->n ? (lv->it[k].state | (k == lv->focus ? 1 : 0)) : 0; }
static int lv_shadow(ListView *lv, int k) { if (k < 0) return 0; if (!lv_ensure_cap(lv, k + 1)) return 0; if (lv->n < k + 1) lv->n = k + 1; return 1; }
static int lv_col_x(ListView *lv, int col) { int x = 0; for (int q = 0; q < col && q < lv->ncol; q++) x += lv->col[q].cx; return x; }
static int lv_total_w(Wnd *n, ListView *lv, int i) { if (!lv_report(n)) return wnd_client_w(i); int x = lv_col_x(lv, lv->ncol); return x > 0 ? x : wnd_client_w(i); }
static void lv_paint_core(Cpu *c, int i, u64 hdc) { Win32 *w = W; Wnd *n = &g_wnd[i]; ListView *lv = n->cc; Surf s; if (!dc_surf(c, hdc, &s) || !lv) return; int cw = wnd_client_w(i), ch = wnd_client_h(i); int en = wnd_enabled_chain(i); u32 bg = lv->bk_set ? lv->bk : (en ? 0xffffff : 0xf0f0f0); fill_rect_px(&s, 0, 0, cw, ch, bg);
  GdiObj *d = cc_dc(w, hdc, n); int fh = cc_font_h(w, n); int ih = lv_item_h(w, n, lv), hh = lv_header_h(w, n); int cnt = lv_count(n, lv); lv_clamp_top(w, i, lv); int report = lv_report(n); int fullrow = (lv->exstyle & 0x20) != 0 || !report, grid = (lv->exstyle & 1) != 0, checks = (lv->exstyle & 4) != 0; ImgList *il = iml_of(report || (n->style & 3) ? lv->himl_small : lv->himl); if (!il && !report) il = iml_of(lv->himl_small);
  int sbw = cnt > lv_rows_full(w, i, lv) ? 12 : 0; int ncol = report ? (lv->ncol ? lv->ncol : 1) : 1;
  for (int r = lv->top, row = 0; r < cnt && hh + 1 + row * ih < ch; r++, row++) { int y = hh + 1 + row * ih; u32 st = lv_state(n, lv, r); int sel = (st & 2) != 0, foc = r == lv->focus && n->focus_draw; int x0 = 2; u32 hbg = n->focus_draw ? 0x0078d7 : (n->style & 8 /* SHOWSELALWAYS */ ? 0xcccccc : 0xcccccc); int hl = sel && (n->focus_draw || (n->style & 8));
    int x = x0; if (checks) { int on = ((st >> 12) & 0xF) == 2; int cy = y + ih / 2; fill_rect_px(&s, x, cy - 6, x + 13, cy + 7, 0xffffff); edge_rect(&s, x, cy - 6, x + 13, cy + 7, 0x333333, 0x333333); if (on) { line_px(&s, x + 3, cy, x + 5, cy + 3, 0); line_px(&s, x + 5, cy + 3, x + 10, cy - 3, 0); } x += 16; }
    int im = r < lv->n ? lv->it[r].image : -1; if (il && im >= 0 && im < il->n) { iml_draw(c, il, im, hdc, x, y + (ih - il->cy) / 2, 0, 0, 0); } if (il) x += il->cx + 3; int text_x0 = x + (r < lv->n ? lv->it[r].indent * 16 : 0);
    const char *t0 = lv_cell(n, lv, r, 0); int tw0 = text_width(w, n->font ? n->font : g_dlg_font, t0, (int)e_strlen(t0)) + 4; int rowr = fullrow ? (report ? lv_total_w(n, lv, i) : cw - 1 - sbw) : text_x0 + tw0; if (report && !fullrow && lv->ncol && rowr > lv->col[0].cx) rowr = lv->col[0].cx;
    if (hl) fill_rect_px(&s, fullrow ? 1 : text_x0 - 1, y, rowr, y + ih, hbg); else if (lv->tbk_set) fill_rect_px(&s, text_x0 - 1, y, rowr, y + ih, lv->tbk);
    for (int col = 0; col < ncol; col++) { int cx0 = report && lv->ncol ? lv_col_x(lv, col) : 0, cwid = report && lv->ncol ? lv->col[col].cx : cw; int tx = col == 0 ? text_x0 : cx0 + 4; const char *t = col == 0 ? t0 : lv_cell(n, lv, r, col); int tw = col == 0 ? tw0 - 4 : text_width(w, n->font ? n->font : g_dlg_font, t, (int)e_strlen(t)); int fmt = report && lv->ncol ? lv->col[col].fmt & 3 : 0; if (col > 0 && fmt == 1) tx = cx0 + cwid - 4 - tw; else if (col > 0 && fmt == 2) tx = cx0 + (cwid - tw) / 2; if (tx < cx0 + 2) tx = cx0 + 2;
      if (d) { Surf cs = s; int lim = report && lv->ncol ? cx0 + cwid - 2 : cw - sbw; if (lim < cs.w) cs.w = lim; cc_text(&cs, d, w, tx, y + (ih - fh) / 2, t, hl && n->focus_draw && (fullrow || col == 0) ? 0xffffff : !en ? 0x6d6d6d : lv->fg_set ? lv->fg : 0x000000); } }
    if (foc) { for (int xx = fullrow ? 1 : text_x0 - 1; xx < rowr; xx += 2) { if (y >= s.y0 && y < s.h) srow(&s, y)[xx] ^= 0xffffff; if (y + ih - 1 >= s.y0 && y + ih - 1 < s.h) srow(&s, y + ih - 1)[xx] ^= 0xffffff; } }
    if (grid && report) hline(&s, 0, cw - 1 - sbw, y + ih - 1, 0xe5e5e5); }
  if (grid && report) for (int col = 1; col <= lv->ncol; col++) { int x = lv_col_x(lv, col); if (x < cw) line_px(&s, x - 1, hh, x - 1, ch - 1, 0xe5e5e5); }
  if (hh) { fill_rect_px(&s, 0, 0, cw, hh, 0xffffff); hline(&s, 0, cw - 1, hh - 1, 0xe5e5e5); for (int col = 0; col < lv->ncol; col++) { int x = lv_col_x(lv, col), cwid = lv->col[col].cx; line_px(&s, x + cwid - 1, 2, x + cwid - 1, hh - 3, 0xe5e5e5); int tw = text_width(w, n->font ? n->font : g_dlg_font, lv->col[col].text, (int)e_strlen(lv->col[col].text)); int fmt = lv->col[col].fmt & 3; int tx = fmt == 1 ? x + cwid - 6 - tw : fmt == 2 ? x + (cwid - tw) / 2 : x + 6; if (tx < x + 2) tx = x + 2; if (d) { Surf cs = s; if (x + cwid - 2 < cs.w) cs.w = x + cwid - 2; cc_text(&cs, d, w, tx, (hh - fh) / 2, lv->col[col].text, 0x000000); } } }
  if (sbw) { int bar_y = hh + 1, bar_h = ch - hh - 2, fit = lv_rows_full(w, i, lv), th = fit * bar_h / (cnt ? cnt : 1); if (th < 8) th = 8; int ty = bar_y + lv->top * (bar_h - th) / (cnt - fit > 0 ? cnt - fit : 1); fill_rect_px(&s, cw - sbw, bar_y, cw - 1, ch - 1, 0xf0f0f0); fill_rect_px(&s, cw - sbw + 2, ty, cw - 3, ty + th, 0xcdcdcd); }
  if (!(n->exstyle & 0x200)) { u32 bc = !en ? 0xcccccc : 0x7a7a7a; edge_rect(&s, 0, 0, cw, ch, bc, bc); } }
/* --- notifications ---------------------------------------------------------------------------------------------- */
static u64 lv_item_sz(Cpu *c) { return c->mode32 ? 60 : 88; }
static int lv_parent_unicode(int i) { int p = g_wnd[i].parent; return p >= 0 && wnd_alive(p) ? g_wnd[p].unicode_wnd : 1; }
/* NMLISTVIEW: hdr, iItem, iSubItem, uNewState, uOldState, uChanged, ptAction, lParam */
static u64 lv_nm(Cpu *c, int i, ListView *lv, u32 code, int item, int sub, u32 nst, u32 ost, u32 changed) { Win32 *w = W; if (!lv->nmbuf) lv->nmbuf = w32_heap_alloc(w, 256, 1); u64 b = lv->nmbuf, P = cc_P(c); nm_hdr(c, b, i, code); u64 q = b + 3 * P; wr32(c, q, (u32)item); wr32(c, q + 4, (u32)sub); wr32(c, q + 8, nst); wr32(c, q + 12, ost); wr32(c, q + 16, changed); wr32(c, q + 20, (u32)g_mouse_x); wr32(c, q + 24, (u32)g_mouse_y); q += 28; q = (q + P - 1) & ~(P - 1); wrp(c, q, item >= 0 && item < lv->n ? lv->it[item].lparam : 0); wr32(c, q + P, 0); return b; }
static int lv_notify(Cpu *c, int i, u64 buf) { int p = g_wnd[i].parent; if (p < 0 || !wnd_alive(p)) return 0; w32_guest_call(c, g_wnd[p].wndproc, HWND_OF(p), 0x4E, g_wnd[i].id, buf); return 1; }
static void lv_nm_simple(Cpu *c, int i, u32 code, int item, int sub, u64 ret) { ListView *lv = lv_of(i); u64 b = lv_nm(c, i, lv, code, item, sub, 0, 0, 0); notify_parent_wm(c, i, 0x4E, g_wnd[i].id, b, ret); }
/* queued state changes → LVN_ITEMCHANGING (vetoable) / LVN_ITEMCHANGED.  CONT_LVCHG: data[0]=i data[1]=index into chg data[2]=phase data[3]=final ret */
static void lvchg_resume(Cpu *c, u64 rax);
static void lv_queue_state(ListView *lv, int item, u32 nst, u32 ost) { if (nst == ost || lv->nchg >= 16) return; lv->chg[lv->nchg].item = item; lv->chg[lv->nchg].nst = nst; lv->chg[lv->nchg].ost = ost; lv->nchg++; }
static void lv_apply_state(Wnd *n, ListView *lv, int item, u32 nst, u32 mask) { if (item < 0) return; if (lv_ownerdata(n)) { if (!lv_shadow(lv, item)) return; } else if (item >= lv->n) return; u32 cur = lv->it[item].state; u32 nw = (cur & ~mask) | (nst & mask); if (mask & 1) { if (nst & 1) lv->focus = item; else if (lv->focus == item) lv->focus = -1; } lv->it[item].state = nw & ~1u; }
static void lvclick_resume(Cpu *c, u64 rax);
static void lv_flush(Cpu *c, int i, u64 ret) { Win32 *w = W; ListView *lv = lv_of(i); if (!lv->nchg) { wnd_invalidate(i, 1); if (w->ncont && w->cont[w->ncont - 1].kind == CONT_LVCLICK && (int)w->cont[w->ncont - 1].data[0] == i && w->cont[w->ncont - 1].seq == w->cont_seq) lvclick_resume(c, ret); else RET(ret); return; } w32_push_cont(c, CONT_LVCHG, (u64)i); w->cont[w->ncont - 1].data[1] = 0; w->cont[w->ncont - 1].data[2] = 0; w->cont[w->ncont - 1].data[3] = ret; lvchg_resume(c, 0); }
static void lvchg_resume(Cpu *c, u64 rax) { Win32 *w = W; int ci = w->ncont - 1; int i = (int)w->cont[ci].data[0]; if (!wnd_alive(i) || !g_wnd[i].cc) { w32_cont_finish(c, w->cont[ci].data[3]); return; } ListView *lv = lv_of(i); Wnd *n = &g_wnd[i]; int k = (int)w->cont[ci].data[1]; int phase = (int)w->cont[ci].data[2];
  for (;;) { if (k >= lv->nchg) { lv->nchg = 0; wnd_invalidate(i, 1); w32_cont_finish(c, w->cont[ci].data[3]); return; }
    if (phase == 1) { /* LVN_ITEMCHANGING answered: non-zero vetoes */ if ((u32)rax) { k++; phase = 0; rax = 0; continue; } lv_apply_state(n, lv, lv->chg[k].item, lv->chg[k].nst, lv->chg[k].nst ^ lv->chg[k].ost ? (lv->chg[k].nst ^ lv->chg[k].ost) : 0xffffffffu); w->cont[ci].data[1] = (u64)k; w->cont[ci].data[2] = 2; u64 b = lv_nm(c, i, lv, (u32)-101, lv->chg[k].item, 0, lv->chg[k].nst, lv->chg[k].ost, 8); if (lv_notify(c, i, b)) return; phase = 2; rax = 0; continue; }
    if (phase == 2) { k++; phase = 0; continue; }
    w->cont[ci].data[1] = (u64)k; w->cont[ci].data[2] = 1; u64 b = lv_nm(c, i, lv, (u32)-100, lv->chg[k].item, 0, lv->chg[k].nst, lv->chg[k].ost, 8); if (lv_notify(c, i, b)) return; phase = 1; rax = 0; } }
/* select helpers: build the change queue, then flush */
static void lv_select_only(Wnd *n, ListView *lv, int item) { int cnt = lv_count(n, lv); for (int k = 0; k < lv->n && k < cnt; k++) if (k != item && (lv->it[k].state & 2)) lv_queue_state(lv, k, lv->it[k].state & ~2u, lv->it[k].state | (k == lv->focus ? 1 : 0)); if (item >= 0) { u32 ost = lv_state(n, lv, item); lv_queue_state(lv, item, (ost | 3) , ost); } lv->focus = item; lv->mark = item; }
/* LVN_GETDISPINFO prefetch for the visible rows (owner data or callback items).  CONT_LVDISP: data[0]=i data[1]=row data[2]=col */
static void lvdisp_resume(Cpu *c, u64 rax);
static int lv_prefetch(Cpu *c, int i, int push) { Win32 *w = W; Wnd *n = &g_wnd[i]; ListView *lv = lv_of(i); int cnt = lv_count(n, lv); lv_clamp_top(w, i, lv); int rows = lv_rows_fit(w, i, lv), cols = lv_report(n) && lv->ncol ? lv->ncol : 1; if (cols > LV_MAXCOL) cols = LV_MAXCOL; int p = g_wnd[i].parent; if (p < 0 || !wnd_alive(p)) return 0;
  if (!lv->odtext || lv->odrows != rows || lv->odcols != cols || lv->odtop != lv->top) { if (lv->odtext) emu_free(lv->odtext); if (lv->odgot) emu_free(lv->odgot); lv->odtext = emu_alloc((size_t)rows * cols * 96); lv->odgot = emu_alloc((size_t)rows * cols); if (!lv->odtext || !lv->odgot) return 0; e_memset(lv->odtext, 0, (size_t)rows * cols * 96); e_memset(lv->odgot, 0, (size_t)rows * cols); lv->odrows = rows; lv->odcols = cols; lv->odtop = lv->top; }
  for (int r = lv->top; r < cnt && r < lv->top + rows; r++) { int need = lv_ownerdata(n) || (r < lv->n && lv->it[r].cb); if (!need) continue; for (int col = 0; col < cols; col++) { int idx = (r - lv->top) * cols + col; if (lv->odgot[idx]) continue; lv->odgot[idx] = 1;
      if (push) { w32_push_cont(c, CONT_LVDISP, (u64)i); push = 0; } w->cont[w->ncont - 1].data[1] = (u64)r; w->cont[w->ncont - 1].data[2] = (u64)col; if (!lv->nmbuf) lv->nmbuf = w32_heap_alloc(w, 256, 1); if (!lv->txtbuf) lv->txtbuf = w32_heap_alloc(w, 1040, 1); u64 b = lv->nmbuf, P = cc_P(c); int uni = lv_parent_unicode(i); nm_hdr(c, b, i, uni ? (u32)-177 : (u32)-150); u64 it = b + 3 * P; for (u64 q = 0; q < lv_item_sz(c); q += 4) wr32(c, it + q, 0);
      u32 mask = 1 | (col == 0 ? 2 : 0) | (lv_ownerdata(n) ? 8 | 0x10 /* STATE | INDENT */ : 0); wr32(c, it, mask); wr32(c, it + 4, (u32)r); wr32(c, it + 8, (u32)col); wr32(c, it + 16, 0xffffu); u64 pt = it + (c->mode32 ? 20 : 24); wrp(c, pt, lv->txtbuf); wr32(c, pt + P, 512); wr32(c, pt + P + 4, (u32)-1); wrp(c, pt + P + 8, r < lv->n ? lv->it[r].lparam : 0); wr16(c, lv->txtbuf, 0); wr8(c, lv->txtbuf, 0);
      w32_guest_call(c, g_wnd[p].wndproc, HWND_OF(p), 0x4E, g_wnd[i].id, b); return 1; } }
  if (!push) { /* we are inside the continuation and nothing more to fetch */ return 0; } return 0; }
static void lvdisp_resume(Cpu *c, u64 rax) { Win32 *w = W; int ci = w->ncont - 1; int i = (int)w->cont[ci].data[0]; (void)rax; if (!wnd_alive(i) || !g_wnd[i].cc) { w32_cont_finish(c, 0); return; } ListView *lv = lv_of(i); Wnd *n = &g_wnd[i]; int r = (int)w->cont[ci].data[1], col = (int)w->cont[ci].data[2];
  if (lv->odtext && r >= lv->odtop && r < lv->odtop + lv->odrows && col < lv->odcols) { u64 P = cc_P(c); u64 it = lv->nmbuf + 3 * P; u32 mask = rd32(c, it); u64 pt = it + (c->mode32 ? 20 : 24); u64 txt = rdp(c, pt); int uni = lv_parent_unicode(i); char *dst = lv->odtext + ((r - lv->odtop) * lv->odcols + col) * 96; if ((mask & 1) && txt && txt != (u64)(u32)-1) text_in(c, txt, uni, dst, 96); if ((mask & 2) && col == 0 && lv_shadow(lv, r)) lv->it[r].image = (int)(s32)rd32(c, pt + P + 4); if ((mask & 8) && lv_ownerdata(n) && lv_shadow(lv, r)) { u32 st = rd32(c, it + 12); lv->it[r].state = (lv->it[r].state & ~0xF000u) | (st & 0xF000u); } }
  if (lv_prefetch(c, i, 0)) return; u64 hdc = ctl_paint_begin(c, i); if (hdc) { lv_paint_core(c, i, hdc); ctl_paint_end(c, i, hdc); } w32_cont_finish(c, 0); }
static void lv_invalidate_cache(ListView *lv) { if (lv->odgot) e_memset(lv->odgot, 0, (size_t)lv->odrows * lv->odcols); }
/* --- item / column I/O ---------------------------------------------------------------------------------------------- */
/* LVITEM: mask@0 iItem@4 iSubItem@8 state@12 stateMask@16 pszText@20/24 cchTextMax@24/32 iImage@28/36 lParam@32/40 iIndent@36/48 */
static void lv_item_io(Cpu *c, int i, ListView *lv, int k, u64 it, int set, int wide) { Wnd *n = &g_wnd[i]; u32 mask = rd32(c, it); int sub = (int)(s32)rd32(c, it + 8); if (sub < 0 || sub >= LV_MAXCOL) sub = 0; u64 P = cc_P(c); u64 pt = it + (c->mode32 ? 20 : 24), pcch = pt + P, pimg = pt + P + 4, plp = pt + P + 8, pind = plp + P;
  if (set) { LvItem *t = &lv->it[k]; if (mask & 1) { u64 tp = rdp(c, pt); if (tp == (u64)(u32)-1 || tp == (u64)-1) { t->cb = 1; lv_invalidate_cache(lv); } else { char buf[512]; text_in(c, tp, wide, buf, sizeof buf); lv_set_sub(t, sub, buf); } } if (sub == 0) { if (mask & 2) t->image = (int)(s32)rd32(c, pimg); if (mask & 4) t->lparam = rdp(c, plp); if (mask & 0x10) t->indent = (int)(s32)rd32(c, pind); if (mask & 8) { u32 sm = rd32(c, it + 16), sv = rd32(c, it + 12); u32 ost = lv_state(n, lv, k), nst = (ost & ~sm) | (sv & sm); if (sm & 3) lv_queue_state(lv, k, nst, ost); else lv_apply_state(n, lv, k, nst, sm); } } wnd_invalidate(i, 1); return; }
  const char *txt = lv_cell(n, lv, k, sub); if (mask & 1) { u64 tp = rdp(c, pt); u32 cch = rd32(c, pcch); if (tp && cch) text_out_cap(c, tp, txt, cch, wide); } if (sub == 0 || 1) { if (mask & 2) wr32(c, pimg, (u32)(k < lv->n ? lv->it[k].image : -1)); if (mask & 4) wrp(c, plp, k < lv->n ? lv->it[k].lparam : 0); if (mask & 0x10) wr32(c, pind, (u32)(k < lv->n ? lv->it[k].indent : 0)); if (mask & 8) wr32(c, it + 12, lv_state(n, lv, k) & rd32(c, it + 16)); } }
/* LVCOLUMN: mask@0 fmt@4 cx@8 pszText@12/16 cchTextMax@16/24 iSubItem@20/28 iImage@24/32 iOrder@28/36 */
static void lv_col_io(Cpu *c, ListView *lv, int col, u64 lc, int set, int wide) { u32 mask = rd32(c, lc); u64 P = cc_P(c); u64 pt = lc + (c->mode32 ? 12 : 16), pcch = pt + P, psub = pt + P + 4, pimg = pt + P + 8, pord = pt + P + 12; LvCol *cc = &lv->col[col];
  if (set) { if (mask & 1) cc->fmt = (int)(s32)rd32(c, lc + 4); if (mask & 2) cc->cx = (int)(s32)rd32(c, lc + 8); if (mask & 4) { u64 tp = rdp(c, pt); if (tp && tp != (u64)(u32)-1) text_in(c, tp, wide, cc->text, sizeof cc->text); } if (mask & 0x10) cc->image = (int)(s32)rd32(c, pimg); (void)psub; (void)pord; return; }
  if (mask & 1) wr32(c, lc + 4, (u32)cc->fmt); if (mask & 2) wr32(c, lc + 8, (u32)cc->cx); if (mask & 4) { u64 tp = rdp(c, pt); u32 cch = rd32(c, pcch); if (tp && cch) text_out_cap(c, tp, cc->text, cch, wide); } if (mask & 8) wr32(c, psub, (u32)col); if (mask & 0x10) wr32(c, pimg, (u32)cc->image); if (mask & 0x20) wr32(c, pord, (u32)col); }
static int lv_hit(Cpu *c, int i, ListView *lv, int x, int y, u32 *flags, int *psub) { Win32 *w = W; Wnd *n = &g_wnd[i]; int hh = lv_header_h(w, n), ih = lv_item_h(w, n, lv); int cnt = lv_count(n, lv); *flags = 1; if (psub) *psub = 0; if (y < hh) { *flags = 1; return -1; } int r = lv->top + (y - hh - 1) / ih; if (y < hh + 1 || r < 0 || r >= cnt) { *flags = 1; return -1; }
  int col = 0; if (lv_report(n) && lv->ncol) { int cx = 0; for (col = 0; col < lv->ncol; col++) { if (x < cx + lv->col[col].cx) break; cx += lv->col[col].cx; } if (col >= lv->ncol) { *flags = 8; if (psub) *psub = lv->ncol - 1; return r; } } if (psub) *psub = col;
  if (col == 0) { int tx = 2; if (lv->exstyle & 4) { if (x < tx + 16) { *flags = 8; return r; } tx += 16; } ImgList *il = iml_of(lv_report(n) || (n->style & 3) ? lv->himl_small : lv->himl); if (il) { if (x < tx + il->cx + 3) { *flags = 2; return r; } tx += il->cx + 3; } const char *t = lv_cell(n, lv, r, 0); int tw = text_width(w, n->font ? n->font : g_dlg_font, t, (int)e_strlen(t)) + 4; *flags = x < tx + tw || (lv->exstyle & 0x20) ? 4 : 8; (void)c; return r; }
  *flags = 4; return r; }
/* LVM_SORTITEMS(EX): insertion sort with guest comparisons.  CONT_LVSORT: data[0]=i data[1]=sort_i data[2]=sort_j data[3]=phase */
static void lvsort_resume(Cpu *c, u64 rax);
static void lv_sort_step(Cpu *c, int i) { Win32 *w = W; ListView *lv = lv_of(i); int ci = w->ncont - 1; for (;;) { if (lv->sort_i >= lv->n) { lv_invalidate_cache(lv); wnd_invalidate(i, 1); w32_cont_finish(c, 1); return; } if (lv->sort_j <= 0) { lv->sort_i++; lv->sort_j = lv->sort_i; continue; } int a = lv->sort_j - 1, b = lv->sort_j; w->cont[ci].data[1] = (u64)lv->sort_i; w->cont[ci].data[2] = (u64)lv->sort_j; u64 pa = lv->sortex ? (u64)a : lv->it[a].lparam, pb = lv->sortex ? (u64)b : lv->it[b].lparam; w32_guest_call(c, lv->sortfn, pa, pb, lv->sortlp, 0); return; } }
static void lvsort_resume(Cpu *c, u64 rax) { Win32 *w = W; int ci = w->ncont - 1; int i = (int)w->cont[ci].data[0]; if (!wnd_alive(i) || !g_wnd[i].cc) { w32_cont_finish(c, 0); return; } ListView *lv = lv_of(i); int a = lv->sort_j - 1, b = lv->sort_j; if ((s32)(u32)rax > 0) { LvItem t = lv->it[a]; lv->it[a] = lv->it[b]; lv->it[b] = t; if (lv->focus == a) lv->focus = b; else if (lv->focus == b) lv->focus = a; lv->sort_j--; } else { lv->sort_j = 0; } lv_sort_step(c, i); }
static void s_NebulaListViewProc(Cpu *c) { int i = wnd_of(ARG(0)); if (i < 0) { RET(0); return; } SUPER_ADOPT(i, BI_LIST); u32 msg = (u32)ARG(1); u64 wp = ARG(2), lp = ARG(3); Wnd *n = &g_wnd[i]; Win32 *w = W; ListView *lv = n->cc;

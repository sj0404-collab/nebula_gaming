/* treeview.inc — comctl32 SysTreeView32 (included from gdi.c after comctl.inc; shares the Wnd/cc pattern of the tab control).
   Items live in a per-control pool; HTREEITEM = TV_HBASE | (window << 12) | (slot + 1).  Supports TVM_INSERTITEM/DELETEITEM/EXPAND/
   GETNEXTITEM (all TVGN_*)/SELECTITEM/GETITEM/SETITEM/GETITEMRECT/HITTEST/ENSUREVISIBLE/SORTCHILDREN/GETCOUNT/GETVISIBLECOUNT/
   indent/item height/image lists/colours, TVS_HASBUTTONS/HASLINES/LINESATROOT/FULLROWSELECT/CHECKBOXES (state images),
   LPSTR_TEXTCALLBACK through TVN_GETDISPINFO, TVN_SELCHANGING/SELCHANGED (vetoable), TVN_ITEMEXPANDING/ITEMEXPANDED (vetoable),
   NM_CLICK/NM_DBLCLK/NM_RCLICK/NM_RETURN/TVN_KEYDOWN, keyboard navigation and an internal vertical scrollbar.  No label editing,
   no drag images, no custom draw (NM_CUSTOMDRAW is not sent: items are drawn by the emulator). */
#define TV_MAX 1024
#define TV_HBASE 0x54500000ull   /* bits 12..19: window index (< 256), bits 0..11: slot + 1 */
typedef struct { u8 used, expanded, cb_text, fetched; int parent, first, next; int image, selimage, children; u32 state; u64 lparam; char text[96]; } TvItem;
typedef struct { TvItem *it; int cap, count; int sel, hot, top; int indent, itemh; u64 himl, himl_state; u32 bk, fg, line; int bk_set, fg_set; int vis_n, vis_cap; int *vis; u64 nmbuf; int pending, pending_action, pending_phase; u64 drop; int sel_image_w; } TreeView;
static TreeView *tv_of(int i) { return g_wnd[i].cc; }
static u64 tv_h(int i, int k) { return k < 0 ? 0 : TV_HBASE | ((u64)i << 12) | (u64)(k + 1); }
static int tv_k(int i, TreeView *tv, u64 h) { if (!tv || !tv->it || ((u32)h >> 20) != (u32)(TV_HBASE >> 20) || (int)((h >> 12) & 0xFF) != i) return -1; int k = (int)(h & 0xFFF) - 1; return (k >= 0 && k < tv->cap && tv->it[k].used) ? k : -1; }
static void e_memset_guest(Cpu *c, u64 a, int v, u64 n) { for (u64 q = 0; q < n; q++) wr8(c, a + q, (u8)v); }
static int tv_is_root(u64 h) { u32 l = (u32)h; return h == 0 || l == 0xFFFF0000u; }   /* TVI_ROOT (sign-extended on x64) */
/* root chain: tv->root holds the first root item; we keep it in it[].parent == -1 and link via next. */
static int tv_root(TreeView *tv) { return tv->hot; }   /* hot is reused as "first root" (we do not track hover) */
static int tv_prev(TreeView *tv, int k) { int p = tv->it[k].parent; int q = p < 0 ? tv_root(tv) : tv->it[p].first; if (q == k) return -1; while (q >= 0 && tv->it[q].next != k) q = tv->it[q].next; return q; }
static int tv_level(TreeView *tv, int k) { int l = 0; for (int p = tv->it[k].parent; p >= 0; p = tv->it[p].parent) l++; return l; }
static void tv_flatten_rec(TreeView *tv, int k) { for (; k >= 0; k = tv->it[k].next) { if (tv->vis_n >= tv->vis_cap) return; tv->vis[tv->vis_n++] = k; if (tv->it[k].expanded && tv->it[k].first >= 0) tv_flatten_rec(tv, tv->it[k].first); } }
static void tv_flatten(TreeView *tv) { if (!tv->vis) { tv->vis_cap = TV_MAX; tv->vis = emu_alloc(sizeof(int) * TV_MAX); } tv->vis_n = 0; if (tv->vis) tv_flatten_rec(tv, tv_root(tv)); }
static int tv_row_of(TreeView *tv, int k) { for (int r = 0; r < tv->vis_n; r++) if (tv->vis[r] == k) return r; return -1; }
static int tv_item_h(Win32 *w, Wnd *n, TreeView *tv) { if (tv->itemh > 0) return tv->itemh; int h = cc_font_h(w, n) + 3; ImgList *il = iml_of(tv->himl); if (il && il->cy + 2 > h) h = il->cy + 2; if (h < 16) h = 16; return h; }
static int tv_rows_fit(int i, int ih) { int ch = wnd_client_h(i) - 2; return ih > 0 ? (ch > 0 ? ch / ih : 1) : 1; }
static int tv_has_buttons(Wnd *n) { return (n->style & 0x1) != 0; }   /* TVS_HASBUTTONS 1, HASLINES 2, LINESATROOT 4, SHOWSELALWAYS 0x20, CHECKBOXES 0x100, FULLROWSELECT 0x1000 */
static int tv_content_x(Wnd *n, TreeView *tv, int k) { int lvl = tv_level(tv, k); int x = 4 + lvl * tv->indent; if ((n->style & 0x5) && (lvl > 0 || (n->style & 0x4))) x += tv->indent; return x; }
static int tv_vsb_w(int i, TreeView *tv, int ih) { return tv->vis_n > tv_rows_fit(i, ih) ? 12 : 0; }
static void tv_clamp_top(int i, TreeView *tv, int ih) { int fit = tv_rows_fit(i, ih); if (tv->top > tv->vis_n - fit) tv->top = tv->vis_n - fit; if (tv->top < 0) tv->top = 0; }
static void tv_ensure_visible(Cpu *c, int i, TreeView *tv, int k) { for (int p = tv->it[k].parent; p >= 0; p = tv->it[p].parent) tv->it[p].expanded = 1; tv_flatten(tv); int ih = tv_item_h(W, &g_wnd[i], tv); int fit = tv_rows_fit(i, ih); int r = tv_row_of(tv, k); if (r < 0) return; if (r < tv->top) tv->top = r; else if (r >= tv->top + fit) tv->top = r - fit + 1; tv_clamp_top(i, tv, ih); }
static void tv_text_of(TreeView *tv, int k, char *out, size_t cap) { e_snprintf(out, cap, "%s", tv->it[k].text); }
static void tv_paint_core(Cpu *c, int i, u64 hdc) { Win32 *w = W; Wnd *n = &g_wnd[i]; TreeView *tv = n->cc; Surf s; if (!dc_surf(c, hdc, &s) || !tv) return; int cw = wnd_client_w(i), ch = wnd_client_h(i); int en = wnd_enabled_chain(i); u32 bg = tv->bk_set ? tv->bk : (en ? 0xffffff : 0xf0f0f0); fill_rect_px(&s, 0, 0, cw, ch, bg);
  GdiObj *d = cc_dc(w, hdc, n); int fh = cc_font_h(w, n); int ih = tv_item_h(w, n, tv); tv_flatten(tv); tv_clamp_top(i, tv, ih); int sbw = tv_vsb_w(i, tv, ih); int right = cw - 1 - sbw; ImgList *il = iml_of(tv->himl), *ils = iml_of(tv->himl_state); int lines = (n->style & 0x2) != 0, buttons = tv_has_buttons(n), fullrow = (n->style & 0x1000) != 0, checks = (n->style & 0x100) != 0; u32 lc = tv->line ? tv->line : 0x808080;
  for (int r = tv->top, row = 0; r < tv->vis_n && row * ih < ch - 1; r++, row++) { int k = tv->vis[r]; TvItem *t = &tv->it[k]; int y = 1 + row * ih, cy = y + ih / 2; int cx = tv_content_x(n, tv, k); int lvl = tv_level(tv, k); int sel = k == tv->sel; int drop = tv->drop && tv_k(i, tv, tv->drop) == k;
    if (lines) { /* dotted connectors: vertical for every ancestor that has a following sibling, elbow for this item */ for (int a = k, L = lvl; L >= 0; L--, a = tv->it[a].parent) { if (a < 0) break; int ax = 4 + L * tv->indent + tv->indent / 2; if (!(n->style & 0x4) && L == 0) continue; if (a == k) { for (int yy = (tv_prev(tv, k) >= 0 || tv->it[k].parent >= 0 || r > 0 ? y : cy); yy < (t->next >= 0 ? y + ih : cy + 1); yy += 2) if (yy >= s.y0 && yy < s.h && ax >= 0) srow(&s, yy)[ax] = lc; for (int xx = ax; xx < cx - 2; xx += 2) if (cy >= s.y0 && cy < s.h) srow(&s, cy)[xx] = lc; } else if (tv->it[a].next >= 0) { for (int yy = y; yy < y + ih; yy += 2) if (yy >= s.y0 && yy < s.h) srow(&s, yy)[ax] = lc; } } }
    if (buttons && t->first >= 0 && (lvl > 0 || (n->style & 0x4))) { int bx = 4 + lvl * tv->indent + tv->indent / 2 - 4, by = cy - 4; fill_rect_px(&s, bx, by, bx + 9, by + 9, 0xffffff); edge_rect(&s, bx, by, bx + 9, by + 9, 0x919191, 0x919191); hline(&s, bx + 2, bx + 6, cy, 0x000000); if (!t->expanded) line_px(&s, bx + 4, by + 2, bx + 4, by + 6, 0x000000); }
    int tx = cx; if (checks && ils) { int si = (int)((t->state >> 12) & 0xF) - 1; if (si >= 0) iml_draw(c, ils, si, hdc, tx, cy - ils->cy / 2, 0, 0, 0); tx += ils->cx + 3; } else if (checks) { int on = ((t->state >> 12) & 0xF) == 2; fill_rect_px(&s, tx, cy - 6, tx + 13, cy + 7, 0xffffff); edge_rect(&s, tx, cy - 6, tx + 13, cy + 7, 0x333333, 0x333333); if (on) { line_px(&s, tx + 3, cy, tx + 5, cy + 3, 0); line_px(&s, tx + 5, cy + 3, tx + 10, cy - 3, 0); } tx += 16; }
    if (il) { int im = sel && t->selimage >= 0 ? t->selimage : t->image; if (im >= 0 && im < il->n) iml_draw(c, il, im, hdc, tx, cy - il->cy / 2, 0, 0, 0); tx += il->cx + 3; }
    char txt[96]; tv_text_of(tv, k, txt, sizeof txt); int tw = text_width(w, n->font ? n->font : g_dlg_font, txt, (int)e_strlen(txt)) + 4; int hl = (sel && (n->focus_draw || (n->style & 0x20))) || drop; u32 hbg = n->focus_draw || drop ? 0x0078d7 : 0xcccccc; if (hl) fill_rect_px(&s, fullrow ? 1 : tx - 1, y, fullrow ? right : tx + tw, y + ih, hbg);
    if (d) cc_text(&s, d, w, tx + 1, y + (ih - fh) / 2, txt, hl && (n->focus_draw || drop) ? 0xffffff : !en ? 0x6d6d6d : tv->fg_set ? tv->fg : 0x000000); if (sel && n->focus_draw && !fullrow) { /* focus rectangle */ for (int xx = tx - 1; xx < tx + tw; xx += 2) { if (y >= s.y0 && y < s.h) srow(&s, y)[xx] ^= 0xffffff; if (y + ih - 1 >= s.y0 && y + ih - 1 < s.h) srow(&s, y + ih - 1)[xx] ^= 0xffffff; } } }
  if (sbw) { int bar_h = ch - 2, fit = tv_rows_fit(i, ih), th = fit * bar_h / (tv->vis_n ? tv->vis_n : 1); if (th < 8) th = 8; int ty = 1 + tv->top * (bar_h - th) / (tv->vis_n - fit > 0 ? tv->vis_n - fit : 1); fill_rect_px(&s, cw - sbw, 1, cw - 1, ch - 1, 0xf0f0f0); fill_rect_px(&s, cw - sbw + 2, ty, cw - 3, ty + th, 0xcdcdcd); }
  if (!(n->exstyle & 0x200) && !(n->style & 0x800000)) { } u32 bc = !en ? 0xcccccc : 0x7a7a7a; edge_rect(&s, 0, 0, cw, ch, bc, bc); }
/* --- notifications ------------------------------------------------------------------------------------------------- */
static int tv_parent_unicode(int i) { int p = g_wnd[i].parent; return p >= 0 && wnd_alive(p) ? g_wnd[p].unicode_wnd : 1; }
static u64 tv_item_sz(Cpu *c) { return c->mode32 ? 40 : 56; }
static void tv_write_item(Cpu *c, int i, TreeView *tv, u64 p, int k) { /* TVITEM with mask HANDLE|STATE|PARAM (+IMAGE/SELECTEDIMAGE) */ u64 P = cc_P(c); e_memset_guest(c, p, 0, tv_item_sz(c)); if (k < 0) return; TvItem *t = &tv->it[k]; wr32(c, p, 0x10 | 0x8 | 0x4 | 0x2 | 0x20 | 0x40); wrp(c, p + P, tv_h(i, k)); u64 st = p + 2 * P; wr32(c, st, t->state | (t->expanded ? 0x20 : 0) | (k == tv->sel ? 2 : 0)); wr32(c, st + 4, 0xffffffffu); u64 q = st + 8; q = (q + P - 1) & ~(P - 1); /* pszText */ q += P; wr32(c, q, 0); wr32(c, q + 4, (u32)t->image); wr32(c, q + 8, (u32)t->selimage); wr32(c, q + 12, (u32)(t->first >= 0 ? 1 : t->children)); q += 16; q = (q + P - 1) & ~(P - 1); wrp(c, q, t->lparam); }
static u64 tv_nm(Cpu *c, int i, TreeView *tv, u32 code, int action, int kold, int knew) { Win32 *w = W; if (!tv->nmbuf) tv->nmbuf = w32_heap_alloc(w, 192, 1); u64 b = tv->nmbuf; u64 P = cc_P(c); nm_hdr(c, b, i, code); u64 q = b + 3 * P; wr32(c, q, (u32)action); q += P; tv_write_item(c, i, tv, q, kold); q += tv_item_sz(c); tv_write_item(c, i, tv, q, knew); q += tv_item_sz(c); wr32(c, q, (u32)g_mouse_x); wr32(c, q + 4, (u32)g_mouse_y); return b; }
static int tv_notify(Cpu *c, int i, u64 buf) { int p = g_wnd[i].parent; if (p < 0 || !wnd_alive(p)) return 0; w32_guest_call(c, g_wnd[p].wndproc, HWND_OF(p), 0x4E, g_wnd[i].id, buf); return 1; }
/* selection: TVN_SELCHANGING (veto) → change → TVN_SELCHANGED.  Continuation CONT_TVSEL data[0]=i data[1]=phase */
static void tvsel_resume(Cpu *c, u64 rax);
static void tv_select(Cpu *c, int i, int k, int action) { Win32 *w = W; TreeView *tv = tv_of(i); if (k == tv->sel) { RET(1); return; } tv->pending = k; tv->pending_action = action; w32_push_cont(c, CONT_TVSEL, (u64)i); w->cont[w->ncont - 1].data[1] = 0; int uni = tv_parent_unicode(i); u64 b = tv_nm(c, i, tv, uni ? (u32)-450 : (u32)-401, action, tv->sel, k); if (!tv_notify(c, i, b)) tvsel_resume(c, 0); }
static void tvsel_resume(Cpu *c, u64 rax) { Win32 *w = W; int ci = w->ncont - 1; int i = (int)w->cont[ci].data[0]; if (!wnd_alive(i) || !g_wnd[i].cc) { w32_cont_finish(c, 0); return; } TreeView *tv = tv_of(i);
  if (w->cont[ci].data[1] == 1) { w32_cont_finish(c, 1); return; }   /* TVN_SELCHANGED answered */
  if ((u32)rax) { tv->pending = -1; w32_cont_finish(c, 0); return; }   /* vetoed */
  int old = tv->sel; tv->sel = tv->pending; tv->pending = -1; if (tv->sel >= 0) tv_ensure_visible(c, i, tv, tv->sel); wnd_invalidate(i, 1); w->cont[ci].data[1] = 1; int uni = tv_parent_unicode(i); u64 b = tv_nm(c, i, tv, uni ? (u32)-451 : (u32)-402, tv->pending_action, old, tv->sel); if (!tv_notify(c, i, b)) w32_cont_finish(c, 1); }
/* expand/collapse by the user: TVN_ITEMEXPANDING (veto) → toggle → TVN_ITEMEXPANDED.  CONT_TVEXP data[0]=i data[1]=phase data[2]=k data[3]=action */
static void tvexp_resume(Cpu *c, u64 rax);
static void tv_expand_ui(Cpu *c, int i, int k, int expand) { Win32 *w = W; TreeView *tv = tv_of(i); if (tv->it[k].first < 0 && tv->it[k].children <= 0) { RET(0); return; } w32_push_cont(c, CONT_TVEXP, (u64)i); w->cont[w->ncont - 1].data[1] = 0; w->cont[w->ncont - 1].data[2] = (u64)k; w->cont[w->ncont - 1].data[3] = expand ? 2 : 1; int uni = tv_parent_unicode(i); u64 b = tv_nm(c, i, tv, uni ? (u32)-454 : (u32)-405, expand ? 2 : 1, -1, k); if (!tv_notify(c, i, b)) tvexp_resume(c, 0); }
static void tvexp_resume(Cpu *c, u64 rax) { Win32 *w = W; int ci = w->ncont - 1; int i = (int)w->cont[ci].data[0]; if (!wnd_alive(i) || !g_wnd[i].cc) { w32_cont_finish(c, 0); return; } TreeView *tv = tv_of(i); int k = (int)w->cont[ci].data[2]; int action = (int)w->cont[ci].data[3];
  if (w->cont[ci].data[1] == 1) { w32_cont_finish(c, 1); return; } if ((u32)rax || k < 0 || k >= tv->cap || !tv->it[k].used) { w32_cont_finish(c, 0); return; }
  tv->it[k].expanded = action == 2; tv->it[k].state |= 0x40; tv_flatten(tv); if (tv->sel >= 0 && tv_row_of(tv, tv->sel) < 0) { /* the selection collapsed away: select the collapsed parent */ tv->sel = k; } wnd_invalidate(i, 1); w->cont[ci].data[1] = 1; int uni = tv_parent_unicode(i); u64 b = tv_nm(c, i, tv, uni ? (u32)-455 : (u32)-406, action, -1, k); if (!tv_notify(c, i, b)) w32_cont_finish(c, 1); }
/* LPSTR_TEXTCALLBACK: fetch texts of the visible rows through TVN_GETDISPINFO before painting.  CONT_TVDISP data[0]=i data[1]=k */
static int tv_prefetch(Cpu *c, int i, int push) { Win32 *w = W; TreeView *tv = tv_of(i); tv_flatten(tv); int ih = tv_item_h(w, &g_wnd[i], tv); int fit = tv_rows_fit(i, ih) + 1; for (int r = tv->top; r < tv->vis_n && r < tv->top + fit; r++) { int k = tv->vis[r]; TvItem *t = &tv->it[k]; if (!t->cb_text || t->fetched) continue; int p = g_wnd[i].parent; if (p < 0 || !wnd_alive(p)) { t->fetched = 1; continue; }
      if (push) w32_push_cont(c, CONT_TVDISP, (u64)i); w->cont[w->ncont - 1].data[1] = (u64)k; if (!tv->nmbuf) tv->nmbuf = w32_heap_alloc(w, 192, 1); if (!tv->sel_image_w) tv->sel_image_w = (int)w32_heap_alloc(w, 520, 1); u64 b = tv->nmbuf; u64 P = cc_P(c); int uni = tv_parent_unicode(i); nm_hdr(c, b, i, uni ? (u32)-452 : (u32)-403); u64 it = b + 3 * P; e_memset_guest(c, it, 0, tv_item_sz(c)); wr32(c, it, 0x1 | 0x10); wrp(c, it + P, tv_h(i, k)); u64 st = it + 2 * P, q = (st + 8 + P - 1) & ~(P - 1); wrp(c, q, (u64)(u32)tv->sel_image_w); wr32(c, q + P, 256); wr32(c, q + P + 4, (u32)t->image); wr32(c, q + P + 8, (u32)t->selimage); wr32(c, q + P + 12, (u32)t->children); q = (q + P + 16 + P - 1) & ~(P - 1); wrp(c, q, t->lparam);
      w32_guest_call(c, g_wnd[p].wndproc, HWND_OF(p), 0x4E, g_wnd[i].id, b); return 1; } return 0; }
static void tvdisp_resume(Cpu *c, u64 rax) { Win32 *w = W; int ci = w->ncont - 1; int i = (int)w->cont[ci].data[0]; (void)rax; if (!wnd_alive(i) || !g_wnd[i].cc) { w32_cont_finish(c, 0); return; } TreeView *tv = tv_of(i); int k = (int)w->cont[ci].data[1];
  if (k >= 0 && k < tv->cap && tv->it[k].used) { u64 P = cc_P(c); u64 it = tv->nmbuf + 3 * P; u32 mask = rd32(c, it); u64 st = it + 2 * P, q = (st + 8 + P - 1) & ~(P - 1); u64 txt = rdp(c, q); int uni = tv_parent_unicode(i); if ((mask & 1) && txt && txt != (u64)(u32)-1) text_in(c, txt, uni, tv->it[k].text, sizeof tv->it[k].text); if (mask & 2) tv->it[k].image = (int)(s32)rd32(c, q + P + 4); if (mask & 0x20) tv->it[k].selimage = (int)(s32)rd32(c, q + P + 8); if (mask & 0x40) tv->it[k].children = (int)(s32)rd32(c, q + P + 12); tv->it[k].fetched = 1; if (rd32(c, it) & 0x8000 /* TVIF_DI_SETITEM */) tv->it[k].cb_text = 0; }
  if (tv_prefetch(c, i, 0)) return; u64 hdc = ctl_paint_begin(c, i); if (hdc) { tv_paint_core(c, i, hdc); ctl_paint_end(c, i, hdc); } w32_cont_finish(c, 0); }
/* --- item I/O ------------------------------------------------------------------------------------------------------- */
/* TVITEM(EX): mask@0 hItem@P state@2P stateMask@2P+4 pszText@align cchTextMax iImage iSelectedImage cChildren lParam [iIntegral …] */
static void tv_item_io(Cpu *c, int i, TreeView *tv, int k, u64 it, int set, int wide) { u64 P = cc_P(c); u32 mask = rd32(c, it); TvItem *t = &tv->it[k]; u64 st = it + 2 * P; u64 q = (st + 8 + P - 1) & ~(P - 1); u64 ptxt = q, pcch = q + P, pimg = q + P + 4, psel = q + P + 8, pch = q + P + 12; u64 plp = (q + P + 16 + P - 1) & ~(P - 1);
  if (set) { if (mask & 1) { u64 tp = rdp(c, ptxt); if (tp == (u64)(u32)-1 || tp == (u64)-1) { t->cb_text = 1; t->fetched = 0; } else { t->cb_text = 0; text_in(c, tp, wide, t->text, sizeof t->text); } } if (mask & 2) t->image = (int)(s32)rd32(c, pimg); if (mask & 0x20) t->selimage = (int)(s32)rd32(c, psel); if (mask & 0x40) t->children = (int)(s32)rd32(c, pch); if (mask & 4) t->lparam = rdp(c, plp);
    if (mask & 8) { u32 sm = rd32(c, st + 4), sv = rd32(c, st); if (sm & 0x20) t->expanded = (sv & 0x20) != 0; if (sm & 2) { if (sv & 2) tv->sel = k; else if (tv->sel == k) tv->sel = -1; } t->state = (t->state & ~(sm & ~0x22u)) | (sv & sm & ~0x22u); } wnd_invalidate(i, 1); return; }
  if (mask & 1) { u64 tp = rdp(c, ptxt); u32 cch = rd32(c, pcch); if (tp && cch) text_out_cap(c, tp, t->text, cch, wide); } if (mask & 2) wr32(c, pimg, (u32)t->image); if (mask & 0x20) wr32(c, psel, (u32)t->selimage); if (mask & 0x40) wr32(c, pch, (u32)(t->first >= 0 ? 1 : t->children)); if (mask & 4) wrp(c, plp, t->lparam);
  if (mask & 8) { u32 sm = rd32(c, st + 4); wr32(c, st, (t->state | (t->expanded ? 0x20 : 0) | (k == tv->sel ? 2 : 0)) & sm); } if (mask & 0x80) wr32(c, plp + P, 1); }
static int tv_alloc(TreeView *tv) { if (!tv->it) { tv->cap = TV_MAX; tv->it = emu_alloc(sizeof(TvItem) * TV_MAX); if (!tv->it) { tv->cap = 0; return -1; } e_memset(tv->it, 0, sizeof(TvItem) * TV_MAX); } for (int k = 0; k < tv->cap; k++) if (!tv->it[k].used) { e_memset(&tv->it[k], 0, sizeof tv->it[k]); tv->it[k].used = 1; tv->it[k].parent = tv->it[k].first = tv->it[k].next = -1; tv->it[k].image = tv->it[k].selimage = 0; tv->count++; return k; } return -1; }
static void tv_unlink(TreeView *tv, int k) { int p = tv->it[k].parent; int *head = p < 0 ? &tv->hot : &tv->it[p].first; if (*head == k) *head = tv->it[k].next; else { for (int q = *head; q >= 0; q = tv->it[q].next) if (tv->it[q].next == k) { tv->it[q].next = tv->it[k].next; break; } } tv->it[k].next = -1; }
